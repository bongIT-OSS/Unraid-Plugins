</style>
<script>
// Hochladen über Unraids eigenen Weg (wie das Banner in den Anzeige-Einstellungen):
// erst prüfen lassen (load), dann unter festem Namen ablegen (save).
function bgBanner(input, modus) {
  const datei = input.files[0];
  if (!datei) return;
  const name = 'bongit-banner-' + modus + '.png';
  const meldung = document.getElementById('bg-meldung-' + modus);
  const fehler = (schritt) => (x) => {
    meldung.textContent = 'Hochladen fehlgeschlagen (' + schritt + ': ' + (x.status || '') + ' ' + (x.responseText || x.statusText || '').slice(0, 80) + ')';
    meldung.style.color = 'var(--ag-warn)';
    input.value = '';
  };
  meldung.textContent = 'wird hochgeladen …';
  meldung.style.color = '';
  const leser = new FileReader();
  leser.onload = (e) => {
    $.post('/webGui/include/FileUpload.php', {cmd: 'load', filename: name, filedata: e.target.result})
      .done(() => {
        $.post('/webGui/include/FileUpload.php', {cmd: 'save', path: '/boot/config/plugins/dynamix', filename: name, output: name})
          .done(() => { meldung.textContent = 'gespeichert'; location.reload(); })
          .fail(fehler('speichern'));
      })
      .fail(fehler('prüfen'));
  };
  leser.onerror = () => fehler('lesen')({statusText: 'Datei nicht lesbar'});
  leser.readAsDataURL(datei);
}
function bgBannerWeg(modus) {
  $.post('/webGui/include/FileUpload.php', {cmd: 'delete', path: '/boot/config/plugins/dynamix', filename: 'bongit-banner-' + modus + '.png'},
    () => location.reload());
  return false;
}
</script>

<div class="ag-fx">
