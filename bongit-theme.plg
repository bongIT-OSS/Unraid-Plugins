<div class="title nocontrol"><span class="left"><i class="title fa fa-tachometer"></i> Benchmark für deinen Rechner</span></div>
<div class="ag">
  <p>Optional. Der Tempo-Ring nutzt Werte, die auf einem Rechner gemessen wurden. Um die echten Kosten auf deinem Rechner zu sehen, führe diesen kurzen Test in deinem Browser aus. Er testet die vier Voreinstellungen auf dem Dashboard und vergibt je Voreinstellung eine Punktzahl: 1 Punkt für jedes Bild pro Sekunde, minus 1 Punkt für jeden Ruckler. Empfohlen wird die reichste Voreinstellung mit mindestens 50 Punkten, also etwa flüssige 60 Bilder pro Sekunde mit nur wenigen Rucklern. Es ändert sich nichts, bis du es selbst übernimmst.</p>
  <p>Der Test ist Code, den du selbst ausführst, er ist nicht Teil des Plugins; bongIT Theme bleibt damit reines CSS. Er läuft nur in deinem Browser, ändert nichts dauerhaft (Seite neu laden macht es rückgängig) und sendet nichts irgendwohin. Getestet mit Safari; Chrome und Edge nutzen denselben Code.</p>
  <details class="ag-bench">
    <summary>Schritte und Code anzeigen</summary>
    <ol>
      <li>Öffne das Dashboard und warte ein paar Sekunden.</li>
      <li>Öffne die Browser-Konsole.<br>
        <b>Safari:</b> Einstellungen → Erweitert → „Funktionen für Webentwickler anzeigen“ einmal aktivieren, dann Entwicklung → JavaScript-Konsole einblenden (Wahltaste-Befehl-C).<br>
        <b>Chrome / Edge:</b> Wahltaste-Befehl-J am Mac, Strg+Umschalt+J unter Windows.</li>
      <li>Klicke in das Feld unten, wähle alles aus (Befehl-A bzw. Strg+A), kopiere es, füge es in die Konsole ein und drücke Return. Chrome und Edge verlangen beim ersten Mal, dass du „allow pasting“ eintippst.</li>
      <li>Ein Hinweis in der Mitte des Bildschirms bittet dich, die Konsole zu schließen, und zählt von 5 herunter, damit der Test das ganze Fenster misst. Schließe sie mit Wahltaste-Befehl-I am Mac bzw. F12 unter Windows oder mit dem Schließen-Knopf der Konsole. Der Test dauert danach etwa 1,5 Minuten. Bitte Maus und Tastatur während des Tests nicht berühren, damit dein eigenes Scrollen die Ergebnisse nicht verfälscht.</li>
      <li>Wenn er fertig ist, zeigt eine Ergebniskarte in der Mitte des Bildschirms die Punktzahl jeder Voreinstellung, die empfohlene in Grün.</li>
    </ol>
    <textarea class="ag-code" readonly rows="14" spellcheck="false">// bongIT Theme Benchmark: testet die vier Effekt-Voreinstellungen auf dieser Seite und empfiehlt eine.
// Im Browser-Konsole auf dem Dashboard einfügen. Er dauert etwa 1,5 Minuten. Bitte Maus und Tastatur
// während des Tests nicht berühren: Eigenes Bewegen oder Scrollen würde die Ergebnisse verfälschen.
// Er läuft nur in deinem Browser, ändert nichts dauerhaft und sendet nichts irgendwohin.
(async () =&gt; {
  // Eine durchsichtige Abdeckung über der Seite für die Dauer des Tests, damit eine ruhende Maus keine Kachel
  // überfahren und deren Schimmer starten kann (das würde zwei der Voreinstellungen verfälschen).
  const shield = Object.assign(document.createElement("div"), { style:
    "position:fixed;inset:0;z-index:2147483646;cursor:wait" });
  const banner = Object.assign(document.createElement("div"), { style:
    "position:fixed;bottom:40px;left:20px;z-index:2147483647;padding:8px 16px;border-radius:99px;" +
    "background:#000000;color:#ffffff;font:700 15px system-ui;box-shadow:0 0 0 2px #29b05b;cursor:default" });
  document.documentElement.append(shield, banner);
  let card;   // der Hinweis „Konsole schließen“, wird bei vorzeitigem Abbruch wieder entfernt
  try {
    const wait = ms =&gt; new Promise(r =&gt; setTimeout(r, ms));
    // Eine Seite kann die Browser-Konsole nicht selbst schließen, also bitten wir darum, mit den Tasten
    // dieses Browsers, und zählen herunter. Eine offene Konsole nimmt einen Teil des Fensters und würde die Punkte senken.
    // Wahltaste-Befehl-I (Mac, Safari und Chrome) und F12 (Windows) schließen das Entwicklerfenster wieder
    const keys = /Mac/.test(navigator.platform) ? "Wahltaste-Befehl-I" : "F12";
    card = Object.assign(document.createElement("div"), { style:
      "position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);z-index:2147483647;width:min(640px,90vw);padding:44px 48px;border-radius:28px;" +
      "background:rgba(24, 17, 4, 0.97);color:#ffce7a;font:700 26px/1.4 system-ui;text-align:center;" +
      "box-shadow:0 0 0 3px #f59f0b,0 0 60px rgba(245, 159, 11, 0.45),0 30px 80px rgba(0, 0, 0, 0.7)" });   // bernsteinfarben, damit er nicht übersehen wird
    document.documentElement.append(card);
    for (let n = 5; n &gt; 0; n--) {
      card.innerHTML = `⚠️ Bitte jetzt die Konsole schließen&lt;br&gt;&lt;span style="font-size:22px;color:#fff"&gt;${keys}, oder ihren ×-Knopf&lt;/span&gt;` +
        `&lt;span style="display:block;margin-top:18px;font-size:20px;font-weight:600;color:#fde7b6"&gt;Der Test startet in&lt;/span&gt;` +
        `&lt;span style="display:block;font-size:96px;line-height:1.1;color:#f59e0b"&gt;${n}&lt;/span&gt;`;
      await wait(1000);
    }
    card.remove();
    const frames = (ms, scroll) =&gt; new Promise(done =&gt; {
      const gaps = []; const t0 = performance.now(); let last = t0;
      const max = Math.max(0, document.documentElement.scrollHeight - innerHeight);
      const tick = t =&gt; { gaps.push(t - last); last = t; const p = (t - t0) / ms;
        if (scroll) scrollTo(0, max * (p &lt; .5 ? p * 2 : 2 - p * 2)); p &lt; 1 ? requestAnimationFrame(tick) : done(gaps); };
      requestAnimationFrame(tick);
    });
    const fps = a =&gt; a.length / (a.reduce((x, y) =&gt; x + y, 0) / 1000);
    // Die Effekt-Regeln des Themes, gefunden anhand der Namen in ihren Bedingungen
    const rules = [];
    for (const sh of document.styleSheets) { let rs; try { rs = sh.cssRules; } catch (e) { continue; }
      for (const r of rs) if (r instanceof CSSMediaRule &amp;&amp; /bongit-(motion|glass|glow)-|prefers-reduced-(motion|transparency)/.test(r.media.mediaText))
        rules.push({ r, orig: r.media.mediaText }); }
    if (!rules.some(x =&gt; x.orig.includes("bongit-motion-everywhere"))) throw new Error("bongIT Theme ist auf dieser Seite nicht aktiv (oder es ist eine ältere Version)");
    // Die Regeln auf eine Mischung der Stufen umstellen, nur in diesem Tab
    const set = (m, g, w) =&gt; { for (const { r, orig } of rules) { const has = n =&gt; orig.includes(n);
      const on = has("prefers-reduced-motion") ? m === "still" : has("prefers-reduced-transparency") ? g === "off"
        : has("bongit-motion-everywhere") ? m === "everywhere" : has("bongit-motion-titles") ? m === "titles"
        : has("bongit-theme-panels") ? g === "panels" : has("bongit-theme-menus") ? g === "menus"
        : (has("bongit-glow-static") &amp;&amp; w === "static") || (has("bongit-glow-off") &amp;&amp; w === "off");
      r.media.mediaText = on ? "all" : "not all"; } };
    const presets = { Vivid: ["everywhere", "all", "all"], Balanced: ["hover", "all", "all"],
                      Light: ["hover", "menus", "static"], Minimal: ["still", "off", "off"] };
    const de = { Vivid: "Kräftig", Balanced: "Ausgewogen", Light: "Leicht", Minimal: "Minimal" };
    const res = {};
    for (const round of [1, 2]) {
      const order = Object.keys(presets);   // gemischt (Fisher-Yates), damit nie eine Voreinstellung immer zuerst läuft
      for (let i = order.length - 1; i &gt; 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [order[i], order[j]] = [order[j], order[i]]; }
      for (const name of order) {
        banner.textContent = `Test läuft: ${de[name]} (Durchgang ${round} von 2) …  Bitte Maus und Tastatur nicht berühren.`;
        set(...presets[name]); await wait(1000);
        const idle = await frames(3000, false), scroll = await frames(4000, true);
        (res[name] ||= []).push({ idle: fps(idle), scroll: fps(scroll), slow: [...idle, ...scroll].filter(x =&gt; x &gt; 50).length });
        scrollTo(0, 0); await wait(400);
      }
    }
    for (const x of rules) x.r.media.mediaText = x.orig;   // zurück in den Zustand beim Laden der Seite
    shield.remove();
    // Punktzahl: 1 Punkt je Bild pro Sekunde im Leerlauf, ohne Obergrenze, damit 144-Hz- und schnellere
    // Bildschirme echte Unterschiede zeigen (der selbst scrollende Teil endet bei etwa 50 fps bei jeder
    // Voreinstellung, er zählt nur für die Ruckler), minus 1 Punkt für jeden Ruckler (ein Bild,
    // das länger als 50 ms brauchte, im Leerlauf oder beim Scrollen). Empfohlen wird die reichste
    // Voreinstellung mit mindestens 50 Punkten: etwa flüssige 60 Bilder pro Sekunde mit wenigen Rucklern.
    const avg = (r, k) =&gt; r.reduce((s, x) =&gt; s + x[k], 0) / r.length;
    const stats = {}, table = {};
    for (const name of Object.keys(presets)) { const r = res[name];
      const idle = avg(r, "idle"), stutters = Math.round(avg(r, "slow"));
      stats[name] = { score: Math.round(idle - stutters) };
      table[name] = { score: stats[name].score, "idle fps": +idle.toFixed(1), "scroll fps": +avg(r, "scroll").toFixed(1), stutters };
    }
    console.table(table);
    const pick = ["Vivid", "Balanced", "Light"].find(n =&gt; stats[n].score &gt;= 50) || "Minimal";
    const note = stats.Minimal.score &lt; 50 ? "  Auch Minimal erreicht hier unter 50 Punkte, dieser Rechner könnte das Theme daher schwer finden." : "";
    // Ergebniskarte in der Mitte des Bildschirms: in Petrol, mit der Empfehlung in Grün
    banner.remove();
    const top = Math.max(1, ...Object.values(table).map(t =&gt; t.score));   // Balken skalieren auf die beste Punktzahl dieses Laufs
    const row = n =&gt; { const t = table[n], best = n === pick, w = Math.max(0, t.score / top * 100);
      return `&lt;tr style="${best ? "color:#52d682;font-weight:800" : ""}"&gt;` +
        `&lt;td style="background:transparent;border:0;padding:8px 14px 8px 0;text-align:left"&gt;${best ? "✓ " : ""}${de[n]}&lt;/td&gt;` +
        `&lt;td style="background:transparent;border:0;padding:8px 14px;min-width:170px"&gt;&lt;div style="height:10px;border-radius:99px;background:rgba(124,92,255,.25)"&gt;` +
        `&lt;div style="height:100%;width:${w}%;border-radius:99px;background:${best ? "#29b05b" : "linear-gradient(90deg,#46a6b9,#4792a5)"}"&gt;&lt;/div&gt;&lt;/div&gt;&lt;/td&gt;` +
        `&lt;td style="background:transparent;border:0;padding:8px 14px;text-align:right;font-size:22px"&gt;${t.score}&lt;/td&gt;` +
        `&lt;td style="background:transparent;border:0;padding:8px 14px;text-align:right;color:${best ? "#52d682" : "#bbcbcf"}"&gt;${Math.round(t["idle fps"])} fps&lt;/td&gt;` +
        `&lt;td style="background:transparent;border:0;padding:8px 0 8px 14px;text-align:right;color:${best ? "#52d682" : "#bbcbcf"}"&gt;${t.stutters} Ruckler&lt;/td&gt;&lt;/tr&gt;`; };
    const results = Object.assign(document.createElement("div"), { style:
      "position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);z-index:2147483647;width:min(720px,92vw);padding:36px 40px;border-radius:28px;" +
      "background:rgba(22, 53, 61, 0.97);color:#f2ebdd;font:600 17px/1.4 system-ui;text-align:center;" +
      "box-shadow:0 0 0 3px #4792a5,0 0 60px rgba(71, 146, 165, 0.45),0 30px 80px rgba(0, 0, 0, 0.7)" });
    results.innerHTML =
      `&lt;div style="font-size:15px;letter-spacing:.12em;text-transform:uppercase;color:#cdb9ff"&gt;bongIT Theme Benchmark&lt;/div&gt;` +
      `&lt;div style="margin:10px 0 4px;font-size:30px;font-weight:800;color:#4ade9c"&gt;Empfohlen: ${de[pick]}&lt;/div&gt;` +
      `&lt;div style="font-size:15px;font-weight:500;color:#b4bad6"&gt;Einstellen unter Einstellungen → bongIT Theme → Effekte.&lt;/div&gt;` +
      (note ? `&lt;div style="margin-top:10px;font-size:15px;font-weight:500;color:#ffd27a"&gt;${note.trim()}&lt;/div&gt;` : "") +
      `&lt;table style="margin:22px auto 10px;border-collapse:separate;border-spacing:0;border-radius:18px;overflow:hidden;` +
      `padding:8px 20px;background:rgba(8,5,26,.6);box-shadow:inset 0 0 0 1px rgba(200,190,255,.14);font-size:17px"&gt;${["Vivid", "Balanced", "Light", "Minimal"].map(row).join("")}&lt;/table&gt;` +
      `&lt;div style="font-size:13px;font-weight:500;color:#8b95b5"&gt;Punkte = Bilder pro Sekunde minus 1 pro Ruckler. 50 oder mehr wird empfohlen.&lt;/div&gt;` +
      // Zwei Knöpfe: einer führt direkt zu den bongIT-Theme-Einstellungen, um die Auswahl zu übernehmen,
      // der ruhigere schließt nur die Karte und bleibt auf dem Dashboard
      `&lt;div style="margin-top:22px;display:flex;gap:12px;justify-content:center"&gt;` +
      `&lt;button data-go style="padding:10px 28px;border:0;border-radius:99px;font:700 16px system-ui;color:#fff;cursor:pointer;` +
      `background:linear-gradient(180deg,#9a82ff,#7354f0 55%,#5534c9)"&gt;Einstellungen öffnen&lt;/button&gt;` +
      `&lt;button data-close style="padding:10px 22px;border:0;border-radius:99px;font:600 16px system-ui;color:#cdb9ff;cursor:pointer;` +
      `background:transparent;box-shadow:inset 0 0 0 1px rgba(205,185,255,.35)"&gt;Schließen&lt;/button&gt;&lt;/div&gt;`;
    results.querySelector("[data-go]").onclick = () =&gt; { location.href = "/Settings/BongitTheme"; };
    results.querySelector("[data-close]").onclick = () =&gt; results.remove();
    document.documentElement.append(results);
    console.log(`%cEmpfohlene Voreinstellung für diesen Rechner: ${de[pick]}`, "font-weight:bold;font-size:15px;color:#10c98f");
    console.log(Object.entries(table).map(([n, t]) =&gt; `${de[n]}: ${t.score} Punkte (${Math.round(t["idle fps"])} fps, ${t.stutters} Ruckler)`).join("\n"));
  } catch (err) { shield.remove(); card?.remove(); banner.textContent = "Benchmark abgebrochen: " + err.message; console.error(err); }
})();</textarea>
  </details>
</div>

<div class="title nocontrol"><span class="left"><i class="title fa fa-life-ring"></i> Wenn etwas nicht funktioniert</span></div>
<div class="ag">
  <p><b>Änderungen werden nicht angezeigt?</b>  Seite neu laden; sieht sie danach noch gleich aus, mit gedrückter Umschalttaste neu laden.</p>
  <p><b>Weboberfläche lädt nicht?</b>  Auf dem Flash-Laufwerk im Ordner <code>config/plugins/bongit-theme/</code> eine leere Datei namens <code>DISABLED</code> anlegen und neu starten: Das Theme wird dann nicht geladen.</p>
  <p style="font-size:1.15rem;color:var(--ag-dim);margin-top:2.4rem">bongIT Theme · bongIT – Markus Bong · Aufbau auf Grundlage von „Aether Glass“ von aegisnir (MIT-Lizenz)</p>
</div>
]]></INLINE>
</FILE>

<FILE Name="&cfg;/BongitThemeHeader.page">
<SHA256>4f51410942b4a42f9c4b83137654d07cd13637a277025c03497cf623307c2f91</SHA256>
<INLINE><![CDATA[
Menu="Buttons:298"
Link="nav-user"
---
<?php
/* bongIT Theme: das Logo links im Kopf führt auf die Startseite der Weboberfläche
 * (Settings -> Management Access -> Start Page) statt in einem neuen Tab auf unraid.net.
 *
 * Seiten mit Menu="Buttons" bindet Unraid in jede Seite der Weboberfläche ein; mit Link
 * gesetzt erscheint dabei kein eigener Knopf.  Das Skript läuft nur, solange das Theme
 * tatsächlich an einem Stylesheet hängt: nach "Turn off", --remove oder ohne Freigabe
 * bleibt auch der Link wie von Unraid vorgesehen.
 */
$bg_aktiv = false;
foreach (['black', 'white'] as $bg_t) {
  exec('grep -qsF '.escapeshellarg('BONGIT-THEME-START').' '.escapeshellarg("/usr/local/emhttp/plugins/dynamix/styles/themes/$bg_t.css"), $bg_o, $bg_rc);
  if ($bg_rc === 0) { $bg_aktiv = true; break; }
}
// Kopfzeile: eigene Banner statt Platinen-Muster (Einstellung auf der Seite bongIT Theme,
// gespeichert in kopf.cfg; Bilder bongit-banner-hell.png / -dunkel.png).  Für jedes Banner die
// Randfarbe auslesen: sie füllt links und rechts, wenn das Fenster breiter ist als das Bild.
$bg_kopf = @parse_ini_file('/boot/config/plugins/bongit-theme/kopf.cfg')['kopf'] ?? 'muster';
$bg_banner = [];
if (in_array($bg_kopf, ['banner', 'banner-hell', 'banner-dunkel'])) {
  foreach (['hell', 'dunkel'] as $bg_m) {
    $bg_f = "/boot/config/plugins/dynamix/bongit-banner-$bg_m.png";
    if (!file_exists($bg_f)) continue;
    $bg_rand = '';
    $bg_hoehe = 0;
    if (function_exists('imagecreatefrompng') && ($bg_i = @imagecreatefrompng($bg_f))) {
      $bg_c = imagecolorsforindex($bg_i, imagecolorat($bg_i, 1, intdiv(imagesy($bg_i), 2)));
      $bg_rand = sprintf('#%02x%02x%02x', $bg_c['red'], $bg_c['green'], $bg_c['blue']);
      // Kopfhöhe: so hoch, wie das Bild bei 1920 px Breite ist (3840 x 280 -> 140 px)
      $bg_hoehe = (int)round(imagesy($bg_i) * 1920 / max(1, imagesx($bg_i)));
      imagedestroy($bg_i);
    }
    $bg_banner[$bg_m] = ["$bg_f?v=".filemtime($bg_f), $bg_rand, $bg_hoehe];
  }
  // Fehlt eine Fassung, gilt die andere für beide
  if (count($bg_banner) === 1) $bg_banner += [array_key_first($bg_banner) === 'hell' ? 'dunkel' : 'hell' => reset($bg_banner)];
}
if ($bg_aktiv):
?>
<?php if ($bg_banner): ?>
<style>:root {
<?php foreach ($bg_banner as $bg_m => [$bg_url, $bg_rand, $bg_hoehe]): ?>
  --bongit-banner-<?=$bg_m?>: url("<?=htmlspecialchars($bg_url)?>");
  <?php if ($bg_rand): ?>--bongit-banner-<?=$bg_m?>-rand: <?=$bg_rand?>;<?php endif; ?>
  <?php if ($bg_hoehe >= 60 && $bg_hoehe <= 240): ?>--bongit-banner-<?=$bg_m?>-hoehe: <?=$bg_hoehe?>px;<?php endif; ?>

<?php endforeach; ?>
}</style>
<script>document.documentElement.classList.add('bongit-banner');</script>
<?php endif; ?>
<script>
(() => {
  // Kopf-Komponente (Unraid 7.4) und ihr Platzhalter beim Laden
  const LOGOS = '#header a.uh-logo, #header .uh-logo-block a, .unraid-header-boot-logo a';
  const ICON = 'data:image/png;base64,';
  const TOUCH = 'data:image/png;base64,';
  const fuehrtZuUnraid = (a) => {
    try {
      const u = new URL(a.href);
      return /^(www\.)?unraid\.net$/.test(u.hostname) && u.pathname === '/' && !u.search && !u.hash;
    } catch (_) {
      return false;
    }
  };
  const umbiegen = () => {
    for (const l of document.querySelectorAll('link[rel~="icon"]')) {
      if (l.href !== ICON) { l.type = 'image/png'; l.href = ICON; }
    }
    for (const l of document.querySelectorAll('link[rel="apple-touch-icon"]')) {
      if (l.href !== TOUCH) l.href = TOUCH;
    }
    for (const a of document.querySelectorAll(LOGOS)) {
      if (!fuehrtZuUnraid(a)) continue;
      a.href = '/';
      a.removeAttribute('target');
      a.removeAttribute('rel');
      a.title = 'Startseite';
      a.setAttribute('aria-label', 'Startseite');
    }
  };
  umbiegen();
  // Unraid 7.4 tauscht den Platzhalter gegen die Komponente und zeichnet den Kopf neu:
  // höchstens einmal pro Bild nachziehen.
  let geplant = false;
  new MutationObserver(() => {
    if (geplant) return;
    geplant = true;
    requestAnimationFrame(() => { geplant = false; umbiegen(); });
  }).observe(document.documentElement, { childList: true, subtree: true, attributes: true, attributeFilter: ['href'] });

  // Docker/VMs: Nach einem Update (Dismiss) lädt Unraid die Liste per loadlist() neu.  Bei
  // vielen Containern rechnet der Browser danach rund eine Sekunde; Unraids Spinner kommt
  // dabei nicht zum Zug.  Die Liste wird sofort abgeblendet, bis die neue eingesetzt ist.
  window.addEventListener('DOMContentLoaded', () => {
    const liste = document.querySelector('#docker_list, #kvm_list');
    if (!liste || typeof window.loadlist !== 'function') return;
    const original = window.loadlist;
    window.loadlist = function () {
      liste.classList.add('bongit-laedt');
      return original.apply(this, arguments);
    };
    new MutationObserver(() => liste.classList.remove('bongit-laedt'))
      .observe(liste, { childList: true });
  });
})();
</script>
<?php endif; ?>
]]></INLINE>
</FILE>

<FILE Name="&cfg;/BongitThemeModus.page">
<SHA256>49b6ee75bfc430f6d3111e054b13e31f609a1153ce9ba11ccd079d5687e16451</SHA256>
<INLINE><![CDATA[
Menu="Buttons:2"
Title="Hell / Dunkel"
Icon="fa-adjust"
---
<?php
/* bongIT Theme: hell oder dunkel – pro Browser.
 *
 * Unraid lädt je nach Display-Einstellung des Servers themes/black.css (bongIT dunkel) oder
 * themes/white.css (bongIT hell).  Dieses Skript steht im <head> hinter dem Theme-Link und
 * läuft, bevor die Seite gezeichnet wird: hat der Browser eine eigene Wahl gespeichert
 * (localStorage "bongit-modus" = hell | dunkel), tauscht es den Link und die Theme-Klasse am
 * <html>.  Die Server-Einstellung bleibt unberührt; ohne eigene Wahl gilt sie.
 *
 * Der Knopf mit Sonne/Mond in der Symbolleiste schaltet sofort um, ohne Neuladen.
 * Nur aktiv, solange das Theme an den Stylesheets hängt (freigegeben, nicht ausgeschaltet).
 */
$bg_aktiv = false;
foreach (['black', 'white'] as $bg_t) {
  exec('grep -qsF '.escapeshellarg('BONGIT-THEME-START').' '.escapeshellarg("/usr/local/emhttp/plugins/dynamix/styles/themes/$bg_t.css"), $bg_o, $bg_rc);
  if ($bg_rc === 0) { $bg_aktiv = true; break; }
}
// Nur bei Farbschema Schwarz oder Weiß (Menü oben).  Azur und Grau haben eine Seitenleiste
// und einen anderen Seitenaufbau: dort würde der Tausch das Layout zerstören.
if (!in_array($display['theme'] ?? '', ['black', 'white'])) $bg_aktiv = false;
$bg_server = ($display['theme'] ?? 'black') === 'white' ? 'hell' : 'dunkel';
// Adressen beider Stylesheets mit eigenem Änderungsstand (?v=), wie Unraids autov():
// sonst trüge der getauschte Link den Stand der anderen Datei, und der Browser nähme nach
// einem Update eine alte Kopie aus dem Cache.
$bg_url = [];
foreach (['black', 'white'] as $bg_t) {
  $bg_url[$bg_t] = "/webGui/styles/themes/$bg_t.css?v=".@filemtime("/usr/local/emhttp/plugins/dynamix/styles/themes/$bg_t.css");
}
?>
<script>
(function () {
  var AKTIV = <?=$bg_aktiv ? 'true' : 'false'?>;
  var SERVER = '<?=$bg_server?>';
  var DATEI = { hell: 'white', dunkel: 'black' };
  var URL_ = { hell: '<?=$bg_url['white']?>', dunkel: '<?=$bg_url['black']?>' };

  function gespeichert() {
    try { return localStorage.getItem('bongit-modus'); } catch (e) { return null; }
  }
  function aktuell() {
    var m = gespeichert();
    return m === 'hell' || m === 'dunkel' ? m : SERVER;
  }
  // Theme-Stylesheet und Klasse am <html> auf die gewünschte Fassung stellen
  function anwenden(modus) {
    var link = document.querySelector('link[href*="/webGui/styles/themes/"]');
    if (link) {
      if (link.getAttribute('href') !== URL_[modus]) link.setAttribute('href', URL_[modus]);
    }
    var html = document.documentElement;
    html.classList.remove('Theme--black', 'Theme--white');
    html.classList.add('Theme--' + DATEI[modus]);
    html.classList.toggle('bongit-hell', modus === 'hell');
  }
  // Symbol und Beschriftung zeigen, wohin ein Klick schaltet
  function knopf() {
    var a = document.querySelector('.nav-item.BongitThemeModus a');
    if (!a) return;
    var ziel = aktuell() === 'hell' ? 'dunkel' : 'hell';
    var text = ziel === 'hell' ? 'Hell' : 'Dunkel';
    a.title = text;
    var span = a.querySelector('span');
    if (span) span.textContent = text;
    var b = a.querySelector('b');
    if (b) {
      b.classList.remove('fa-adjust', 'fa-sun-o', 'fa-moon-o');
      b.classList.add(ziel === 'hell' ? 'fa-sun-o' : 'fa-moon-o');
    }
  }

  window.BongitThemeModus = function () {
    if (!AKTIV) return;
    var ziel = aktuell() === 'hell' ? 'dunkel' : 'hell';
    try {
      // Entspricht die Wahl der Server-Einstellung, nichts speichern: dann folgt der
      // Browser wieder dem Server, falls der umgestellt wird.
      if (ziel === SERVER) localStorage.removeItem('bongit-modus');
      else localStorage.setItem('bongit-modus', ziel);
    } catch (e) {}
    anwenden(ziel);
    knopf();
  };

  // Beim Seitenaufbau: das gewählte Stylesheet per document.write einsetzen, solange der
  // Parser noch im <head> steht.  So ist es "parser-inserted" und der Browser wartet mit dem
  // ersten Zeichnen darauf.  Ein nur umgebogener Link wird nicht abgewartet: gemessen wurde
  // die Seite 30 ms ohne Theme gezeichnet (Aufblitzen).
  if (AKTIV && aktuell() !== SERVER) {
    var alt = document.querySelector('link[href*="/webGui/styles/themes/"]');
    if (alt && document.readyState === 'loading') {
      var href = URL_[aktuell()];
      alt.parentNode.removeChild(alt);
      document.write('<link type="text/css" rel="stylesheet" href="' + href + '">');
      var html = document.documentElement;
      html.classList.remove('Theme--black', 'Theme--white');
      html.classList.add('Theme--' + DATEI[aktuell()]);
      html.classList.toggle('bongit-hell', aktuell() === 'hell');
    } else {
      anwenden(aktuell());
    }
  }
  // Unraids neuere Komponenten (Kopf, Benachrichtigungen, Menüs, Toasts; Klasse .unapi)
  // tragen die Klasse "dark" nach der Server-Einstellung.  Wählt der Browser die andere
  // Fassung, blieben sie im falschen Modus: hier nachziehen, auch bei allem, was Unraid
  // später einblendet (die Benachrichtigungen werden erst beim Öffnen gezeichnet).
  function komponenten() {
    var dunkel = aktuell() === 'dunkel';
    var teile = document.querySelectorAll('.unapi');
    for (var i = 0; i < teile.length; i++) {
      if (teile[i].classList.contains('dark') !== dunkel) teile[i].classList.toggle('dark', dunkel);
    }
  }
  if (AKTIV) {
    var geplant = false;
    new MutationObserver(function () {
      if (geplant) return;
      geplant = true;
      requestAnimationFrame(function () { geplant = false; komponenten(); });
    }).observe(document.documentElement, { childList: true, subtree: true, attributes: true, attributeFilter: ['class'] });
    var vorher = window.BongitThemeModus;
    window.BongitThemeModus = function () { vorher(); komponenten(); };
  }
  document.addEventListener('DOMContentLoaded', function () {
    var item = document.querySelector('.nav-item.BongitThemeModus');
    if (item && !AKTIV) item.style.display = 'none';
    knopf();
    if (AKTIV) komponenten();
  });
})();
</script>
]]></INLINE>
</FILE>

