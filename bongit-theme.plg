/* The other ring, slice by slice: where each source in it starts (one rule per percentage,
   per source colour, like the reads above), the colour of the last one present (for the
   ring's round end), and legend dots in the matching colours. */
body div.pie#sys0 {
    --_lastc: #ff0607;
    --_oa0: calc((var(--bongit-ring-s4) - var(--_s4)) * 3.6deg);
    --_ob0: calc((var(--bongit-ring-s5, var(--bongit-ring-s6, var(--bongit-ring-s7, var(--bongit-ring-s8, var(--bongit-ring-s9, var(--bongit-ring-s10, var(--bongit-ring-p, 0))))))) - var(--_s4)) * 3.6deg);
    --_oa1: calc((var(--bongit-ring-s5, var(--bongit-ring-p, 0)) - var(--_s4)) * 3.6deg);
    --_ob1: calc((var(--bongit-ring-s6, var(--bongit-ring-s7, var(--bongit-ring-s8, var(--bongit-ring-s9, var(--bongit-ring-s10, var(--bongit-ring-p, 0)))))) - var(--_s4)) * 3.6deg);
    --_oa2: calc((var(--bongit-ring-s6, var(--bongit-ring-p, 0)) - var(--_s4)) * 3.6deg);
    --_ob2: calc((var(--bongit-ring-s7, var(--bongit-ring-s8, var(--bongit-ring-s9, var(--bongit-ring-s10, var(--bongit-ring-p, 0))))) - var(--_s4)) * 3.6deg);
    --_oa3: calc((var(--bongit-ring-s7, var(--bongit-ring-p, 0)) - var(--_s4)) * 3.6deg);
    --_ob3: calc((var(--bongit-ring-s8, var(--bongit-ring-s9, var(--bongit-ring-s10, var(--bongit-ring-p, 0)))) - var(--_s4)) * 3.6deg);
    --_oa4: calc((var(--bongit-ring-s8, var(--bongit-ring-p, 0)) - var(--_s4)) * 3.6deg);
    --_ob4: calc((var(--bongit-ring-s9, var(--bongit-ring-s10, var(--bongit-ring-p, 0))) - var(--_s4)) * 3.6deg);
    --_oa5: calc((var(--bongit-ring-s9, var(--bongit-ring-p, 0)) - var(--_s4)) * 3.6deg);
    --_ob5: calc((var(--bongit-ring-s10, var(--bongit-ring-p, 0)) - var(--_s4)) * 3.6deg);
    --_oa6: calc((var(--bongit-ring-s10, var(--bongit-ring-p, 0)) - var(--_s4)) * 3.6deg);
    --_ob6: calc((var(--bongit-ring-p, 0) - var(--_s4)) * 3.6deg);
}
