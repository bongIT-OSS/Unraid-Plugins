<!-- Login-Seite und Protokollfenster einbinden -->
<FILE Run="/bin/bash">
<INLINE><![CDATA[
bash /usr/local/emhttp/plugins/bongit-theme/scripts/einbinden.sh >/dev/null
echo ""
echo "----------------------------------------------------------------"
echo " Ginkgo by bongIT 2026.11.25.1644 ist installiert."
if [ -f /boot/config/plugins/bongit-theme/DISABLED ]; then
  echo " Notschalter: /boot/config/plugins/bongit-theme/DISABLED liegt vor, das Theme bleibt aus."
else
  echo " Einstellungen: Einstellungen -> Ginkgo.  Seite neu laden."
fi
echo "----------------------------------------------------------------"
echo ""
exit 0
]]></INLINE>
</FILE>

<!-- Entfernen -->
<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
bash /usr/local/emhttp/plugins/bongit-theme/scripts/einbinden.sh aus >/dev/null 2>&1
rm -rf /usr/local/emhttp/plugins/bongit-theme /boot/config/plugins/bongit-theme
echo ""
echo " Ginkgo ist entfernt; die Weboberfläche ist im Originalzustand."
echo " Eigene Banner bleiben in /boot/config/plugins/dynamix/ (bongit-banner-*.png)."
echo ""
exit 0
]]></INLINE>
</FILE>
</PLUGIN>
