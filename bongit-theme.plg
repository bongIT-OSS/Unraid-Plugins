0.12%22/%3E%3Cline x1=%22525%22 y1=%2236%22 x2=%22525%22 y2=%2240%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22/%3E%3Cline x1=%22525%22 y1=%2260%22 x2=%22525%22 y2=%2264%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22/%3E%3Cline x1=%22535%22 y1=%2236%22 x2=%22535%22 y2=%2240%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22/%3E%3Cline x1=%22535%22 y1=%2260%22 x2=%22535%22 y2=%2264%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22/%3E%3Cline x1=%22545%22 y1=%2236%22 x2=%22545%22 y2=%2240%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22/%3E%3Cline x1=%22545%22 y1=%2260%22 x2=%22545%22 y2=%2264%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22/%3E%3Crect x=%22490%22 y=%2220%22 width=%2240%22 height=%2220%22 rx=%222%22 fill=%22none%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22 stroke-width=%221.2%22/%3E%3Cline x1=%22495%22 y1=%2216%22 x2=%22495%22 y2=%2220%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22/%3E%3Cline x1=%22495%22 y1=%2240%22 x2=%22495%22 y2=%2244%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22/%3E%3Cline x1=%22505%22 y1=%2216%22 x2=%22505%22 y2=%2220%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22/%3E%3Cline x1=%22505%22 y1=%2240%22 x2=%22505%22 y2=%2244%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22/%3E%3Cline x1=%22515%22 y1=%2216%22 x2=%22515%22 y2=%2220%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22/%3E%3Cline x1=%22515%22 y1=%2240%22 x2=%22515%22 y2=%2244%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22/%3E%3Cline x1=%22525%22 y1=%2216%22 x2=%22525%22 y2=%2220%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22/%3E%3Cline x1=%22525%22 y1=%2240%22 x2=%22525%22 y2=%2244%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22/%3E%3Crect x=%22280%22 y=%2250%22 width=%2250%22 height=%2230%22 rx=%222%22 fill=%22none%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22 stroke-width=%221.2%22/%3E%3Cline x1=%22285%22 y1=%2246%22 x2=%22285%22 y2=%2250%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22/%3E%3Cline x1=%22285%22 y1=%2280%22 x2=%22285%22 y2=%2284%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22/%3E%3Cline x1=%22295%22 y1=%2246%22 x2=%22295%22 y2=%2250%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22/%3E%3Cline x1=%22295%22 y1=%2280%22 x2=%22295%22 y2=%2284%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22/%3E%3Cline x1=%22305%22 y1=%2246%22 x2=%22305%22 y2=%2250%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22/%3E%3Cline x1=%22305%22 y1=%2280%22 x2=%22305%22 y2=%2284%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22/%3E%3Cline x1=%22315%22 y1=%2246%22 x2=%22315%22 y2=%2250%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22/%3E%3Cline x1=%22315%22 y1=%2280%22 x2=%22315%22 y2=%2284%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22/%3E%3Cline x1=%22325%22 y1=%2246%22 x2=%22325%22 y2=%2250%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22/%3E%3Cline x1=%22325%22 y1=%2280%22 x2=%22325%22 y2=%2284%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22/%3E%3Ccircle cx=%22397%22 cy=%2230%22 r=%222.4%22 fill=%22%23ff0001%22 fill-opacity=%220.55%22/%3E%3C/svg%3E");
}

/* ===== bongIT: Kopfzeile =====
 * Hintergrund: Platinen-Muster im bongIT-Stil (build.py zeichnet es, steckt als Bild in
 * dieser Datei), unten weich in die Seite übergehend.  Dunkel Petrol mit hellen Bahnen,
 * hell Papier mit Petrol-Bahnen; Farben, Schrift und Logo kommen aus extra-dunkel.css /
 * extra-hell.css (--bongit-kopf-*).  Ein eigenes Kopfbanner aus Display Settings wird
 * ausgeblendet.  Statt des UNRAID-Schriftzugs steht links das bongIT-Logo.  Dass es auf die
 * Startseite statt auf unraid.net führt, erledigt BongitThemeHeader.page. */
body #header {
    --text-color: var(--bongit-kopf-text);
    --alt-text-color: var(--bongit-kopf-text-leise);
    --header-text-primary: var(--bongit-kopf-text);
    --header-text-secondary: var(--bongit-kopf-text-leise);
    --color-header-text-primary: var(--bongit-kopf-text);
    --color-header-text-secondary: var(--bongit-kopf-text-leise);
    color: var(--bongit-kopf-text);
}
html:not(.bongit-banner) body #header {
    /* gleiche Höhe wie mit Banner (90 px); Unraid 7.4 selbst nimmt mindestens 86 px, der
       Kopf sprang dadurch zwischen Servern mit Muster und mit Banner um 4 px */
    min-height: 90px !important;
    background-color: var(--bongit-kopf-grund) !important;
    background-image:
        linear-gradient(180deg, transparent 60%, var(--bongit-bg) 100%),
        var(--bongit-kopf-muster) !important;
    background-size: auto, 640px 100px !important;
    background-repeat: no-repeat, repeat !important;
    background-position: 0 0, 0 0 !important;
    border-bottom: 0;
}

/* Eigene Banner (Einstellung "Kopfzeile" auf der Seite bongIT Theme; die Klasse und die
   Variablen --bongit-banner-hell/-dunkel samt Randfarbe setzt BongitThemeHeader.page).  Die
   Fassung wählt extra-hell.css / extra-dunkel.css über --bongit-banner-bild.  Unverzerrt mittig,
   links und rechts die Randfarbe des Bildes. */
html.bongit-banner body #header {
    min-height: var(--bongit-banner-hoehe) !important;   /* Höhe aus dem Banner (Kopf-Seite) */
    background-color: var(--bongit-banner-grund) !important;
    background-image: var(--bongit-banner-bild) !important;
    background-size: auto 100% !important;
    background-position: center !important;
    background-repeat: no-repeat !important;
    border-bottom: 0;
}

/* Das Unraid-Bild wird aus seinem Kasten geschoben (object-position) und der Kasten zeigt
   das bongIT-Logo als Hintergrund (Kopf-Komponente von Unraid 7.4). */
#header a.uh-logo img,
#header .uh-logo-block a img {
    box-sizing: content-box;
    width: 118px !important;             /* Logo 235 x 88 px, halb so groß angezeigt */
    height: 44px !important;
    max-width: none !important;
    max-height: none !important;         /* Unraid 7.4 begrenzt auf 3rem = 30 px */
    object-position: -9999px 0;
    background: var(--bongit-kopf-logo) left center / contain no-repeat !important;
    -webkit-mask: none !important;
    mask: none !important;
}

/* Unraid 7.4: Platzhalter, bis die Kopf-Komponente geladen ist (Schriftzug als SVG im
   HTML).  Gleiche Größe wie oben, damit beim Austausch nichts springt.  Nur der Schriftzug
   im Link: die Versionsgrafik daneben ist auch ein SVG und machte, mit 44 px Höhe, den
   Platzhalter 106 px hoch (Kopf schrumpfte nach dem Laden um 16 px). */
.unraid-header-boot-logo > a {
    display: inline-block;
    background: var(--bongit-kopf-logo) left center / contain no-repeat !important;
}
.unraid-header-boot-logo > a svg {
    width: 118px !important;
    height: 44px !important;
    max-height: none !important;
    opacity: 0;
}

/* Avatar rechts: Petrol-Verlauf mit rotem Ende statt Rot-Orange */
#header figure.rounded-full.from-unraid-red.to-orange {
    background-image: linear-gradient(135deg, var(--bongit-cyan) 0, var(--bongit-violet) 55%, var(--bongit-pink) 100%);
}

/* ===== bongIT: Dashboard, Kachel "System" =====
 * Die Vorlage vergrößert die Ringe (RAM, Boot, Protokoll, Docker) fest auf 1.25x = 115 px.
 * In einer schmalen Kachel passen vier davon nicht nebeneinander: der letzte wurde
 * abgeschnitten, lange Beschriftungen ("Dateisystem protokollieren") drückten zusätzlich.
 * Jetzt teilen sich die Ringe die Breite gleichmäßig, Beschriftungen brechen um, und die
 * Ringe werden nur so groß, wie Platz da ist. */
body .tile-system-memory-charts {
    grid-template-columns: none !important;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
}
body .tile-system-memory-charts {
    margin-top: 0;                       /* Vorlage: -12px, klebte an den Kachelknöpfen */
    align-self: center;
    align-items: start;
}
/* Jede Spalte: Beschriftung über dem Ring, beide mittig.  Die Beschriftung ist immer zwei
   Zeilen hoch und unten bündig, so stehen alle Ringe auf einer Linie, auch wenn eine
   Beschriftung umbricht. */
body .tile-system-memory-charts > span {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
}
body .tile-system-memory-charts > span > a.info {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    min-height: 2.5em;
    line-height: 1.25;
    white-space: normal;
    overflow-wrap: normal;                /* nur an Wortgrenzen umbrechen */
}
body .tile-system-memory-charts div.pie {
    margin: 0.6rem auto 0;
}
@container (max-width: 500px) {
    body .tile-system-memory-charts div.pie,
    body .tile-system-memory-body:has(#dynamic > i:nth-of-type(6)) .tile-system-memory-charts div.pie {
        zoom: 0.95;
    }
}
@container (max-width: 400px) {
    body .tile-system-memory-charts div.pie,
    body .tile-system-memory-body:has(#dynamic > i:nth-of-type(6)) .tile-system-memory-charts div.pie {
        zoom: 0.8;
    }
}

/* Schmale Kachel (Handy, halbes Fenster): vier Ringe nebeneinander würden die Beschriftungen
   zerbrechen, also 2 x 2.  Gemessen wird der Kachelinhalt (Legende + Ringe). */
body .tile-system-memory-body {
    container: bongit-system / inline-size;
}
/* Ab 768 px stehen Legende und Ringe nebeneinander: die Ringe haben dann nur den Rest.
   Vier Ringe (74 px) passen nebeneinander, solange jede Spalte gut 80 px hat, also bis
   etwa 440 px Kachelinhalt (vorher schon unter 560 px 2 x 2, unnötig früh). */
@media (min-width: 768px) {
    @container bongit-system (max-width: 440px) {
        body .tile-system-memory-charts {
            grid-auto-flow: row;
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
            row-gap: var(--sp-3);
        }
    }
}
/* Darunter steht die Legende über den Ringen: vier passen nebeneinander bis etwa 340 px. */
@media (max-width: 767px) {
    body .tile-system-memory-charts {
        margin-top: var(--sp-3);
    }
    @container bongit-system (max-width: 340px) {
        body .tile-system-memory-charts {
            grid-auto-flow: row;
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
            row-gap: var(--sp-3);
        }
    }
}

/* Kachel-Radius: die Vorlage nimmt 20 px und zeichnet in Chrome/Edge eine Squircle-Ecke mit
   doppeltem Wert (40 px) - zu rundlich.  Wie die Dialoge 6 px, normale runde Ecke. */
html:root {
    --glass-radius: 6px;
    /* Navigationsleiste, Reiter, Knöpfe, Titelleisten: statt Pillen dieselben 6 px */
    --pill: 6px;
    --r-sm: 6px;                         /* Textfelder u. a.: wie Auswahlfelder und Knöpfe */
}
/* was rund bleiben muss: Schalter, Avatar, Benutzer-Punkt */
body .switch-button-background,
body .switch-button-button,
#UserProfile .rounded-full.from-unraid-red.to-orange,
.nav-user.show:after,
body .title .right > i.fa-toggle-off[onclick^="toggleTime"] {
    border-radius: 999px !important;
}
body table.dashboard > tbody {
    border-radius: var(--glass-radius) !important;
    corner-shape: round !important;
}

/* Auslastungsleiste in der Menüzeile: Unraid zeichnet oben einen dunklen und unten einen
   hellen Schatten (für die Pillenform gedacht); bei 6 px Radius liefen die Linien um die
   Ecken und brachen seitlich ab.  Gleichmäßiger Rand rundum, Füllung konzentrisch. */
body .usage-bar {
    box-shadow: inset 0 0 0 1px var(--bongit-line) !important;
    padding: 1px !important;
}
body .usage-bar > span {
    border-radius: calc(var(--pill) - 1px) !important;
}

/* Tabellen mit Zebra-Streifen (Plugins, Docker-Updates u. a., tablesorter): Unraid nimmt
   neutrale Grautöne (#f2f2f2 / #e8e8e8), die Vorlage setzt sie nicht.  Auf Papier bzw.
   Petrol wirkte das fremd.  Zeilen durchsichtig, jede zweite leicht in der Textfarbe. */
html:root {
    --dynamix-tablesorter-tbody-row-bg-color: transparent;
    --dynamix-tablesorter-tbody-row-alt-bg-color: color-mix(in srgb, var(--bongit-text) 5%, transparent);
}

/* ===== bongIT: schmale Fenster (halber Bildschirm, Tablet) ===== */

/* Hauptmenü: passt es nicht in die Kapsel, lässt es sich weiter seitlich wischen, aber ohne
   sichtbaren Scrollbalken unter den Reitern. */
#menu .nav-tile {
    scrollbar-width: none;
}
#menu .nav-tile::-webkit-scrollbar {
    display: none;
}

/* Fußzeile: der Copyright-Text war ein paar Pixel zu breit und bekam einen Scrollbalken */
#footer #copyright,
#footer .footer-right {
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Reiter mit Knopf rechts (Plugins: "Nach Aktualisierungen suchen", Docker: "Einfache
   Ansicht"): Unraid setzt den Knopf absolut an den rechten Rand der Reiter-Kapsel; bei
   schmalem Fenster lag er dann über den Reitern.  Dort rückt er unter die Kapsel, rechts
   bündig, und die Kapsel hält dafür unten Abstand. */
@media (max-width: 1280px) {
    nav.tabs .tabs-container > span.status {
        top: calc(100% + var(--sp-2)) !important;
        right: 0 !important;
        left: auto !important;
    }
    nav.tabs:has(> .tabs-container > span.status) {
        margin-bottom: calc(3.6rem + var(--sp-3));
    }
}

/* Hauptmenü neben der Symbolleiste: die Kapsel hatte feste Inhaltsbreite und schob sich bei
   schmalem Fenster unter die Symbole rechts.  Jetzt schrumpft sie und bleibt seitlich
   wischbar; die Symbolleiste behält ihre Breite. */
#menu .nav-tile:not(.right) {
    flex: 0 1 auto;
    min-width: 0;
    width: auto !important;
    max-width: max-content;
    overflow-x: auto;
}
#menu .nav-tile.right {
    flex: 0 0 auto;
}

/* Einstellungen: unser Symbol einfarbig wie Unraids Symbole (Bildmarke in der Textfarbe)
   statt der bunten roten Scheibe aus der Plugin-Liste. */
body img.PanelImg[src*="/bongit-theme/images/bongit-theme.png"] {
    object-position: -9999px 0;
    background-color: var(--bongit-text);
    -webkit-mask: url("data:image/png;base64,") center / contain no-repeat;
    mask: url("data:image/png;base64,") center / contain no-repeat;
}

/* Docker/VMs: Liste wird neu geladen (Klasse setzt BongitThemeHeader.page) */
body .bongit-laedt {
    opacity: 0.45;
    cursor: progress;
    pointer-events: none;
    transition: opacity 0.15s;
}

/* Mehrfach-Auswahl (jQuery dropdownchecklist, z. B. Freigaben -> "Einstellungen kopieren
   zu", Benutzer-/Laufwerkslisten): Unraid zeichnet nur einen Strich unten und klappt eine
   graue Liste mit dunklem Rand auf.  Jetzt wie die normalen Auswahlfelder. */
body span.ui-dropdownchecklist.ui-dropdownchecklist-selector-wrapper {
    border: 0 !important;
    border-radius: var(--pill) !important;
    background-color: color-mix(in srgb, var(--bongit-surface) 50%, transparent) !important;
    box-shadow: var(--pill-edge) !important;
    min-height: 2.4rem;
    padding: 2px var(--sp-3) !important;
    box-sizing: border-box;
    display: inline-flex !important;
    align-items: center;
}
body span.ui-dropdownchecklist-selector-wrapper .ui-dropdownchecklist-selector.ui-state-default {
    background: none !important;
    border: 0 !important;
    box-shadow: none !important;
    padding: 0 !important;
}
body .ui-dropdownchecklist-dropcontainer-wrapper .ui-dropdownchecklist-dropcontainer {
    border: 0 !important;
    border-radius: var(--pill) !important;
    background: var(--bongit-raised) !important;
    box-shadow: inset 0 0 0 1px var(--bongit-line), 0 8px 24px rgba(0, 0, 0, 0.18) !important;
    overflow: hidden;
}
body div.ui-dropdownchecklist-dropcontainer-wrapper {
    border: 0 !important;
    background: none !important;
}
body .ui-dropdownchecklist-item,
body .ui-dropdownchecklist-text {
    color: var(--bongit-text) !important;
    background: none !important;
    border: 0 !important;
}
body .ui-dropdownchecklist-item:hover {
    background: color-mix(in srgb, var(--bongit-text) 8%, transparent) !important;
}

/* Mehrzeilige Felder (SSH-Schlüssel, Skripte, Notizen): 6 px wie Textfelder, Auswahlfelder
   und Knöpfe (die Vorlage nimmt --r-md, 14 px) */
body textarea:not(.unapi *),
body .textarea {
    border-radius: var(--pill) !important;
}

/* ===== Plugins mit eigenen Farben (Scan aller Seiten 25.11.2026) ===== */

/* Unassigned Devices lädt style-white.css bzw. style-black.css nach dem Server-Theme, nicht
   nach der Hell/Dunkel-Wahl des Browsers: Tabellenkopf blieb #e8e8e8, auch in Dunkel.
   Wie Unraids eigene Tabellen. */
body table:is(.usb_mounts, .samba_mounts, .usb_absent) thead tr:first-child td {
    background-color: var(--table-header-background-color) !important;
}
body table:is(.usb_mounts, .samba_mounts, .usb_absent) tbody tr:nth-child(2n) {
    background-color: var(--dynamix-tablesorter-tbody-row-alt-bg-color) !important;
}
body table:is(.usb_mounts, .samba_mounts, .usb_absent) tbody tr:not(.tr_last):hover > td {
    background-color: color-mix(in srgb, var(--bongit-text) 8%, transparent) !important;
}

/* Hilfetexte (blockquote): manche Plugins (Appdata Backup, RAM-Disk) färben sie hellblau
   (#d9edf7), in Dunkel grell.  Einheitlich in Theme-Farben. */
body blockquote:not(.unapi *) {
    background: color-mix(in srgb, var(--bongit-cyan) 10%, transparent) !important;
    color: var(--bongit-text) !important;
    border: 0 !important;
    border-left: 3px solid var(--bongit-cyan) !important;
    border-radius: var(--pill) !important;
}

/* select2-Auswahlfelder (Tailscale-Einstellungen u. a.): weiß mit grauem Rand, auch in
   Dunkel.  Wie die normalen Auswahlfelder. */
body .select2-container .select2-selection {
    background-color: color-mix(in srgb, var(--bongit-surface) 50%, transparent) !important;
    border: 0 !important;
    border-radius: var(--pill) !important;
    box-shadow: var(--pill-edge) !important;
}
body .select2-container .select2-selection .select2-selection__rendered {
    color: var(--bongit-text) !important;
}
body .select2-dropdown {
    background: var(--bongit-raised) !important;
    color: var(--bongit-text) !important;
    border: 0 !important;
    border-radius: var(--pill) !important;
    box-shadow: inset 0 0 0 1px var(--bongit-line), 0 8px 24px rgba(0, 0, 0, 0.18) !important;
    overflow: hidden;
}
body .select2-results__option--highlighted {
    background: color-mix(in srgb, var(--bongit-cyan) 25%, transparent) !important;
    color: var(--bongit-text) !important;
}

/* Apps (Community Applications): Kacheln der Startseite 20 px -> wie die übrigen Kacheln */
body .ca_holder {
    border-radius: var(--glass-radius) !important;
}

/* ===== bongIT: Aufgaben-Fenster (Plugin installieren/aktualisieren, Docker, VM) =====
 * Unraid 7.4 zeigt die Ausgabe in einem sweet-alert-Fenster (Klasse nchan).  Die Vorlage
 * färbt das Protokollfeld dunkel ein und den Knopf mit heller Schrift: in der hellen Fassung
 * ergab das ein trübes Graublau und einen unsichtbaren oder orangefarbenen "Dismiss". */
html body .sweet-alert.nchan pre#swaltext {
    background: var(--bongit-protokoll-grund) !important;
    color: var(--bongit-text) !important;
    box-shadow: inset 0 0 0 1px var(--bongit-line) !important;
}
/* Unraid selbst: .sweet-alert.nchan button.confirm { color: white; background: orange } mit
   !important, daher hier dieselbe Spezifität plus html body. */
html body .sweet-alert.nchan button.confirm,
html body .sweet-alert button.confirm,
html body .sweet-alert button.cancel {
    color: var(--bongit-text) !important;
    background: var(--button-background) !important;
    box-shadow: var(--pill-edge) !important;
    border: 0 !important;
    border-radius: var(--pill) !important;   /* Unraid: 0.4rem, eckig neben den Pillen-Knöpfen */
    padding: var(--sp-2) var(--sp-5) !important;
}
html body .sweet-alert.nchan button.confirm:is(:hover, :focus-visible),
html body .sweet-alert button.confirm:is(:hover, :focus-visible),
html body .sweet-alert button.cancel:is(:hover, :focus-visible) {
    color: var(--hover-button-text-color, #ffffff) !important;
    background: var(--hover-button-background) !important;
}

/* Kästen im Protokoll (Docker: "Stoppe Container", "Befehlsausführung", "Verwaistes Image"
   …) sind <fieldset>-Rahmen.  Die Vorlage rundet nur fieldset.CMD ab; Unraid 7.4 nutzt auch
   andere, die blieben eckig mit dünnem Rand.  Alle abgerundet wie die übrigen Felder. */
html body .sweet-alert.nchan fieldset,
html body #logBody fieldset,
html body fieldset.CMD:not(.unapi *) {
    border: 0 !important;
    border-radius: var(--r-md) !important;
    padding: var(--sp-3) var(--sp-4) !important;
    background: var(--bongit-protokoll-grund) !important;
    box-shadow: inset 0 0 0 1px var(--bongit-line) !important;
}
html body .sweet-alert.nchan fieldset > legend,
html body #logBody fieldset > legend {
    padding: 0 var(--sp-2);
    color: var(--bongit-text-dim);
    font-weight: 600;
}
/* Das Eingabefeld des Fensters (meist ausgeblendet) steckt auch in einem <fieldset>: kein
   Kasten, sonst steht unten ein leerer Balken. */
html body .sweet-alert > fieldset,
html body .sweet-alert.nchan > fieldset {
    background: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    border-radius: 0 !important;
}

/* Fensteraufbau: ein Abstand (4 px) rundum zwischen Fensterrand und Titel, Statuszeile,
   Protokoll; Fenster 6 px, alles darin 2 px Radius (konzentrisch: innen = außen minus
   Abstand).  Die Vorlage rechnet mit 20 px Innenabstand des Fensters; Unraid 7.4 hat 0,
   dadurch ragten Titel und Protokoll seitlich 8 px über den Rand hinaus. */
html body .sweet-alert,
html body .sweet-alert.nchan,
html body .ui-dialog {
    border-radius: 6px !important;
}
html body .sweet-alert.nchan {
    --bongit-abstand: 4px;
    --bongit-innen: 2px;
}
html body .sweet-alert.nchan > h2 {
    margin: var(--bongit-abstand) var(--bongit-abstand) var(--bongit-abstand) !important;
    border-radius: var(--bongit-innen) !important;
}
html body .sweet-alert.nchan > h2::before {
    border-radius: var(--bongit-innen) !important;
}
html body .sweet-alert.nchan > .nchan-state {
    margin: 0 var(--bongit-abstand) !important;
    border-radius: var(--bongit-innen) !important;
}
html body .sweet-alert.nchan > p {
    margin: 0 !important;
    padding: var(--bongit-abstand) var(--bongit-abstand) 0 !important;
}
html body .sweet-alert.nchan pre#swaltext,
html body .sweet-alert.nchan > p > pre:is(#swaltext, #swalbody) {
    border-radius: var(--bongit-innen) !important;
}
html body .sweet-alert.nchan > .sa-button-container {
    padding: var(--bongit-abstand) !important;
}

/* Schalter (Autostart u. a.): Spur sichtbar auch auf hellem Grund */
body .switch-button-background:not(.checked) {
    background-color: color-mix(in srgb, var(--bongit-text-dim) 35%, transparent) !important;
}

/* ===== bongIT: ruhige Schrift =====
 * Die Vorlage lässt Überschriften schimmern (wandernde Farbflecken, Farbverlauf) und
 * Fokusränder pulsieren.  bongIT: einfarbig und still.  build.py setzt dazu alle
 * Schimmerfarben auf die Grundfarbe; hier werden die Bewegungen leer überschrieben
 * (die letzte @keyframes-Regel gleichen Namens gilt). */
@keyframes bongit-sheen { from, to { background-position: 0 50%; } }
@keyframes bongit-holo { from, to { opacity: 1; } }
@keyframes bongit-siri { from, to { opacity: 1; } }
@keyframes bongit-login-holo { from, to { background-position: 0 50%; } }
@keyframes bongit-login-lava { from, to { opacity: 1; } }
@keyframes bongit-login-siri { from, to { opacity: 1; } }

/* Die Farbflecken ganz weglassen: auch in Grundfarbe zeichneten sie über der Schrift sichtbar
   hellere Stellen.  Übrig bleibt die Grundfarbe (background-color, auf die Schrift
   geschnitten). */
html body .tile-header-main,
html body .tile-header-left i[class^="icon-"],
html body .tile-header-left i[class*=" icon-"],
html body div.title .left,
html body div.title .left i,
html body .sidenav :is(.rightTitle, .popupAuthorTitle),
html body .sweet-alert.nchan :is(h1, h2, h3),
html body #sb-title-inner,
html body .boot-title,
html body #login h1,
html body #login .case,
html body #login .case > * {
    background-image: none !important;
    animation: none !important;
}

/* Halo unter dem aktiven Seitenreiter: der Verlauf der Vorlage endet bei uns in Rot und sah
   rechts wie eine Fehlermarkierung aus.  Nur Petrol. */
body .tabs button[role="tab"]:is([aria-selected="true"], :active)::after,
html body #menu .nav-tile:not(.right) .nav-item:is(.active, :active)::after {
    background: linear-gradient(90deg, var(--bongit-cyan), var(--bongit-violet)) !important;
}
]]></INLINE>
</FILE>

<FILE Name="&cfg;/bongit-theme-hell.css">
<SHA256>40e6253abbf70a97cc1ea27a76df6e92a87be8e7196efb47387eabdf1d307047</SHA256>
<INLINE><![CDATA[
/*
 * bongIT Theme hell :: Unraid-Theme im bongIT-Hausstil, Version 2026.11.25.1201
 * Aufbau aus "Aether Glass" von aegisnir (MIT-Lizenz, siehe LICENSE), Farben von bongIT.
 * Erzeugt von build.py: nicht von Hand ändern, sondern build.py oder src/ anpassen.
 */
/*
 * bongIT Theme :: a deep-violet frosted-glass theme for the Unraid webGUI 7.2+
 * Unofficial: not made or endorsed by Lime Technology.
 * Built on the "Black" Dynamix theme ([Settings] -> [Display Settings]).
 *
 * Palette: cyan -> violet -> pink accents, periwinkle links, mint / amber / rose
 * status colours, squircle corners.  Adds:
 *   - a deep-violet aurora painted behind every page
 *   - frosted glass panels (title bars, tables, dashboard tiles, menu, footer, dialogs)
 *   - the system font (SF Pro on Mac and iPhone, Segoe UI on Windows) instead of Clear Sans
 *   - extra padding so text never touches a rounded edge, and wrapping where it is safe
 *   - Apple-style controls: pill buttons, fields and title bars, sentence-case labels,
 *     Spotlight-style shading and a Siri-style glow on focus
 *
 * Installed by the bongit-theme plugin, which appends this file to themes/black.css
 * in RAM at boot.  Nothing on the flash drive's stock files is changed.
 *
 * Tuning: the --glass-* values control the whole glass look.
 *   more see-through  -> lower --glass-alpha     (0.30)
 *   frostier          -> raise --glass-blur      (30px)
 *   slow browser      -> set --glass-blur to 0px (keeps the look, drops the blur cost)
 */

html:root {
    /* ---- bongIT palette ---- */
    --bongit-cyan: #306e7e;
    --bongit-violet: #336d7d;
    --bongit-pink: #eb0001;
    --bongit-gradient: linear-gradient(90deg, var(--bongit-cyan) 0, var(--bongit-violet) 50%, var(--bongit-pink) 100%);

    --bongit-bg: #f1ebdf;          /* deep dark violet */
    --bongit-surface: #eee7d9;
    --bongit-raised: #eae1d0;
    --bongit-line: #e3d8c1;
    --bongit-line-strong: #bcc7ca;
    --bongit-text: #1d414b;
    --bongit-text-dim: #52676c;
    --bongit-text-faint: #7d969d;

    /* ---- Font: the operating system's own UI font, nothing downloaded ---- */
    --bongit-font: -apple-system, BlinkMacSystemFont, system-ui, "Segoe UI Variable Text", "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;

    /* ---- Glass recipe ---- */
    --glass-alpha: 0.48;
    --glass-blur: 22px;
    --glass-radius: var(--r-lg);
    --glass-tint: rgb(250 247 241 / var(--glass-alpha));
    --glass-tint-strong: rgba(250, 247, 241, 0.66);
    --glass-edge: rgba(38, 85, 98, 0.12);
    --glass-filter: blur(var(--glass-blur)) saturate(125%);  /* kept low: more saturation re-brightens the violet behind every panel */
    --glass-shine:
        inset 0 1px 0 rgba(255, 255, 255, 0.14),             /* specular top edge */
        inset 0 0 0 1px var(--glass-edge),                   /* hairline rim */
        inset 0 -12px 24px -18px rgba(51, 109, 125, 0.18);   /* violet glow pooling at the bottom */
    --glass-drop: 0 12px 40px -12px rgba(26, 58, 67, 0.315);

    /* ---- Apple-style pills ---- */
    --pill: 999px;
    --hairline: rgba(255, 255, 255, 0.1);
    /* lighter at the top, darker at the bottom, like the Spotlight search bar */
    --pill-sheen: linear-gradient(180deg, rgba(255, 255, 255, 0.1) 0, rgba(255, 255, 255, 0.03) 50%, rgba(26, 58, 67, 0.099) 100%);
    --pill-edge:
        inset 0 1px 0 rgba(255, 255, 255, 0.16),
        inset 0 0 0 1px var(--hairline);

    /* ---- Text ---- */
    --text-color: var(--bongit-text);
    --alt-text-color: var(--bongit-text-dim);
    --disabled-text-color: var(--bongit-text-faint);
    --link-text-color: #377688;         /* light brand violet, cohesive with the palette */
    --link-visited-color: #306776;      /* a dustier violet for pages already opened */

    /* ---- Surfaces: transparent so the glass panels show the aurora ---- */
    --background-color: var(--bongit-bg);
    --opac-background-color: rgba(252, 249, 245, 0.935);
    --mild-background-color: rgba(248, 243, 234, 0.495);
    --dashboard-background-color: transparent;
    --dashboard-border-color: var(--glass-edge);
    --radio-background-color: rgba(248, 243, 234, 0.66);
    --title-header-background-color: transparent;
    --footer-background-color: transparent;
    --shade-bg-color: rgba(249, 246, 238, 0.55);
    --input-bg-color: rgba(252, 249, 245, 0.385);
    --focus-input-bg-color: rgba(248, 243, 234, 0.66);
    --dynamix-filetree-bg-color: var(--glass-tint-strong);
    --dynamix-sweet-alert-icon-bg-color: transparent;

    /* ---- Lines ---- */
    --border-color: rgba(48, 107, 123, 0.12);
    --disabled-border-color: rgba(48, 107, 123, 0.08);
    --input-border-color: var(--bongit-line-strong);
    --disabled-input-border-color: var(--bongit-line);
    --textarea-border-color: var(--bongit-line-strong);
    --hr-color: rgba(48, 107, 123, 0.12);
    --small-shadow: 0 0 3px var(--bongit-line);

    /* ---- Tables ---- */
    --table-border-color: rgba(48, 107, 123, 0.1);
    --table-background-color: rgba(255, 255, 255, 0.025);
    --table-header-background-color: rgba(51, 109, 125, 0.048);
    --hover-table-row-background-color: rgba(51, 109, 125, 0.084);

    /* ---- Usage bars (status bars are recoloured under "Status colours") ---- */
    --usage-bar-background-color: rgba(48, 107, 123, 0.12);
    --usage-bar-used-background-color: var(--bongit-violet);
    --usage-disk-background-color: rgba(48, 107, 123, 0.08);

    /* ---- Accent: replaces Unraid's orange/red brand colours ---- */
    --brand-orange: #306e7e;
    --brand-red: var(--bongit-pink);
    --checkbox-color: var(--bongit-line-strong);
    --checkbox-hover-color: var(--bongit-violet);

    /* ---- Buttons: glass pills, violet fill on hover (the Siri glow is added under "Controls") ---- */
    --button-text-color: var(--bongit-text);
    --button-border: 0;
    --button-background: var(--pill-sheen), rgba(248, 243, 233, 0.605);
    --button-background-size: auto;
    --hover-button-border: 0;
    --hover-button-text-color: #ffffff;
    --hover-button-background: linear-gradient(180deg, #377687 0, #316878 55%, #2a5966 100%);

    /* ---- Scrollbars ---- */
    --scrollbar-color: var(--bongit-line-strong);
    --scrollbar-hover-color: #244e59;

    /*
     * ---- Shape and space scales ----
     * Radii: one small set.  Nested shapes follow Apple's "concentric" rule: the
     * inner radius is the outer radius minus the gap between them, so the curves
     * run parallel instead of pinching.
     *   --r-xs   6px  tooltips, small chips
     *   --r-sm  10px  tabs, folder boxes, the log well inside a dialog
     *   --r-md  14px  multi-line text boxes
     *   --r-lg  20px  panels: tables, dashboard tiles
     *   --r-xl  28px  floating sheets: dialogs, the reboot card
     *   --pill        anything one line tall: buttons, fields, title bars, usage bars
     * Spacing: everything sits on a 4px grid.
     */
    --r-xs: 6px;
    --r-sm: 10px;
    --r-md: 14px;
    --r-lg: 20px;
    --r-xl: 28px;
    --sp-1: 4px;
    --sp-2: 8px;
    --sp-3: 12px;
    --sp-4: 16px;
    --sp-5: 20px;
    --sp-6: 24px;
    --sp-8: 32px;
    --sp-12: 48px;
    --gutter: var(--sp-6);     /* window edge to content */
    --inset: var(--sp-5);      /* panel edge to text; title pills and tables share it so their text lines up */

    /* Older names used further down, kept as aliases of the scale */
    --bongit-radius: var(--r-sm);
    --bongit-radius-small: var(--r-xs);
}


/* Native checkboxes, radio buttons and sliders take the theme violet instead of the Mac's
   accent colour.  (Native dropdown menus can't be tinted from a web page: their highlight
   comes from macOS, System Settings -> Appearance -> Accent colour.) */
html:root {
    accent-color: var(--bongit-violet);
}

/* ===== Background: violet aurora for the glass to blur, plus the faint circuit grid ===== */

/* The aurora sits on its own pinned layer (position: fixed) instead of a fixed page
   background (background-attachment: fixed).  Same look, but a pinned layer is drawn once
   and reused by the graphics card, while a fixed page background gets repainted whenever
   anything above it changes, and every frosted panel then re-blurs it.  Cheap on a fast
   computer, noticeable on a slow one. */
body {
    background-color: var(--bongit-bg);
}
body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image:
        linear-gradient(rgba(51, 109, 125, 0.021) 1px, transparent 1px),
        linear-gradient(90deg, rgba(51, 109, 125, 0.021) 1px, transparent 1px),
        radial-gradient(60vw 50vh at 12% 8%, rgba(42, 90, 103, 0.156), transparent 70%),
        radial-gradient(45vw 40vh at 90% 18%, rgba(235, 0, 1, 0.063), transparent 70%),
        radial-gradient(45vw 40vh at 85% 85%, rgba(48, 110, 126, 0.038), transparent 70%),
        radial-gradient(70vw 60vh at 40% 100%, rgba(46, 99, 113, 0.114), transparent 70%);
    background-size: 24px 24px, 24px 24px, auto, auto, auto, auto;
}


/* ===== Font ===== */

/* Unraid names Clear Sans in several places instead of inheriting, so each one is listed.
   Icon fonts and the monospace log are deliberately left alone. */
html,
body input:not(.unapi *),
body select:not(.unapi *),
body textarea:not(.unapi *),
body button:not(.unapi *),
body a.button:not(.unapi *),
body .textarea,
body .font-sans,
body .sweet-alert,
body pre#swalbody,
body #sb-title-inner,
body #sb-info-inner,
body .ui-dropdownchecklist-text,
body .ui-dialog-buttonset button {
    font-family: var(--bongit-font);
}


/* ===== Glass panels ===== */

/* Section title bars ("Array Devices", "Pool Devices", ...): glass pills */
body div.title {
    border-bottom: none;
    border-radius: var(--pill);
    background-color: var(--glass-tint);
    background-image: var(--pill-sheen);
    -webkit-backdrop-filter: var(--glass-filter);
    backdrop-filter: var(--glass-filter);
    box-shadow: var(--pill-edge), var(--glass-drop);
    font-weight: 600;
    letter-spacing: 0.02em;
}

/* Data tables (Main, Shares, Docker, VMs, Plugins, ...).
   clip-path rounds the corners without breaking Unraid's collapsed row borders.
   A box-shadow rim (even an inset one) is sliced square at those rounded corners in Safari,
   so instead the tables get the top highlight and a soft violet edge drawn by the gradients,
   both of which fade cleanly into the curve. */
body table:not(.unapi *):not(.dashboard) {
    background-color: var(--glass-tint);
    background-image:
        linear-gradient(180deg, rgba(255, 255, 255, 0.07), transparent 28px),
        linear-gradient(0deg, rgba(51, 109, 125, 0.096), transparent 22px);
    -webkit-backdrop-filter: var(--glass-filter);
    backdrop-filter: var(--glass-filter);
    clip-path: inset(0 round var(--glass-radius));
}

/* Column headers in sentence case and a softer colour, like a Finder list view */
body table.unraid thead tr:first-child > td {
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--bongit-text-dim);
}

/*
 * Array Operation is six tables stacked on top of each other, most inside their
 * own <form>.  They are joined into one panel: square seams in between, the
 * rounded top and shine on the first (the only one without .noshift), the
 * rounded bottom and glow on the last (the one with no array table after it).
 */
body table.array_status:not(.unapi *) {
    clip-path: none;
    background-image: none;
}
body table.array_status:not(.noshift):not(.unapi *) {
    clip-path: inset(0 round var(--glass-radius) var(--glass-radius) 0 0);
    background-image: linear-gradient(180deg, rgba(255, 255, 255, 0.07), transparent 28px);
}
body :not(form) > table.array_status:not(:has(~ table.array_status, ~ form table.array_status)):not(.unapi *),
body form:not(:has(~ table.array_status, ~ form table.array_status)) > table.array_status:not(.unapi *) {
    clip-path: inset(0 round 0 0 var(--glass-radius) var(--glass-radius));
    background-image: linear-gradient(0deg, rgba(51, 109, 125, 0.096), transparent 22px);
}
/* Tables nested inside another panel stay clear, or the glass doubles up */
body table table:not(.unapi *),
body .sweet-alert table:not(.unapi *),
body .ui-dialog table:not(.unapi *) {
    background-color: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    clip-path: none;
    box-shadow: none;
}

/*
 * Dashboard: each tile is a <tbody> inside one big table.dashboard per column.
 * Browsers ignore rounded corners and blur on table sections, so each tile is
 * laid out as its own small table instead; then it can be a rounded glass card.
 * The "stopgap" rows between tiles are Unraid's drag-and-drop targets: they stay,
 * but lose the solid page colour Unraid paints them with (those were the dark strips).
 */
body table.dashboard {
    display: block;
    background-color: transparent;
}
body table.dashboard > tbody,
body table.dashboard > thead {
    display: table;
    width: 100%;
    table-layout: auto;
    border-collapse: separate;
    border-spacing: 0;
}
body table.dashboard > tbody {
    overflow: hidden;
    border: 0;
    /* Cells supply the left/right inset; the tile had almost no top/bottom to match it,
       so content sat high and tight.  The tbody is display:table here, so padding lands
       on the tile box and gives it the same breathing room top and bottom. */
    padding: var(--inset) 0;
    background: var(--glass-tint);
    -webkit-backdrop-filter: var(--glass-filter);
    backdrop-filter: var(--glass-filter);
    border-radius: var(--glass-radius);
    box-shadow: var(--glass-shine), var(--glass-drop);
}
body table.dashboard td.stopgap {
    background-color: transparent;
    height: var(--sp-4) !important;
    line-height: var(--sp-4) !important;
}
/* The tbody padding above already gives the tile a 20px top/bottom frame, matching the
   20px side inset.  Unraid adds its own ~10px on the header cell and the last row on top
   of that, so the vertical frame measured 30px against the 20px sides.  Drop that extra
   padding on the first and last rows so all four sides line up. */
body table.dashboard > tbody > tr:first-child > td {
    padding-top: 0;
}
body table.dashboard > tbody > tr:last-child > td {
    padding-bottom: 0;
}
/* Container / app names on the dashboard tiles: Unraid lays each entry out as a
   fixed ~185px box (.outer, float:left) holding a 42px icon plus the name over its
   status, and lets the name grow with nowrap and no clipping.  Long names
   (long-container-name-with-a-suffix) pushed past the box and overlapped
   the next one.  Don't touch the box or the float (that changes how many columns fit):
   just cap the name line to the space left beside the icon and clip it with an ellipsis.
   The status sits on its own line after a <br>, so only the name span (first child of
   .inner) is clamped. */
body table.dashboard .outer .inner > span:first-child {
    display: inline-block;
    max-width: 140px;         /* ~185px cell minus the 42px icon, so the name never widens it */
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    vertical-align: bottom;
}
/* Tile buttons (settings, collapse): small glass circles instead of grey squares.
   Unraid ties their icon colour to a background setting, which made them vanish. */
body table.dashboard .control,
body .tile-ctrl > .fa.hand {
    /* exact circles; display is left to Unraid so buttons it hides stay hidden */
    width: 3rem;
    height: 3rem;
    padding: 0;
    box-sizing: border-box;
    line-height: 3rem;
    text-align: center;
    font-size: 1.3rem !important;
    border-radius: 50%;
    color: var(--bongit-text-dim);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.04) 55%, rgba(26, 58, 67, 0.081));
    -webkit-backdrop-filter: blur(10px) saturate(160%);
    backdrop-filter: blur(10px) saturate(160%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28), inset 0 0 0 1px rgba(255, 255, 255, 0.12), 0 2px 6px -2px rgba(26, 58, 67, 0.27);
    transition: background 0.2s, color 0.2s, box-shadow 0.2s;
}
body table.dashboard .control:hover,
body .tile-ctrl > .fa.hand:hover {
    color: #ffffff;
    opacity: 1;
    background: linear-gradient(180deg, rgba(55, 118, 136, 0.33), rgba(51, 109, 125, 0.18));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), inset 0 0 0 1px rgba(38, 85, 98, 0.3), 0 0 12px rgba(51, 109, 125, 0.3);
}
body .tile-ctrl {
    gap: var(--sp-2);
}
/* Tile header controls: the array / power actions (.tile-ctrl) and the view actions
   (.tile-header-right-controls) read as two groups split by a faint hairline, not capsules. */
body table.dashboard .tile-ctrl,
body table.dashboard .tile-header-right-controls {
    align-items: center;
    gap: var(--sp-2);
}
body table.dashboard .tile-header-right {
    gap: var(--sp-4);
    align-items: center;
    /* Align the controls to the top of the header instead of centring in the (tall, two-line)
       title row, so the gap above them matches the gap to the tile's right edge. */
    align-self: flex-start;
}
/* Faint vertical separator between the two groups, only when both are present */
body table.dashboard .tile-ctrl + .tile-header-right-controls {
    border-left: 1px solid var(--hairline);
    padding-left: var(--sp-4);
}

/* Case icon (the server graphic on the main tile): Unraid's default-cases.css paints it
   a fixed orange (rgb 241, 90, 44).  Retint it to the theme violet so it belongs. */
body i#mycase,
body [class^="case-"],
body [class*=" case-"] {
    color: var(--bongit-violet) !important;
}

/* Holographic headers: an Apple-style pearlescent sheen for attention text.  The title is
   filled with a soft cyan / violet / pink gradient that drifts slowly and continuously, so
   it is always gently coloured rather than white with the odd flash.  The fill is clipped
   to the glyphs; reduced-motion users get the same sheen held still. */
@keyframes bongit-sheen {
    from { background-position: 0% 50%; }
    to   { background-position: 200% 50%; }
}
body .tile-header-main,
body .tile-header-left i[class^="icon-"],
body .tile-header-left i[class*=" icon-"],
body div.title .left,
body div.title .left i,
body .sidenav :is(.rightTitle, .popupAuthorTitle) {
    background: linear-gradient(90deg, #285866, #285866);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: bongit-sheen 14s linear infinite;
}
@media (prefers-reduced-motion: reduce) {
    body .tile-header-main,
    body .tile-header-left i[class^="icon-"],
    body .tile-header-left i[class*=" icon-"],
    body div.title .left,
    body div.title .left i,
    body .sidenav :is(.rightTitle, .popupAuthorTitle) { animation: none; }
}

/* Dashboard charts.  The ring colours and percentage colours are status colours that
   Unraid's script writes onto each element (green / orange / red by load), so they are
   left alone.  Only the decorative defaults change:
     - the donut centre was a fixed grey disc; now it matches the card, so it reads as a ring
     - CPU load bars: see "Bar types" at the end of this file */
html:root {
    --dashstats-pie-after-bg-color: #ece4d4;
}
body div.pie::after {
    box-shadow: inset 0 1px 4px rgba(26, 58, 67, 0.225), 0 0 0 1px rgba(38, 85, 98, 0.08);
}
/* System tile layout: Unraid splits it into two equal halves (labels | pies), but the labels
   need far less than half.  The labels now take only their own width and the pies get the
   rest, so each pie can be drawn 25% larger (zoom scales the whole pie: rings, number and
   all, so the ring maths below stays in its original 92px units).  The pie row also moves up
   a little into the spare space under the tile's buttons, so the tile barely grows. */
@media (min-width: 768px) {
    body .tile-system-memory-body {
        grid-template-columns: max-content 1fr;
        column-gap: var(--sp-8);
    }
}
body .tile-system-memory-charts {
    margin-top: -12px;   /* -24px let the last label touch the tile's buttons */
    column-gap: var(--sp-2);
}
body .tile-system-memory-charts div.pie {
    zoom: 1.25;
    margin: 0.4rem auto 0;
}
/* When the legend is long (6+ entries) the tile grows taller than the pies: the pie row
   centres itself in that height, and if the row is wide enough for four bigger pies side by
   side (4 x 92px x 1.45 + gaps = 556px), they step up to 1.45x to use the room.  On narrower
   screens they stay at 1.25x rather than overlap.  (A smooth scale would need dividing one
   length by another, which Safari doesn't reliably support yet.) */
body .tile-system-memory-body:has(#dynamic > i:nth-of-type(6)) .tile-system-memory-charts {
    align-self: center;
}
body .tile-system-memory-charts {
    container-type: inline-size;
}
@container (min-width: 560px) {
    body .tile-system-memory-body:has(#dynamic > i:nth-of-type(6)) .tile-system-memory-charts div.pie {
        zoom: 1.45;
    }
}

/* Dashboard pies, styled like the bongIT UI rating ring =====
   Generated by gen-pie-css.py (private theme folder): edit the script, not this block.
   Unraid's script redraws each pie every few seconds as an inline conic-gradient (a colour
   wheel), one colour per slice, ending with the "free" colour.  CSS can't do maths on that,
   but it can spot exact text, so the rules at the end read WHERE each slice starts (one rule
   per percentage, per slice colour).  The pie is then redrawn as separate arcs, one per
   slice, each with a slight colour shift (deeper at the start, brighter at the end) and a
   round end layered over the next slice.  The free part is a dim tinted track.
   Safari writes the stops as "rgb(...) 3%, rgb(...) 3%"; Chrome as "rgb(...) 0% 3%"; both match.
   The ring is drawn on the number <span>'s ::before / ::after, so it can take its colour
   from the number, which Unraid colours with YOUR warning / critical thresholds. */
body div.pie {
    --bongit-ring-t: 12px;                    /* ring thickness: 92px pie minus the 68px centre */
    --bongit-ring-r: 40px;                    /* radius to the middle of the ring */
    /* slice k runs from --_sk to --_ek (percent); slices that aren't there are empty */
    --_s1: 0;
    --_e1: var(--bongit-ring-s2, var(--bongit-ring-s3, var(--bongit-ring-s4, var(--bongit-ring-p, 0))));
    --_len1: calc(var(--_e1) - var(--_s1));
    --_s2: var(--_e1);
    --_e2: var(--bongit-ring-s3, var(--bongit-ring-s4, var(--bongit-ring-p, 0)));
    --_len2: calc(var(--_e2) - var(--_s2));
    --_s3: var(--_e2);
    --_e3: var(--bongit-ring-s4, var(--bongit-ring-p, 0));
    --_len3: calc(var(--_e3) - var(--_s3));
    --_s4: var(--_e3);
    --_e4: var(--bongit-ring-p, 0);
    --_len4: calc(var(--_e4) - var(--_s4));
    position: relative;
    isolation: isolate;
    background: none !important;              /* hide Unraid's own wheel */
}
body div.pie::before { display: none; }       /* the old violet blend layer */
body div.pie > span:first-child {
    --bongit-ring-c: #1d8b4b;                 /* sea green; amber / rose below follow Unraid's colours */
    --bongit-ring-k1: var(--bongit-ring-c);
    --bongit-ring-k2: var(--bongit-ring-c);
    --bongit-ring-k3: var(--bongit-ring-c);
    --bongit-ring-k4: var(--bongit-ring-c);
    color: var(--bongit-ring-c) !important;
}
body div.pie > span:first-child[style*="rgb(230, 138, 0)"] { --bongit-ring-c: #b9770e; }
body div.pie > span:first-child[style*="rgb(240, 0, 12)"] { --bongit-ring-c: #eb0001; }
/* The track: the whole ring in a dim tint of the status colour */
body div.pie > span:first-child::after,
body div.pie > span:first-child::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;
    --_ring: radial-gradient(circle, transparent calc(var(--bongit-ring-r) - var(--bongit-ring-t) / 2 - 0.5px), #1a3a43 calc(var(--bongit-ring-r) - var(--bongit-ring-t) / 2), #1a3a43 calc(var(--bongit-ring-r) + var(--bongit-ring-t) / 2), transparent calc(var(--bongit-ring-r) + var(--bongit-ring-t) / 2 + 0.5px));
}
body div.pie > span:first-child::after {
    z-index: -1;
    background: color-mix(in srgb, var(--bongit-ring-c) 20%, #ece4d4);
    -webkit-mask: var(--_ring);
    mask: var(--_ring);
}
/* The slices, layered: no gaps; each slice's round end sits ON TOP of the start of the next
   slice (or the track), like Apple's activity rings, and the first slice has a round start.
   At 100% the last round end overlaps that start, so the ring closes on a curve.
   Blending the round ends into the arc:
     - each slice's colour shift runs from its start to where its end cap begins, then holds
       the end colour, so the end cap (a solid dot of that colour) matches the arc beneath it;
     - the start cap isn't painted on: past the total the arc's paint switches back to the
       first slice's start colour, so the start cap takes its colour from the arc itself;
     - short slices shift less (full shift from 25% of the ring), so a 3% slice is one smooth
       pill rather than a dark dot and a light dot. */
body div.pie > span:first-child::before {
    --_len1: calc(var(--_e1) - var(--_s1));
    --_c1: min(8.6deg, calc(var(--_len1) * 1.8deg));   /* round end's angular half-width, at most half the slice */
    --_r1: min(calc(var(--bongit-ring-t) / 2), max(0px, calc(var(--_len1) * 100px)));   /* no dot on an empty slice */
    --_b1: calc(var(--_e1) * 3.6deg);
    --_len2: calc(var(--_e2) - var(--_s2));
    --_c2: min(8.6deg, calc(var(--_len2) * 1.8deg));   /* round end's angular half-width, at most half the slice */
    --_r2: min(calc(var(--bongit-ring-t) / 2), max(0px, calc(var(--_len2) * 100px)));   /* no dot on an empty slice */
    --_b2: calc(var(--_e2) * 3.6deg);
    --_len3: calc(var(--_e3) - var(--_s3));
    --_c3: min(8.6deg, calc(var(--_len3) * 1.8deg));   /* round end's angular half-width, at most half the slice */
    --_r3: min(calc(var(--bongit-ring-t) / 2), max(0px, calc(var(--_len3) * 100px)));   /* no dot on an empty slice */
    --_b3: calc(var(--_e3) * 3.6deg);
    --_len4: calc(var(--_e4) - var(--_s4));
    --_c4: min(8.6deg, calc(var(--_len4) * 1.8deg));   /* round end's angular half-width, at most half the slice */
    --_r4: min(calc(var(--bongit-ring-t) / 2), max(0px, calc(var(--_len4) * 100px)));   /* no dot on an empty slice */
    --_b4: calc(var(--_e4) * 3.6deg);
    --_r0: min(calc(var(--bongit-ring-t) / 2), max(0px, calc(var(--bongit-ring-p, 0) * 100px)));
    background: radial-gradient(circle at calc(50% + var(--bongit-ring-r) * sin(var(--_b1))) calc(50% - var(--bongit-ring-r) * cos(var(--_b1))), oklch(from var(--bongit-ring-k1) calc(l + 0.04) c h) calc(var(--_r1) - 0.5px), transparent var(--_r1)), radial-gradient(circle at calc(50% + var(--bongit-ring-r) * sin(var(--_b2))) calc(50% - var(--bongit-ring-r) * cos(var(--_b2))), oklch(from var(--bongit-ring-k2) calc(l + 0.04) c h) calc(var(--_r2) - 0.5px), transparent var(--_r2)), radial-gradient(circle at calc(50% + var(--bongit-ring-r) * sin(var(--_b3))) calc(50% - var(--bongit-ring-r) * cos(var(--_b3))), oklch(from var(--bongit-ring-k3) calc(l + 0.04) c h) calc(var(--_r3) - 0.5px), transparent var(--_r3)), radial-gradient(circle at calc(50% + var(--bongit-ring-r) * sin(var(--_b4))) calc(50% - var(--bongit-ring-r) * cos(var(--_b4))), oklch(from var(--bongit-ring-k4) calc(l + 0.04) c h) calc(var(--_r4) - 0.5px), transparent var(--_r4)), conic-gradient(in oklch, color-mix(in oklch, oklch(from var(--bongit-ring-k1) calc(l - 0.12) calc(c * 1.08) calc(h - 18)) calc(clamp(0, var(--_len1) * 4, 100) * 1%), oklch(from var(--bongit-ring-k1) calc(l + 0.04) c h)) calc(var(--_s1) * 3.6deg), oklch(from var(--bongit-ring-k1) calc(l + 0.04) c h) calc(var(--_b1) - var(--_c1)), oklch(from var(--bongit-ring-k1) calc(l + 0.04) c h) var(--_b1), color-mix(in oklch, oklch(from var(--bongit-ring-k2) calc(l - 0.12) calc(c * 1.08) calc(h - 18)) calc(clamp(0, var(--_len2) * 4, 100) * 1%), oklch(from var(--bongit-ring-k2) calc(l + 0.04) c h)) calc(var(--_s2) * 3.6deg), oklch(from var(--bongit-ring-k2) calc(l + 0.04) c h) calc(var(--_b2) - var(--_c2)), oklch(from var(--bongit-ring-k2) calc(l + 0.04) c h) var(--_b2), color-mix(in oklch, oklch(from var(--bongit-ring-k3) calc(l - 0.12) calc(c * 1.08) calc(h - 18)) calc(clamp(0, var(--_len3) * 4, 100) * 1%), oklch(from var(--bongit-ring-k3) calc(l + 0.04) c h)) calc(var(--_s3) * 3.6deg), oklch(from var(--bongit-ring-k3) calc(l + 0.04) c h) calc(var(--_b3) - var(--_c3)), oklch(from var(--bongit-ring-k3) calc(l + 0.04) c h) var(--_b3), color-mix(in oklch, oklch(from var(--bongit-ring-k4) calc(l - 0.12) calc(c * 1.08) calc(h - 18)) calc(clamp(0, var(--_len4) * 4, 100) * 1%), oklch(from var(--bongit-ring-k4) calc(l + 0.04) c h)) calc(var(--_s4) * 3.6deg), oklch(from var(--bongit-ring-k4) calc(l + 0.04) c h) calc(var(--_b4) - var(--_c4)), oklch(from var(--bongit-ring-k4) calc(l + 0.04) c h) var(--_b4), color-mix(in oklch, oklch(from var(--bongit-ring-k1) calc(l - 0.12) calc(c * 1.08) calc(h - 18)) calc(clamp(0, var(--_len1) * 4, 100) * 1%), oklch(from var(--bongit-ring-k1) calc(l + 0.04) c h)) calc(var(--bongit-ring-p, 0) * 3.6deg));
    -webkit-mask: radial-gradient(circle at calc(50% + var(--bongit-ring-r) * sin(var(--_b1))) calc(50% - var(--bongit-ring-r) * cos(var(--_b1))), #1a3a43 calc(var(--_r1) - 0.5px), transparent var(--_r1)), radial-gradient(circle at calc(50% + var(--bongit-ring-r) * sin(var(--_b2))) calc(50% - var(--bongit-ring-r) * cos(var(--_b2))), #1a3a43 calc(var(--_r2) - 0.5px), transparent var(--_r2)), radial-gradient(circle at calc(50% + var(--bongit-ring-r) * sin(var(--_b3))) calc(50% - var(--bongit-ring-r) * cos(var(--_b3))), #1a3a43 calc(var(--_r3) - 0.5px), transparent var(--_r3)), radial-gradient(circle at calc(50% + var(--bongit-ring-r) * sin(var(--_b4))) calc(50% - var(--bongit-ring-r) * cos(var(--_b4))), #1a3a43 calc(var(--_r4) - 0.5px), transparent var(--_r4)), radial-gradient(circle at calc(50% + var(--bongit-ring-r) * sin(0deg)) calc(50% - var(--bongit-ring-r) * cos(0deg)), #1a3a43 calc(var(--_r0) - 0.5px), transparent var(--_r0)), var(--_ring), conic-gradient(#1a3a43 calc(var(--bongit-ring-p, 0) * 3.6deg), transparent 0);
    -webkit-mask-composite: source-over, source-over, source-over, source-over, source-over, source-in;
    mask: radial-gradient(circle at calc(50% + var(--bongit-ring-r) * sin(var(--_b1))) calc(50% - var(--bongit-ring-r) * cos(var(--_b1))), #1a3a43 calc(var(--_r1) - 0.5px), transparent var(--_r1)), radial-gradient(circle at calc(50% + var(--bongit-ring-r) * sin(var(--_b2))) calc(50% - var(--bongit-ring-r) * cos(var(--_b2))), #1a3a43 calc(var(--_r2) - 0.5px), transparent var(--_r2)), radial-gradient(circle at calc(50% + var(--bongit-ring-r) * sin(var(--_b3))) calc(50% - var(--bongit-ring-r) * cos(var(--_b3))), #1a3a43 calc(var(--_r3) - 0.5px), transparent var(--_r3)), radial-gradient(circle at calc(50% + var(--bongit-ring-r) * sin(var(--_b4))) calc(50% - var(--bongit-ring-r) * cos(var(--_b4))), #1a3a43 calc(var(--_r4) - 0.5px), transparent var(--_r4)), radial-gradient(circle at calc(50% + var(--bongit-ring-r) * sin(0deg)) calc(50% - var(--bongit-ring-r) * cos(0deg)), #1a3a43 calc(var(--_r0) - 0.5px), transparent var(--_r0)), var(--_ring), conic-gradient(#1a3a43 calc(var(--bongit-ring-p, 0) * 3.6deg), transparent 0);
    mask-composite: add, add, add, add, add, intersect;
    filter: drop-shadow(0 0 4px color-mix(in oklch, var(--bongit-ring-c) 40%, transparent));
}
/* RAM: the outer ring is the total in the status colour, like the other pies; the inner rings
   (below) show the types in these colours, matching their legend dots. */
body div.pie#sys0 {
    --bongit-ring-k1: #306e7e;   /* System: cyan */
    --bongit-ring-k2: #357182;   /* 1st hook (usually Docker): violet */
    --bongit-ring-k3: #b9770e;   /* 2nd hook (usually VMs): amber */
    --bongit-ring-k4: #eb0001;   /* 3rd hook and any after it: rose */
}
body div.pie#sys0 > span:first-child {
    /* outer ring: one slice, 0 to the total */
    --_s2: var(--bongit-ring-p, 0);
    --_s3: var(--bongit-ring-p, 0);
    --_s4: var(--bongit-ring-p, 0);
    --_e1: var(--bongit-ring-p, 0);
    --_e2: var(--bongit-ring-p, 0);
    --_e3: var(--bongit-ring-p, 0);
    --_e4: var(--bongit-ring-p, 0);
}
body tbody[title*="Memory"] i.ups.fa-circle { filter: none; }
/* The legend is written as HTML text, so its colours are hex; match rgb() too in case a
   later Unraid sets them by script.  Free keeps its grey. */
body i.ups.fa-circle:is(:is([style*="#787878" i], [style*="#a8a8a8" i]), :is([style*="rgb(120, 120, 120)"], [style*="rgb(168, 168, 168)"])) { color: #306e7e !important; }
body i.ups.fa-circle:is([style*="#d77e0d" i], [style*="rgb(215, 126, 13)"]) { color: #357182 !important; }
body i.ups.fa-circle:is([style*="#d4ac0d" i], [style*="rgb(212, 172, 13)"]) { color: #b9770e !important; }
body i.ups.fa-circle:is([style*="#cd5c5c" i], [style*="rgb(205, 92, 92)"]) { color: #eb0001 !important; }
body i.ups.fa-circle:is([style*="#ffc0cb" i], [style*="rgb(255, 192, 203)"]) { color: #eb0001 !important; }
body i.ups.fa-circle:is([style*="#e6e6fa" i], [style*="rgb(230, 230, 250)"]) { color: #eb0001 !important; }
body i.ups.fa-circle:is([style*="#9370db" i], [style*="rgb(147, 112, 219)"]) { color: #eb0001 !important; }
body i.ups.fa-circle:is([style*="#7cfc00" i], [style*="rgb(124, 252, 0)"]) { color: #eb0001 !important; }
body i.ups.fa-circle:is([style*="#228b22" i], [style*="rgb(34, 139, 34)"]) { color: #eb0001 !important; }
body i.ups.fa-circle:is([style*="#00ffff" i], [style*="rgb(0, 255, 255)"]) { color: #eb0001 !important; }
body i.ups.fa-circle:is([style*="#4682b4" i], [style*="rgb(70, 130, 180)"]) { color: #eb0001 !important; }

/* RAM pie, detail rings (generated, see gen-pie-css.py: inner_rings).  Geometry in the pie's
   own 92px units: the outer ring is 10px wide at radius 36-46; the detail rings share the
   zone from radius 34 inwards with 1.5px gaps, as thick as fits (max 7px) while leaving a
   centre of at least 16px radius for the number. */
body div.pie#sys0 {
    --bongit-ring-t: 10px;
    --bongit-ring-r: 41px;
    --_p1: clamp(0, var(--_len1) * 100, 1);   /* 1 if type 1 is there */
    --_p2: clamp(0, var(--_len2) * 100, 1);   /* 1 if type 2 is there */
    --_p3: clamp(0, var(--_len3) * 100, 1);   /* 1 if type 3 is there */
    --_p4: clamp(0, var(--_len4) * 100, 1);   /* 1 if type 4 is there */
    --_n: calc(var(--_p1) + var(--_p2) + var(--_p3) + var(--_p4));
    --_t: clamp(1.75, (18 - (var(--_n) - 1) * 1.5) / max(var(--_n), 1), 7);   /* ring thickness */
    --_d: calc(34 - var(--_n) * var(--_t) - (var(--_n) - 1) * 1.5);              /* centre radius */
    --_rank1: calc(clamp(0, (var(--_len2) - var(--_len1)) * 2 + 0, 1) + clamp(0, (var(--_len3) - var(--_len1)) * 2 + 0, 1) + clamp(0, (var(--_len4) - var(--_len1)) * 2 + 0, 1));
    --_r1: calc(34 - var(--_t) / 2 - var(--_rank1) * (var(--_t) + 1.5));   /* ring 1 centre radius */
    --_rank2: calc(clamp(0, (var(--_len1) - var(--_len2)) * 2 + 1, 1) + clamp(0, (var(--_len3) - var(--_len2)) * 2 + 0, 1) + clamp(0, (var(--_len4) - var(--_len2)) * 2 + 0, 1));
    --_r2: calc(34 - var(--_t) / 2 - var(--_rank2) * (var(--_t) + 1.5));   /* ring 2 centre radius */
    --_rank3: calc(clamp(0, (var(--_len1) - var(--_len3)) * 2 + 1, 1) + clamp(0, (var(--_len2) - var(--_len3)) * 2 + 1, 1) + clamp(0, (var(--_len4) - var(--_len3)) * 2 + 0, 1));
    --_r3: calc(34 - var(--_t) / 2 - var(--_rank3) * (var(--_t) + 1.5));   /* ring 3 centre radius */
    --_rank4: calc(clamp(0, (var(--_len1) - var(--_len4)) * 2 + 1, 1) + clamp(0, (var(--_len2) - var(--_len4)) * 2 + 1, 1) + clamp(0, (var(--_len3) - var(--_len4)) * 2 + 1, 1));
    --_r4: calc(34 - var(--_t) / 2 - var(--_rank4) * (var(--_t) + 1.5));   /* ring 4 centre radius */
    background: radial-gradient(circle, #ece4d4 calc(var(--_d) * 1px - 0.5px), transparent calc(var(--_d) * 1px)) !important;
}
body div.pie#sys0 > span:first-child { font-size: min(19px, calc(var(--_d) * 0.85px)) !important; }
/* Unraid swaps the number for the size on hover by hiding one span and showing the other.
   Both spans carry rings, so they stay displayed and only their TEXT swaps. */
body div.pie#sys0 > span:first-child { display: block !important; }
body div.pie#sys0:hover > span:first-child { color: transparent !important; }
body div.pie#sys0 > span.var0 {
    display: flex !important;
    position: absolute;
    inset: 0;
    z-index: 1;
    align-items: center;
    justify-content: center;
    color: transparent;
    font-size: 0 !important;
}
body div.pie#sys0:hover > span.var0 {
    color: var(--bongit-text);
    font-size: min(13px, calc((var(--_d) * 2.7 - 4) / 4.3 * 1px)) !important;
    z-index: 3;
}
/* On hover the total ring hides and the detail rings spring outwards (scaled from the centre
   by 46/34) to fill the space it left; the size shows in the middle. */
body div.pie#sys0:hover > span:first-child::before,
body div.pie#sys0:hover > span:first-child::after { display: none !important; }
body div.pie#sys0:hover { background: radial-gradient(circle, #ece4d4 calc(var(--_d) * 1.353px - 0.5px), transparent calc(var(--_d) * 1.353px)) !important; }
body div.pie#sys0::before,
body div.pie#sys0::after,
body div.pie#sys0 > span.var0::before,
body div.pie#sys0 > span.var0::after {
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);   /* springy: overshoots a touch, then settles */
}
@media (prefers-reduced-motion: reduce) {
    body div.pie#sys0::before,
    body div.pie#sys0::after,
    body div.pie#sys0 > span.var0::before,
    body div.pie#sys0 > span.var0::after { transition: none; }
}
body div.pie#sys0:hover::before,
body div.pie#sys0:hover::after,
body div.pie#sys0:hover > span.var0::before,
body div.pie#sys0:hover > span.var0::after { transform: scale(1.353); }
