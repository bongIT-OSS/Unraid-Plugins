<FILE Name="&emhttp;/README.md">
<SHA256>e079ad927862e80537f58d6159e76d88e82db432e9eef90dd5a3186680650f4a</SHA256>
<INLINE>
**bongIT Theme**

Unraid-Theme im bongIT-Hausstil, hell und dunkel.

Einstellungen unter „bongIT Theme“.  Hell/Dunkel: Sonne/Mond in der Symbolleiste (je Browser) oder Anzeige-Einstellungen, Farbschema Weiß bzw. Schwarz.  Grundlage: Aether Glass von aegisnir (MIT-Lizenz).
</INLINE>
</FILE>

<FILE Run="/bin/bash">
<INLINE>
# Umzug vom früheren Namen "bongIT Glass" (Plugin bongit-glass): Freigabe, Effekte und
# Notschalter übernehmen.  Das alte Plugin bitte unter Plugins entfernen.
if [ -d /boot/config/plugins/bongit-glass ]; then
    mkdir -p "&cfg;"
    for f in approved-version effects.cfg DISABLED; do
        if [ -f "/boot/config/plugins/bongit-glass/$f" ]; then
            if [ ! -f "&cfg;/$f" ]; then
                cp "/boot/config/plugins/bongit-glass/$f" "&cfg;/$f"
            fi
        fi
    done
fi

# Dateien früherer Fassungen entfernen (Login/Protokoll hell stecken jetzt in einer Datei)
rm -f "&cfg;/bongit-theme-login-hell.css" "&cfg;/bongit-theme-logging-hell.css"

# Icon aus Base64 auspacken
base64 -d "&cfg;/bongit-theme.png.b64" &gt; "&cfg;/bongit-theme.png" &amp;&amp; rm -f "&cfg;/bongit-theme.png.b64"

# Einstellungsseite und apply.sh in den Webgui-Ordner (RAM, bei jedem Boot neu)
mkdir -p "&emhttp;"
for f in BongitTheme.page BongitThemeHeader.page BongitThemeModus.page; do
    cp "&cfg;/$f" "&emhttp;/$f"
done
cp "&cfg;/apply.sh" "&emhttp;/apply.sh"
chmod 755 "&emhttp;/apply.sh"
mkdir -p "&emhttp;/images"
cp "&cfg;/bongit-theme.png" "&emhttp;/images/bongit-theme.png"

# Theme anwenden, wenn freigegeben.  Immer exit 0, sonst schiebt Unraid das Plugin beiseite.
"&emhttp;/apply.sh" || true

echo ""
if [ "$(cat "&cfg;/approved-version" 2&gt;/dev/null)" = "$(. /etc/unraid-version; echo "$version")" ]; then
    echo "bongIT Theme ist installiert und aktiv."
else
    echo "bongIT Theme ist installiert.  Einstellungen -&gt; bongIT Theme: diese Unraid-Version freigeben und einschalten."
fi
exit 0
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
[ -x "&emhttp;/apply.sh" ] &amp;&amp; "&emhttp;/apply.sh" --remove

for f in BongitTheme.page BongitThemeHeader.page BongitThemeModus.page apply.sh README.md; do
    rm -f "&emhttp;/$f"
done
rm -f "&emhttp;/images/bongit-theme.png"
rmdir "&emhttp;/images" 2&gt;/dev/null
rmdir "&emhttp;" 2&gt;/dev/null

for f in bongit-theme.css bongit-theme-hell.css bongit-theme-login.css bongit-theme-logging.css apply.sh BongitTheme.page BongitThemeHeader.page BongitThemeModus.page bongit-theme.png bongit-theme.png.b64 approved-version DISABLED effects.cfg kopf.cfg; do
    rm -f "&cfg;/$f"
done
rmdir "&cfg;" 2&gt;/dev/null

echo "bongIT Theme ist entfernt.  Seite neu laden."
exit 0
</INLINE>
</FILE>

</PLUGIN>
