<FILE Name="&emhttp;/styles/protokoll.css">
<INLINE><![CDATA[
/* Ginkgo by bongIT 2026.11.25.2327: Protokollfenster (logging.htm) (c) 2026 bongIT – Markus Bong, MIT.
 * Fassung über die Klasse am <html> (setzt der Block in logging.htm, siehe einbinden.sh). */
html.bongit {
    --bp-grund: #fbf8f2;
    --bp-text: #1a3a43;
    --bp-linie: #ddd3bf;
    --bp-knopf: #224954;
    --bp-knopf-hover: #1a3a43;
}
html.bongit.bongit-dunkel {
    --bp-grund: #0c1f24;
    --bp-text: #f2ebdd;
    --bp-linie: #224954;
    --bp-knopf: #224954;
    --bp-knopf-hover: #2e5e6b;
    color-scheme: dark;
}
html.bongit body {
    background: var(--bp-grund);
    color: var(--bp-text);
}
html.bongit :is(input[type=button], input[type=reset], input[type=submit], button, a.button) {
    background: var(--bp-knopf);
    color: #f2ebdd;
    border: 1px solid var(--bp-knopf);
    border-radius: 6px;
}
html.bongit :is(input[type=button], input[type=reset], input[type=submit], button, a.button):hover {
    background: var(--bp-knopf-hover);
    color: #f2ebdd;
}
/* Meldungszeilen: farbige Streifen mit lesbarer Schrift, in Dunkel abgetönt */
html.bongit span.label { border-radius: 4px; }
html.bongit.bongit-dunkel span.error { color: #ff8a8a; background-color: rgb(255 0 1 / 0.16); }
html.bongit.bongit-dunkel span.warn { color: #f0a830; background-color: rgb(240 168 48 / 0.14); }
html.bongit.bongit-dunkel span.system { color: #9ed3df; background-color: rgb(61 138 156 / 0.18); }
html.bongit.bongit-dunkel span.array { color: #5cd68a; background-color: rgb(92 214 138 / 0.14); }
html.bongit.bongit-dunkel span.login { color: #ffb38a; background-color: rgb(255 120 60 / 0.14); }
]]></INLINE>
<SHA256>07b3b23051d0372a93338280e6e9f2835f90a0aae5d3245baea57b4a00d92a89</SHA256>
