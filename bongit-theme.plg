.8%22 fill=%22%23f2ebdd%22 fill-opacity=%220.19%22/%3E%3Ccircle cx=%22650%22 cy=%2220%22 r=%221.8%22 fill=%22%23f2ebdd%22 fill-opacity=%220.19%22/%3E%3Cpolyline points=%22290,80 360,80 380,60 470,60%22 fill=%22none%22 stroke=%22%237cc0cf%22 stroke-opacity=%220.24%22 stroke-width=%221.4%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/%3E%3Ccircle cx=%22290%22 cy=%2280%22 r=%222.6%22 fill=%22none%22 stroke=%22%237cc0cf%22 stroke-opacity=%220.38%22 stroke-width=%221.2%22/%3E%3Ccircle cx=%22470%22 cy=%2260%22 r=%222.6%22 fill=%22none%22 stroke=%22%237cc0cf%22 stroke-opacity=%220.38%22 stroke-width=%221.2%22/%3E%3Cpolyline points=%22350,80 380,80 390,90 430,90%22 fill=%22none%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22 stroke-width=%221.4%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/%3E%3Ccircle cx=%22350%22 cy=%2280%22 r=%222.6%22 fill=%22none%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.19%22 stroke-width=%221.2%22/%3E%3Ccircle cx=%22430%22 cy=%2290%22 r=%222.6%22 fill=%22none%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.19%22 stroke-width=%221.2%22/%3E%3Cpolyline points=%22220,20 310,20 320,10 400,10 470,10 490,30 550,30%22 fill=%22none%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22 stroke-width=%221.4%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/%3E%3Ccircle cx=%22220%22 cy=%2220%22 r=%222.6%22 fill=%22none%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.19%22 stroke-width=%221.2%22/%3E%3Ccircle cx=%22550%22 cy=%2230%22 r=%221.8%22 fill=%22%23f2ebdd%22 fill-opacity=%220.19%22/%3E%3Cpolyline points=%22390,80 490,80 500,90 580,90 650,90%22 fill=%22none%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.12%22 stroke-width=%221.4%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/%3E%3Ccircle cx=%22390%22 cy=%2280%22 r=%222.6%22 fill=%22none%22 stroke=%22%23f2ebdd%22 stroke-opacity=%220.19%22 stroke-width=%221.2%22/%3E%3Ccircle cx=%22650%22 cy=%2290%22 r=%222.6%22 fill=%22none%22 stroke=%22%23f2ebdd%22 stroke-opacity=%22