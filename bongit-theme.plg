<FILE Name="&emhttp;/BongitTheme.page">
<INLINE><![CDATA[
Menu="UserPreferences"
Title="Ginkgo"
Icon="bongit-theme.png"
Tag="paint-brush"
---
<?php
/* Ginkgo (by bongIT): Einstellungsseite.
 *
 * Gespeichert wird über Unraids update.php nach /boot/config/plugins/bongit-theme/bongit-theme.cfg
 * (aktiv, kopf); danach bindet scripts/einbinden.sh Login-Seite und Protokollfenster neu ein.
 * Eigene Banner gehen über include/banner.php nach /boot/config/plugins/dynamix/.
 */
require_once '/usr/local/emhttp/plugins/bongit-theme/include/zustand.php';
$bongit = bongit_zustand($display);
$einst = $bongit['einst'];
$bongit_version = trim(@file_get_contents('/usr/local/emhttp/plugins/bongit-theme/VERSION') ?: '');
$unraid_version = parse_ini_file('/etc/unraid-version')['version'] ?? '';
$schema = ['black' => 'Schwarz', 'white' => 'Weiß', 'azure' => 'Azur', 'gray' => 'Grau'][$display['theme'] ?? ''] ?? ($display['theme'] ?? '');
function bongit_banner_stand(string $m): string {
  $f = "/boot/config/plugins/dynamix/bongit-banner-$m.png";
  if (!is_file($f)) return '';
  $g = @getimagesize($f);
  return date('d.m.Y H:i', filemtime($f)).($g ? " · {$g[0]} × {$g[1]}" : '');
}
function bongit_banner_bild(string $m): string {
  $f = "/boot/config/plugins/dynamix/bongit-banner-$m.png";
  return is_file($f) ? htmlspecialchars("$f?v=".filemtime($f)) : '';
}
?>
<div class="bongit-seite">

<div class="bongit-status <?=$bongit['aktiv'] ? 'an' : 'aus'?>">
  <i class="fa <?=$bongit['aktiv'] ? 'fa-check-circle' : 'fa-pause-circle'?>"></i>
  <div>
    <strong><?=$bongit['aktiv'] ? 'Das Theme ist aktiv.' : 'Das Theme ist aus.'?></strong>
    <?php if (!$bongit['aktiv']): ?><span><?=htmlspecialchars($bongit['grund'])?></span><?php endif; ?>
    <span>Ginkgo <?=htmlspecialchars($bongit_version)?> · Unraid <?=htmlspecialchars($unraid_version)?> · Farbschema <?=htmlspecialchars($schema)?></span>
  </div>
</div>

<form markdown="1" name="bongit_theme" method="POST" action="/update.php" target="progressFrame" onsubmit="bongitNachSpeichern()">
<input type="hidden" name="#file" value="bongit-theme/bongit-theme.cfg">
<input type="hidden" name="#command" value="/plugins/bongit-theme/scripts/einbinden.sh">

Theme:
: <select name="aktiv">
  <?=mk_option($einst['aktiv'], 'ja', 'Eingeschaltet')?>
  <?=mk_option($einst['aktiv'], 'nein', 'Ausgeschaltet')?>
  </select>

<blockquote class="inline_help">
Ausgeschaltet zeigt die Weboberfläche wieder Unraids eigenes Farbschema; das Plugin bleibt installiert.
</blockquote>

Kopfzeile:
: <select name="kopf">
  <?=mk_option($einst['kopf'], 'muster', 'Platinen-Muster')?>
  <?=mk_option($einst['kopf'], 'banner', 'Eigenes Banner')?>
  </select>

<blockquote class="inline_help">
Platinen-Muster oder ein eigenes Banner, etwa mit dem eigenen Logo in der Mitte (unten hochladen, je eins für hell und dunkel; fehlt eins, gilt das andere für beide).
Ohne eigene Banner wird das Banner aus Einstellungen → Anzeige verwendet.
</blockquote>

&nbsp;
: <span class="inline-block">
    <input type="submit" value="<?=_('Apply')?>" disabled>
    <input type="button" value="<?=_('Done')?>" onclick="done()">
  </span>

</form>

<div class="title"><span class="left"><i class="fa fa-picture-o title"></i>Eigene Banner</span></div>

<p class="bongit-hinweis">PNG, möglichst 3840 Pixel breit (bei 1920 Pixel Fensterbreite wird das Bild halb so hoch angezeigt, 60 bis 240 Pixel).
Links und rechts füllt die Farbe am Bildrand, wenn das Fenster breiter ist als das Bild.</p>

<div class="bongit-banner-wahl">
<?php foreach (['hell' => 'Hell', 'dunkel' => 'Dunkel'] as $m => $name): $bild = bongit_banner_bild($m); ?>
  <div class="bongit-banner-karte" data-modus="<?=$m?>">
    <div class="bongit-banner-kopf"><strong><?=$name?></strong><span class="bongit-banner-stand"><?=bongit_banner_stand($m) ?: 'kein Banner'?></span></div>
    <div class="bongit-banner-vorschau bongit-<?=$m?>-vorschau"><?php if ($bild): ?><img src="<?=$bild?>" alt="Banner <?=$name?>"><?php else: ?><span>kein Banner</span><?php endif; ?></div>
    <div class="bongit-banner-knoepfe">
      <input type="file" accept="image/png" hidden onchange="bongitBanner(this, 'speichern')">
      <input type="button" value="Hochladen …" onclick="this.parentNode.querySelector('input[type=file]').click()">
      <input type="button" value="Löschen" onclick="bongitBanner(this, 'loeschen')"<?=$bild ? '' : ' disabled'?>>
    </div>
    <div class="bongit-banner-meldung" role="status"></div>
  </div>
<?php endforeach; ?>
</div>

<div class="title"><span class="left"><i class="fa fa-adjust title"></i>Hell, Dunkel, Automatisch</span></div>

<p class="bongit-hinweis">Jeder Browser wählt selbst: Knopf <i class="fa fa-adjust"></i> oben rechts in der Symbolleiste, reihum Hell → Dunkel → Automatisch (folgt der Systemeinstellung des Geräts).
Ohne eigene Wahl gilt das Farbschema des Servers unter Einstellungen → Anzeige: Schwarz = dunkel, Weiß = hell.
Die Login-Seite folgt der Systemeinstellung des Geräts, Protokollfenster dem Fenster, aus dem sie geöffnet werden.</p>

<div class="title"><span class="left"><i class="fa fa-life-ring title"></i>Notschalter</span></div>

<p class="bongit-hinweis">Ein Aufruf ohne Theme: <code>?bongit=aus</code> an die Adresse hängen, z. B. <code>/Dashboard?bongit=aus</code>.<br>
Dauerhaft aus, auch beim Booten: eine Datei <code>DISABLED</code> in <code>/boot/config/plugins/bongit-theme/</code> anlegen (geht auch am PC mit dem Stick).
Im abgesicherten Modus (Safe Mode) lädt Unraid gar keine Plugins.</p>

<p class="bongit-fuss">Ginkgo by bongIT · Herausgeber bongIT – Markus Bong · MIT-Lizenz</p>

</div>

<style>
.bongit-seite { max-width: 1100px; }
.bongit-status { display: flex; gap: 12px; align-items: flex-start; padding: 12px 16px; margin: 8px 0 20px;
  border: 1px solid var(--border-color); border-radius: 6px; }
.bongit-status i.fa { font-size: 2.2rem; line-height: 1; }
.bongit-status.an i.fa { color: var(--bongit-gruen, #1e8a4c); }
.bongit-status.aus i.fa { color: var(--bongit-orange, #b9770e); }
.bongit-status div { display: flex; flex-direction: column; gap: 2px; }
.bongit-status span { color: var(--alt-text-color); }
.bongit-hinweis { max-width: 80ch; line-height: 1.6; }
.bongit-banner-wahl { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; margin: 12px 0 24px; }
.bongit-banner-karte { border: 1px solid var(--border-color); border-radius: 6px; padding: 12px; }
.bongit-banner-kopf { display: flex; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
.bongit-banner-stand { color: var(--alt-text-color); }
.bongit-banner-vorschau { height: 70px; border-radius: 6px; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.bongit-hell-vorschau { background: #ebe3d1; color: #5b7178; }
.bongit-dunkel-vorschau { background: #0f2a31; color: #b8c4c6; }
.bongit-banner-vorschau img { max-width: 100%; max-height: 100%; }
.bongit-banner-knoepfe { margin-top: 8px; }
.bongit-banner-meldung { min-height: 1.6em; color: var(--alt-text-color); }
.bongit-banner-meldung.fehler { color: var(--bongit-rot, #e00001); }
.bongit-fuss { margin-top: 28px; color: var(--alt-text-color); }
</style>

<script>
function bongitNachSpeichern() {
  // update.php läuft im progressFrame; danach die Seite neu laden, damit der neue Zustand gilt
  $('#progressFrame').one('load', function () { setTimeout(function () { location.reload(); }, 300); });
}

function bongitBanner(feld, aktion) {
  var karte = feld.closest('.bongit-banner-karte');
  var modus = karte.dataset.modus;
  var meldung = karte.querySelector('.bongit-banner-meldung');
  function zeigen(text, fehler) { meldung.textContent = text; meldung.classList.toggle('fehler', !!fehler); }
  function senden(daten) {
    daten.modus = modus;
    daten.aktion = aktion;
    daten.csrf_token = csrf_token;
    $.post('/plugins/bongit-theme/include/banner.php', daten)
      .done(function (a) {
        zeigen(aktion === 'loeschen' ? 'Gelöscht.' : 'Gespeichert. Die Seite wird neu geladen …');
        setTimeout(function () { location.reload(); }, 900);
      })
      .fail(function (x) {
        var a = x.responseJSON || {};
        zeigen(a.fehler || a.error || 'Fehler beim Speichern (' + x.status + ').', true);
      });
  }
  if (aktion === 'loeschen') {
    zeigen('wird gelöscht …');
    senden({});
    return;
  }
  var datei = feld.files && feld.files[0];
  feld.value = '';
  if (!datei) return;
  if (datei.type !== 'image/png') { zeigen('Bitte eine PNG-Datei wählen.', true); return; }
  if (datei.size > 5 * 1024 * 1024) { zeigen('Das Bild ist größer als 5 MB.', true); return; }
  zeigen('wird hochgeladen …');
  var leser = new FileReader();
  leser.onload = function () { senden({ bild: leser.result }); };
  leser.onerror = function () { zeigen('Die Datei konnte nicht gelesen werden.', true); };
  leser.readAsDataURL(datei);
}
</script>
]]></INLINE>
