body .usage-disk.sys > span:first-child {
    background-color: var(--bongit-violet);
}

/* Docker / VM items on the dashboard: soft rounded chips instead of sharp dark boxes */
body span.outer {
    border-radius: var(--r-sm);
}
body span.outer.solid {
    background-color: transparent;
    transition: background-color 0.2s;
}
body span.outer.solid:hover {
    background-color: rgba(255, 255, 255, 0.06);
}
/* (Thin .mm bars: see "Bar types" at the end of this file.) */
/* The processor history graph is a <canvas> the script paints orange.  CSS can't
   recolour a canvas, but it can shift its hue: orange turns violet while the grey
   grid lines (which have no hue) stay as they are. */
body #cpuchart {
    /* (Superseded by the height-gradient treatment at the end of this file.) */
}

/* Tile titles and column labels in sentence case, like the rest of the theme */
body .tile-header-main,
body span.header,
body tr.header {
    text-transform: none;
    letter-spacing: 0.01em;
}
body span.header,
body tr.header {
    color: var(--bongit-text-dim);
    font-weight: 600;
}

/* Cinematic header: no hard bar edge, a Safari-ribbon-grade backdrop blur (vibrancy), and
   a top-down violet wash that fades to transparent, so the chrome dissolves downward as
   content scrolls under it instead of ending in a line. */
#menu {
    display: flex;
    align-items: center;
    /* Sticky, so the controls stay put as the page scrolls.  Breathing room above the
       capsule so it isn't jammed under the bongIT band. */
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 10px 0;
    background: none;
    box-shadow: none;
}
/* Cinematic scrim: opaque dark and blurred at the top, fading GRADUALLY to perfectly clear
   at the bottom.  The mask fades the blur out alongside the tint, so the bottom is truly
   clear (no blur cliff), and because it's anchored to the top with no bottom edge it reads
   as a top-down fade, not a bar.  It sits behind the controls, which stay sharp. */
#menu::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: -14px;
    z-index: -1;
    pointer-events: none;
    /* No colour wash, just the blur: solid behind the controls, fading out in a 14px strip
       just below them.  (It was a 40px fade, which left the first line of content under the
       menu blurred and hard to read, e.g. the "Array Devices" header on Main.) */
    -webkit-backdrop-filter: blur(28px) saturate(120%);
    backdrop-filter: blur(28px) saturate(120%);
    -webkit-mask: linear-gradient(180deg, #1a3a43 0%, #1a3a43 calc(100% - 14px), transparent 100%);
    mask: linear-gradient(180deg, #1a3a43 0%, #1a3a43 calc(100% - 14px), transparent 100%);
}
/* Utilities (the 90% usage bar + icon buttons) grouped on the right, on one baseline.
   Left in normal flow so Unraid's search field expands and restores the way it expects. */
#menu .nav-tile.right {
    margin-left: auto;
    display: flex;
    align-items: center;
}
/* Keep the 90% bar at the start of the utilities group, so Unraid's search field (which
   opens in the same row) pushes only the icons and the bar doesn't flip to the far side. */
#menu .nav-tile.right .usage-bar {
    order: -1;
}
/* Header utility icons: no box or circle, just the colour and hover treatment, the glyphs
   sit on their own and brighten to white with a soft violet glow on hover. */
#menu .nav-tile.right .nav-item.util > a > span {
    display: none;
}
#menu .nav-tile.right .nav-item.util > a {
    color: var(--bongit-text-dim);
    background: none;
    box-shadow: none;
    transition: color 0.2s, text-shadow 0.2s;
}
#menu .nav-tile.right .nav-item.util > a:hover {
    color: #ffffff;
    text-shadow: 0 0 8px rgba(55, 118, 136, 0.42);
}
#menu .nav-tile.right .nav-item.util:after {
    display: none;
}
/* Power button (Dynamix System Buttons plugin): it's a red PNG, so CSS colour can't reach
   it.  The image is swapped for a drawn power glyph in the same dim tone as the other header
   icons (self-contained SVG, nothing is fetched).  Hover turns it crimson rose with a soft
   glow instead of white/violet: it's a power action, so it should still say "careful". */
#menu .nav-item.PowerButton img.system {
    content: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%2352676c%22%20stroke-width%3D%222.2%22%20stroke-linecap%3D%22round%22%3E%3Cpath%20d%3D%22M12%203v8%22%2F%3E%3Cpath%20d%3D%22M6.3%206.6a8%208%200%201%200%2011.4%200%22%2F%3E%3C%2Fsvg%3E");
    width: 17px;
    height: 17px;
    transition: filter 0.2s;
}
/* The same plugin's dropdown header uses buttons.png, a tiny dark-grey icon that reads as a
   broken image on the dark theme.  Matched by file name (the menu is drawn outside #menu)
   and swapped for the power glyph in the theme's violet. */
img[src$="/dynamix.system.buttons/icons/buttons.png"] {
    content: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23377688%22%20stroke-width%3D%222.2%22%20stroke-linecap%3D%22round%22%3E%3Cpath%20d%3D%22M12%203v8%22%2F%3E%3Cpath%20d%3D%22M6.3%206.6a8%208%200%201%200%2011.4%200%22%2F%3E%3C%2Fsvg%3E");
    width: 16px;
    height: 16px;
    border: 0;
    background: none;
}
#menu .nav-item.PowerButton a:hover img.system {
    content: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23eb0001%22%20stroke-width%3D%222.2%22%20stroke-linecap%3D%22round%22%3E%3Cpath%20d%3D%22M12%203v8%22%2F%3E%3Cpath%20d%3D%22M6.3%206.6a8%208%200%201%200%2011.4%200%22%2F%3E%3C%2Fsvg%3E");
    filter: drop-shadow(0 0 6px rgba(235, 0, 1, 0.56));
}
/* The menu strip paints the header colour by default, which would hide the glass */
#menu .nav-tile {
    background-color: transparent;
}
/* Menu labels in sentence case, like macOS, instead of spaced-out capitals */
#menu .nav-item a {
    text-transform: none;
    letter-spacing: 0.01em;
    font-weight: 600;
}
/* The glowing marker under the current page, now a tiny pill */
.nav-item:after,
.nav-user.show:after {
    height: 3px;
    border-radius: var(--pill);
}
.nav-item:focus:after,
.nav-item:hover:after,
.nav-user.show:hover:after {
    background: var(--bongit-violet);
}
.nav-item.active:after {
    background: var(--bongit-gradient);
    box-shadow: 0 0 10px rgba(51, 109, 125, 0.54), 0 0 2px rgba(255, 255, 255, 0.5);
}

/*
 * Header logos (drawn by Unraid's newer Vue components):
 *   - the UNRAID wordmark is an <img> with the orange gradient baked in, so it is
 *     repainted cyan -> violet -> pink through a mask of Unraid's own logo file
 *   - the round avatar on the right is a red -> orange gradient circle; only that
 *     exact element is targeted, so Unraid's red error text elsewhere stays red
 */
unraid-header-os-version a[href="https://unraid.net"] img {
    /* Recolour Unraid's own wordmark without shipping a copy of it: the stock picture is
       slid out of its box (object-position), the box is painted with the theme gradient,
       and Unraid's logo file on this server is used as a stencil (mask) so the gradient
       only shows through the letters. */
    object-position: -9999px 0;
    background: var(--bongit-gradient);
    -webkit-mask: url("/webGui/images/UN-logotype-gradient.svg") center / contain no-repeat;
    mask: url("/webGui/images/UN-logotype-gradient.svg") center / contain no-repeat;
}
#UserProfile .rounded-full.from-unraid-red.to-orange {
    background-image: linear-gradient(135deg, var(--bongit-cyan) 0, var(--bongit-violet) 55%, var(--bongit-pink) 100%);
    box-shadow: 0 0 14px rgba(51, 109, 125, 0.33);
}

/*
 * Main menu tabs: a macOS-style segmented capsule.  All tabs sit in one glass capsule;
 * the current page is a raised violet pill with a soft gradient glow all the way around
 * it (like the Siri edge glow), and no hard ring; hover shows only a faint pill.
 */
#menu .nav-tile:not(.right) {
    align-self: center;
    gap: 2px;
    width: max-content;
    min-height: 0;
    height: auto;
    margin: 0 0 0 var(--gutter);
    padding: 3px;
    line-height: normal;
    border-radius: var(--pill);
    /* More opaque than before so the blur behind the header doesn't bleed through and make
       the capsule look out of focus; crisper rim for definition. */
    background: rgba(250, 247, 241, 0.682);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14), inset 0 0 0 1px rgba(38, 85, 98, 0.2);
    isolation: isolate;     /* keeps the active tab's glow behind the tab but inside the menu */
}
#menu .nav-tile:not(.right) .nav-item {
    position: relative;
    border-radius: var(--pill);
    transition: background-color 0.2s;
}
#menu .nav-tile:not(.right) .nav-item a {
    display: block;
    padding: 6px var(--sp-4);
    line-height: 2rem;
    font-weight: 500;
    /* Brighter than --bongit-text-dim so resting tabs read as easily as the page tabs */
    color: #323f42;
    transition: color 0.2s;
}
/* Hover + press match the page tabs (Plugins, Docker...): a soft
   fill and white text, eased in, with NO glow ring, plus a quick press-in on click. */
#menu .nav-tile:not(.right) .nav-item {
    transition: background-color 0.2s, transform 0.12s ease-out;
}
#menu .nav-tile:not(.right) .nav-item:hover {
    background: rgba(255, 255, 255, 0.07);
}
#menu .nav-tile:not(.right) .nav-item:hover a {
    color: #ffffff;
}
#menu .nav-tile:not(.right) .nav-item:active,
body .tabs button[role="tab"]:active {
    transform: scale(0.96);
}
/* Click feel for the main menu.  Page tabs switch in place, so the browser animates
   pressed -> active for free.  A menu click loads a NEW page, so that can't carry over.
   Faked in two halves: (1) while the mouse is down, a violet flash + press-in;
   (2) on the new page, the active tab "settles" in from pressed and bright to normal. */
/* While pressed (and while Safari waits for the next page, which can take a second), the tab
   shows EXACTLY the first frame of the new page's settle animation: violet pill, pressed to
   94%, full-strength gradient halo.  So old page -> new page is one continuous motion with no
   flat-purple pause in between.  Same three-layer build as the active tab below. */
#menu .nav-tile:not(.right) .nav-item:active {
    isolation: isolate;
    background: none;
    transform: scale(0.94);
}
#menu .nav-tile:not(.right) .nav-item:active::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: var(--pill);
    background: linear-gradient(180deg, #b9c5c8, #c7d0d3);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), inset 0 0 0 1px rgba(38, 85, 98, 0.32);
}
#menu .nav-tile:not(.right) .nav-item:active::after {
    content: "";
    display: block;
    position: absolute;
    inset: -6px;
    z-index: -2;
    border-radius: var(--pill);
    background: var(--bongit-gradient);
    filter: blur(10px);
    opacity: 1;
}
#menu .nav-tile:not(.right) .nav-item:active a {
    color: #ffffff;
    font-weight: 600;
}
/* The active tab is built as three fixed layers so its stacking never changes:
     item  (isolated layer, no background of its own)
     ::before  the violet pill + rim         z-index -1
     ::after   the blurred gradient halo     z-index -2  (behind the pill = "backlit")
   Why: the earlier version put the pill on the item itself.  Any animation using transform or
   filter turns the item into its own layer while it runs, which pulled the halo IN FRONT of
   the pill, and the instant the animation ended the halo snapped back behind it (the abrupt
   change).  With the item always isolated and the pill on ::before, the order is
   the same before, during and after, so the glow can fade smoothly.
   On page load: the press-in springs back (0.35s) and the halo dims from full gradient glow
   down to the soft backlight (1.4s). */
#menu .nav-tile:not(.right) .nav-item.active {
    isolation: isolate;
    background: none;
    box-shadow: none;
    animation: bongit-tab-press-out 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
}
#menu .nav-tile:not(.right) .nav-item.active::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: var(--pill);
    background: linear-gradient(180deg, #b9c5c8, #c7d0d3);
    /* the thin light rim the page tabs' active pill has */
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), inset 0 0 0 1px rgba(38, 85, 98, 0.32);
}
@keyframes bongit-tab-press-out {
    from { transform: scale(0.94); }
    to   { transform: none; }
}
@keyframes bongit-tab-halo-dim {
    0%   { opacity: 1;    inset: -6px; filter: blur(10px); }
    20%  { opacity: 0.95; inset: -5px; filter: blur(9px); }
    100% { opacity: 0.55; inset: -2px; filter: blur(7px); }
}
@media (prefers-reduced-motion: reduce) {
    #menu .nav-tile:not(.right) .nav-item.active,
    #menu .nav-tile:not(.right) .nav-item.active:after { animation: none; }
}
#menu .nav-tile:not(.right) .nav-item.active a {
    color: #ffffff;
    font-weight: 600;
}
#menu .nav-tile:not(.right) .nav-item:after {
    display: none;
}
#menu .nav-tile:not(.right) .nav-item.active:after {
    content: "";
    display: block;
    position: absolute;
    inset: -2px;
    z-index: -2;
    animation: bongit-tab-halo-dim 1.4s cubic-bezier(0.4, 0, 0.2, 1);
    width: auto;
    height: auto;
    margin: 0;
    transform: none;
    border-radius: var(--pill);
    background: var(--bongit-gradient);
    filter: blur(7px);
    opacity: 0.55;
    box-shadow: none;
}

/* Footer: frosted, with the gradient hairline along the top edge */
#footer {
    background: rgba(251, 249, 244, 0.605);
    -webkit-backdrop-filter: var(--glass-filter);
    backdrop-filter: var(--glass-filter);
    border-top: 1px solid transparent;
    border-image: var(--bongit-gradient) 1;
}


/* ===== Dialogs (update log, plugin installs, confirmations) ===== */

/* background-image: none matters here.  jQuery UI's stock overlay also paints a 100px-tall
   grey image strip (ui-bg_flat_0_aaaaaa_40x100.png, repeat-x, centred), so overriding only
   the colour left a grey band across the screen behind File Manager dialogs (Delete, Copy...). */
.sweet-overlay,
.ui-widget-overlay {
    background-color: rgba(252, 249, 245, 0.495) !important;
    background-image: none !important;
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
}
.sweet-alert,
.ui-dialog {
    background: var(--glass-tint-strong) !important;
    -webkit-backdrop-filter: blur(32px) saturate(180%);
    backdrop-filter: blur(32px) saturate(180%);
    border: 0 !important;
    border-radius: var(--r-xl) !important;
    box-shadow: var(--glass-shine), 0 30px 80px -20px rgba(26, 58, 67, 0.383), 0 0 60px -20px rgba(51, 109, 125, 0.3) !important;
}
.ui-dialog .ui-widget-content,
.ui-dialog .ui-dialog-titlebar,
.ui-dialog .ui-dialog-buttonpane {
    background: transparent !important;
    border-color: var(--glass-edge) !important;
}
/* Dialog buttons (File Manager's Start / Queue / Cancel): Unraid styles these with its own
   nested rule (orange outline, ALL CAPS, wide letter spacing), which is more specific than
   the theme's general button rule, so they stayed orange.  This matches them to every other
   button in the theme.  CSS can't tell a Delete dialog from a Copy one (only the text
   differs), so Start stays the normal violet rather than rose. */
body .ui-dialog .ui-dialog-buttonpane .ui-dialog-buttonset button:not(.unapi *) {
    color: var(--button-text-color);
    background: var(--button-background);
    background-size: var(--button-background-size);
    border-radius: var(--pill);
    padding: var(--sp-2) var(--sp-5);
    font-family: var(--bongit-font);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-transform: capitalize;
    box-shadow: var(--pill-edge);
}
body .ui-dialog .ui-dialog-buttonpane .ui-dialog-buttonset button:not(.unapi *):is(:hover, :focus-visible):not([disabled]) {
    color: var(--hover-button-text-color);
    background: var(--hover-button-background);
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.3),
        0 0 0 1px rgba(51, 109, 125, 0.36),
        -8px 0 18px -6px rgba(48, 110, 126, 0.35),
        8px 0 18px -6px rgba(235, 0, 1, 0.35);
}
body .ui-dialog .ui-dialog-buttonpane .ui-dialog-buttonset button[disabled]:not(.unapi *) {
    background: rgba(248, 243, 233, 0.495);
    color: var(--bongit-text-dim);
    box-shadow: inset 0 0 0 1px var(--hairline);
    cursor: not-allowed;
}
/* Titlebar button (File Manager's Minimize, or Expand / Compress in the file editor).
   Unraid draws it 86px wide and nudges it 20px up past the titlebar; the theme's pill rim
   then outlined that stretched box, and the minimize glyph sat at the bottom of it like an
   underscore.  Now it's a round glass icon button, centred in the titlebar.  No !important
   on display: the Jobs dialog hides this button with an inline display:none, which must win. */
body .ui-dialog .ui-dialog-titlebar .ui-dialog-titlebar-close:not(.unapi *) {
    display: grid;
    place-items: center;
    width: 28px !important;
    min-width: 0 !important;   /* Unraid gives every button min-width: 86px, which kept it an oval */
    height: 28px !important;
    top: 50% !important;
    right: var(--sp-3) !important;
    margin: -14px 0 0 0 !important;
    padding: 0 !important;
    border-radius: 50%;
    color: var(--bongit-text);
    background: var(--button-background);
    box-shadow: var(--pill-edge);
}
/* Violet fill on hover only.  jQuery UI moves focus into the dialog when it opens, and
   Safari can count that as keyboard focus, which lit the button up violet before you'd
   touched it.  Keyboard focus still gets the violet ring, just not the fill. */
body .ui-dialog .ui-dialog-titlebar .ui-dialog-titlebar-close:not(.unapi *):hover {
    color: var(--hover-button-text-color);
    background: var(--hover-button-background);
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.3),
        0 0 0 1px rgba(51, 109, 125, 0.36),
        -8px 0 18px -6px rgba(48, 110, 126, 0.35),
        8px 0 18px -6px rgba(235, 0, 1, 0.35);
}
body .ui-dialog .ui-dialog-titlebar .ui-dialog-titlebar-close:not(.unapi *):focus-visible:not(:hover) {
    box-shadow: var(--pill-edge), 0 0 0 1px rgba(51, 109, 125, 0.36);
}
body .ui-dialog .ui-dialog-titlebar .ui-dialog-titlebar-close i.fa {
    font-size: 12px;
    line-height: 1;
}
/* The minimize glyph is drawn at the bottom of its box; a centred minus reads the same
   and sits in the middle of the circle */
body .ui-dialog .ui-dialog-titlebar .ui-dialog-titlebar-close i.fa-window-minimize::before {
    content: "\f068";   /* FontAwesome 4 fa-minus */
}

/* ===== File Manager: the Age switch =====
   Unraid's own control is a bare toggle icon (always shown "off") beside the "file type"
   filter.  Clicking it swaps the Last Modified column between dates and ages ("4 months
   ago"); the only label is a hover tooltip.  This turns the icon into a labelled switch.
   The icon itself becomes the track, ::before the knob, ::after the "Age" label.
   On/off comes from the table: Unraid hides whichever column text isn't in use with an
   inline display:none, so when an age span is NOT hidden, ages are showing.  (In an empty
   folder there's nothing to read, so the switch shows off; it has no effect there anyway.) */
body .title .right > i.fa-toggle-off[onclick^="toggleTime"] {
    position: relative;
    display: inline-block;
    width: 38px;
    height: 22px;
    margin-left: 44px;   /* room for the "Age" label on its left (px: ch would measure the icon font) */
    vertical-align: middle;
    border-radius: var(--pill);
    background-color: rgba(255, 255, 255, 0.14);
    box-shadow: inset 0 1px 2px rgba(26, 58, 67, 0.203);
    transition: background-color 0.2s;
}
body .title .right > i.fa-toggle-off[onclick^="toggleTime"]::before {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 1px 3px rgba(26, 58, 67, 0.225);
    transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
}
body .title .right > i.fa-toggle-off[onclick^="toggleTime"]::after {
    content: "Age";
    position: absolute;
    top: 50%;
    right: calc(100% + var(--sp-2));
    transform: translateY(-50%);
    font-family: var(--bongit-font);
    font-size: 1.3rem;
    font-weight: 400;
    line-height: 1;
    color: var(--bongit-text);
    white-space: nowrap;
}
@media (prefers-reduced-motion: reduce) {
    body .title .right > i.fa-toggle-off[onclick^="toggleTime"],
    body .title .right > i.fa-toggle-off[onclick^="toggleTime"]::before {
        transition: none;
    }
}
.sweet-alert h2,
.sweet-alert p {
    color: var(--bongit-text);
}
/* Modal headers (System Info, the Release Notes title + its section headers, the update
   log window, confirmations): the holographic shimmer, no grey strip.  These dialogs share
   the SAME pre#swalbody for their body (the release notes render into it just like the live
   log does), so there's no reliable class to single out the log window - and its title looks
   just as good shimmering.  So every sweet-alert header gets one treatment, and the old
   gradient strip + bottom hairline (the "boxy bar") is gone.  Scoped with .nchan to match the
   specificity that was proven to win over Unraid's own header rules. */
/* Modal headers get the SAME glass pill as the main-page section headers (body div.title):
   a glass-tint capsule with the pill sheen and edge, shimmer text inside.  The pill sits on a
   ::before so it reads as a capsule behind the text while the text itself stays clipped to the
   shimmer gradient (div.title can put the two on parent + child; a heading can't, so ::before
   carries the capsule). */
/* Shimmer text on a capsule styled like the main menu's.
   Why it used to look "ghosted": the shimmer IS the heading's own background,
   clipped to the letters, and the capsule is a ::before at z-index -1.  The heading also had
   z-index: 0, which made it its own stacking layer, so the -1 capsule painted INSIDE it, on
   top of its background, i.e. over the text.  With no z-index on the heading, the capsule
   drops to the dialog's layer instead: above the dialog's background, below the heading. */
.sweet-alert.nchan h1,
.sweet-alert.nchan h2,
.sweet-alert.nchan h3 {
    position: relative;
    margin: var(--sp-3) 0 var(--sp-4);
    padding: 10px var(--inset);
    background: linear-gradient(90deg, #285866, #285866);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    font-weight: 600;
    box-shadow: none;
    animation: bongit-sheen 14s linear infinite;
}
.sweet-alert.nchan h1::before,
.sweet-alert.nchan h2::before,
.sweet-alert.nchan h3::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: var(--pill);
    background: rgba(250, 247, 241, 0.682);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14), inset 0 0 0 1px rgba(38, 85, 98, 0.2);
}
/* Concentric corners on the log window: the title stays a pill with the same gap on all four
   sides (top, left, right, and down to the log), and the window's corner radius is the pill's
   radius plus that gap, so the two curves run parallel.
   The maths (measured on Unraid 7.3.4):
     - the window has 20px of padding; a margin of (gap - 20px) sets the gap around the pill
     - the pill is 56px tall (36px line + 10px padding top and bottom), so its radius is 28px
     - window radius = 28px + gap (only on these log windows; other pop-ups keep 28px) */
.sweet-alert.nchan {
    --bongit-title-gap: 12px;
    border-radius: calc(28px + var(--bongit-title-gap)) !important;
}
.sweet-alert.nchan > h2 {
    margin: calc(var(--bongit-title-gap) - 20px) calc(var(--bongit-title-gap) - 20px) var(--bongit-title-gap);
    line-height: 36px;
    padding-top: 10px;
    padding-bottom: 10px;
}
/* The log box lines up with the title pill: Unraid stretches the <p> that holds the log edge
   to edge with a -20px margin (to cancel the window's 20px padding); this pulls it back in to
   the same gap as the pill, and rounds its corners to the pill's 28px so the two read as a set. */
body .sweet-alert.nchan > p {
    margin-left: calc(var(--bongit-title-gap) - 20px);
    margin-right: calc(var(--bongit-title-gap) - 20px);
}
body .sweet-alert.nchan > p > pre:is(#swaltext, #swalbody) {
    border-radius: 28px;
}
/* Release notes open with no button (Unraid shows it a moment later), and sweetalert adds 40px
   of bottom padding to button-less pop-ups, so Done sat higher than in the log windows.  Back
   to the window's normal 20px so every log-style window ends the same way. */
body .sweet-alert.nchan[data-has-confirm-button="false"][data-has-cancel-button="false"] {
    padding-bottom: 20px;
}
/* Version headers inside the release notes: Unraid zeroes the padding and margins of headings
   inside the notes (with an ID selector, which beats the pill rule above), which squashed each
   pill into a thin rail through the text.  Same ID here, so they get their room back. */
body .sweet-alert.nchan pre#swalbody :is(h1, h2, h3) {
    margin: var(--sp-4) 0 var(--sp-3);
    padding: 6px var(--sp-4);
    line-height: 1.4;
}
@media (prefers-reduced-motion: reduce) {
    .sweet-alert.nchan h1,
    .sweet-alert.nchan h2,
    .sweet-alert.nchan h3 { animation: none; }
}
/* The log itself sits in a darker inset well so it stays easy to read */
.sweet-alert pre#swaltext,
.sweet-alert pre#swalbody {
    background: rgba(26, 58, 67, 0.248);
    border-radius: var(--bongit-radius);
    box-shadow: inset 0 1px 6px rgba(26, 58, 67, 0.27), inset 0 0 0 1px rgba(48, 107, 123, 0.08);
}

/* ===== GUI search autocomplete (the header search-box dropdown) ===== */
/* Unraid's search is powered by Awesomplete: a bare <ul id="awesomplete_list_N"> of
   <li role="option"> rows, with the typed match wrapped in <mark>.  Out of the box the
   list is transparent (the dark page just shows through), the selected row is Awesomplete's
   flat blue (rgb 59,89,152) and <mark> is browser-yellow.  Dress it as a glass sheet with
   violet pill rows, matching the <select> menus.  Targeted by the id prefix (stable; the
   trailing number increments) so it works regardless of the .awesomplete wrapper. */
ul[id^="awesomplete_list_"] {
    margin-top: var(--sp-2);
    padding: var(--sp-2);
    background: var(--glass-tint-strong);
    -webkit-backdrop-filter: var(--glass-filter);
    backdrop-filter: var(--glass-filter);
    border: 1px solid var(--glass-edge);
    border-radius: var(--r-md);
    box-shadow: var(--glass-shine), var(--glass-drop);
}
/* Awesomplete draws a small pointer triangle above the list; drop it for a clean sheet */
ul[id^="awesomplete_list_"]::before {
    display: none;
}
ul[id^="awesomplete_list_"] > li {
    padding: var(--sp-2) var(--sp-3);
    border-radius: calc(var(--r-md) - 1px - var(--sp-2));   /* concentric: list radius minus its border and padding */
    color: var(--bongit-text);
    background: transparent;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
}
/* Hover and the keyboard-selected row (aria-selected) both get the violet pill */
ul[id^="awesomplete_list_"] > li:hover,
ul[id^="awesomplete_list_"] > li[aria-selected="true"] {
    background: linear-gradient(180deg, rgba(55, 118, 136, 0.33), rgba(51, 109, 125, 0.18));
    color: #ffffff;
}
/* The typed match: a soft violet highlight pill (not Awesomplete's yellow, not a neon swap).
   On the active violet-pill row it shifts to a frosted white so it still reads. */
ul[id^="awesomplete_list_"] mark {
    background: rgba(51, 109, 125, 0.21);
    color: #ffffff;
    border-radius: 4px;
    padding: 0 2px;
    font-weight: 600;
}
ul[id^="awesomplete_list_"] > li:hover mark,
ul[id^="awesomplete_list_"] > li[aria-selected="true"] mark {
    background: rgba(255, 255, 255, 0.28);
    color: #ffffff;
}

/* The Apps-page search uses the same Awesomplete widget, but Community Applications
   ships its own stylesheet with a solid-white `.awesomplete > ul` (and a white pointer
   triangle).  That rule ties the one above on specificity, so on the Apps page CA wins
   and the dropdown comes out white.  Override `.awesomplete > ul` directly: the `body`
   prefix lifts specificity past CA's, so the same glass sheet lands on both searches. */
body .awesomplete > ul {
    margin: var(--sp-2) 0 0;
    padding: var(--sp-2);
    background: var(--glass-tint-strong);
    background-image: none;
    -webkit-backdrop-filter: var(--glass-filter);
    backdrop-filter: var(--glass-filter);
    border: 1px solid var(--glass-edge);
    border-radius: var(--r-md);
    box-shadow: var(--glass-shine), var(--glass-drop);
    text-shadow: none;
}
body .awesomplete > ul::before {
    display: none;            /* CA's white pointer triangle */
}
body .awesomplete > ul > li {
    padding: var(--sp-2) var(--sp-3);
    border-radius: calc(var(--r-md) - 1px - var(--sp-2));   /* concentric: list radius minus its border and padding */
    color: var(--bongit-text);
    background: transparent;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
}
body .awesomplete > ul > li:hover,
body .awesomplete > ul > li[aria-selected="true"] {
    background: linear-gradient(180deg, rgba(55, 118, 136, 0.33), rgba(51, 109, 125, 0.18));
    color: #ffffff;
}
body .awesomplete mark {
    background: rgba(51, 109, 125, 0.21);
    color: #ffffff;
    border-radius: 4px;
    padding: 0 2px;
    font-weight: 600;
}
body .awesomplete > ul > li:hover mark,
body .awesomplete > ul > li[aria-selected="true"] mark {
    background: rgba(255, 255, 255, 0.28);
    color: #ffffff;
}


/* ===== Controls: Apple-style pills with a Siri-style glow ===== */

/*
 * The glow: a violet ring with cyan bleeding out on the left and pink on the
 * right, which slowly trade places while a field has focus, like the edge glow
 * when Siri is listening.  Browsers can't put a glow on the text cursor itself,
 * so the cursor is tinted lavender and the field around it does the glowing.
 */
@keyframes bongit-siri {
    0%, 100% {
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.16),
            0 0 0 1px rgba(51, 109, 125, 0.36),
            -8px 0 18px -6px rgba(48, 110, 126, 0.385),
            8px 0 18px -6px rgba(235, 0, 1, 0.385),
            0 0 24px -8px rgba(51, 109, 125, 0.48);
    }
    50% {
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.16),
            0 0 0 1px rgba(51, 109, 125, 0.36),
            -8px 0 18px -6px rgba(235, 0, 1, 0.385),
            8px 0 18px -6px rgba(48, 110, 126, 0.385),
            0 0 24px -8px rgba(51, 109, 125, 0.48);
    }
}

/* Buttons: sentence-case glass pills; hover fills violet and lights the glow */
body input[type="button"]:not(.unapi *),
body input[type="reset"]:not(.unapi *),
body input[type="submit"]:not(.unapi *),
body button:not(.unapi *),
body a.button:not(.unapi *) {
    border-radius: var(--pill);
    text-transform: capitalize;    /* "add-folder" -> "Add-folder"; Unraid's own labels are already Title Case */
    letter-spacing: 0.01em;
    font-size: 1.25rem;
    font-weight: 600;
    box-shadow: var(--pill-edge);
    transition: box-shadow 0.25s, background 0.25s;
}
body input[type="button"]:not(.unapi *):hover,
body input[type="submit"]:not(.unapi *):hover,
body button:not(.unapi *):hover,
body a.button:not(.unapi *):hover,
body input[type="button"]:not(.unapi *):focus-visible,
body input[type="submit"]:not(.unapi *):focus-visible,
body button:not(.unapi *):focus-visible,
body a.button:not(.unapi *):focus-visible {
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.3),
        0 0 0 1px rgba(51, 109, 125, 0.36),
        -8px 0 18px -6px rgba(48, 110, 126, 0.35),
        8px 0 18px -6px rgba(235, 0, 1, 0.35);
}
body input[type="button"][disabled]:not(.unapi *),
body input[type="reset"][disabled]:not(.unapi *),
body input[type="submit"][disabled]:not(.unapi *),
body button[disabled]:not(.unapi *),
body a.button[disabled]:not(.unapi *) {
    background: rgba(248, 243, 233, 0.495);
    color: var(--bongit-text-dim);
    box-shadow: inset 0 0 0 1px var(--hairline);
    cursor: not-allowed;
}

/* The menu-bar search box: Unraid gives it a solid grey background with an ID rule,
   which showed through the glass as pale lavender; this matches it to the other fields */
body #guiSearchBox {
    background-color: rgba(252, 249, 245, 0.495);
    color: var(--bongit-text);
    caret-color: #295c6a;
}

/* Text fields and dropdowns: Spotlight-style pills instead of Unraid's underline */
body input[type="text"]:not(.unapi *),
body input[type="password"]:not(.unapi *),
body input[type="number"]:not(.unapi *),
body input[type="url"]:not(.unapi *),
body input[type="email"]:not(.unapi *),
body select:not(.unapi *) {
    border: 0;
    border-radius: var(--pill);
    background-color: rgba(252, 249, 245, 0.495);
    box-shadow: var(--pill-edge);
    caret-color: #295c6a;
    transition: box-shadow 0.25s;
}
/* Text fields get a recessed "well" instead of the raised pill sheen, so they read as a
   type-able input, clearly distinct from the pill buttons and the dropdowns (which stay
   pills).  Rounded-rectangle, darker inset, soft inner shadow. */
body input[type="text"]:not(.unapi *),
body input[type="password"]:not(.unapi *),
body input[type="number"]:not(.unapi *),
body input[type="url"]:not(.unapi *),
body input[type="email"]:not(.unapi *) {
    border-radius: var(--r-sm);
    background-image: none;
    background-color: rgba(252, 249, 245, 0.66);
    box-shadow: inset 0 1px 3px rgba(26, 58, 67, 0.225), inset 0 0 0 1px var(--hairline);
}
/* Unraid draws the dropdown arrow with two background gradients; pull it in from the curved
   edge.  Every select (Shares' SMB filter, Settings menus, plugin selects) gets the same
   room on both sides and a consistent minimum height, so they all read as one control. */
body select:not(.unapi *) {
    background-position: calc(100% - 16px), calc(100% - 12px);
    padding: 2px 2.6rem 2px var(--sp-3);
    min-height: 2.4rem;
}
/* Dashboard graph timeframe pickers (#cpuline, #netline): DashStats.css sets an
   ID-level padding of 0 12px 0 0 that beat the theme and jammed the value against
   the pill's left curve, so these two need the padding restated at ID weight to win. */
body select#cpuline:not(.unapi *),
body select#netline:not(.unapi *) {
    padding: 2px 2.4rem 2px var(--sp-3);
}
/* Multi-line boxes: a dark glass well.  !important because many plugins write
   background: #111 / border: #444 straight onto their textareas, which would
   otherwise win and leave a flat grey box. */
body textarea:not(.unapi *) {
    border: 0 !important;
    border-radius: var(--r-md);
    background: rgba(249, 246, 238, 0.66) !important;
    color: var(--bongit-text) !important;
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.08),
        inset 0 0 0 1px rgba(38, 85, 98, 0.2),
        inset 0 2px 10px rgba(26, 58, 67, 0.158);
    caret-color: #295c6a;
}
/* Code and log blocks: the same well instead of Unraid's grey outline */
body pre:not(.unapi *) {
    border: 0;
    border-radius: var(--r-sm);
    background: rgba(252, 249, 245, 0.495);
    box-shadow: inset 0 0 0 1px var(--hairline);
}
body input[type="text"]:not(.unapi *):focus,
body input[type="password"]:not(.unapi *):focus,
body input[type="number"]:not(.unapi *):focus,
body input[type="url"]:not(.unapi *):focus,
body input[type="email"]:not(.unapi *):focus,
body select:not(.unapi *):focus,
body textarea:not(.unapi *):focus {
    outline: none;
    animation: bongit-siri 4s ease-in-out infinite;
}

/* Toggle switches (autostart, "All Apps"): macOS-style pills, violet when on */
body .switch-button-background {
    background-color: rgba(255, 255, 255, 0.14);
    border: 0;
    border-radius: var(--pill);
    box-shadow: inset 0 1px 2px rgba(26, 58, 67, 0.203);
}
body .switch-button-background.checked {
    background-color: var(--bongit-violet);
}
body .switch-button-button {
    top: 0;
    background-color: #ffffff;
    border: 0;
    border-radius: 50%;
    box-shadow: 0 1px 3px rgba(26, 58, 67, 0.225);
}
body .switch-button-label {
    text-transform: none;
    letter-spacing: 0.01em;
}
body .switch-button-label.on {
    color: #295c6a;
}

/* Dropdown menus: browsers with customisable selects get a glass menu with a violet
   highlight.  Chrome/Edge render it fully frosted.  Safari supports base-select and
   ::picker but does not composite backdrop-filter in the popup's top layer, so there it
   falls back to a dark translucent panel (still on-brand, just without the live blur).
   Browsers without base-select use their native menu unchanged. */
@supports (appearance: base-select) {
    body select:not(.unapi *),
    body select:not(.unapi *)::picker(select) {
        appearance: base-select;
    }
    body select:not(.unapi *)::picker-icon {
        display: none;          /* Unraid already draws its own arrow */
    }
    body select:not(.unapi *)::picker(select) {
        padding: 6px;
        border: 0;
        border-radius: 16px;
        /* Dark glass: Safari paints the colour but not backdrop-filter in the popup's
           top layer, so the tint is kept dark enough to read as glass on its own; the
           bright rim and top highlight do the "glass" work there, and Chrome/Edge add
           the real frost on top. */
        background: rgba(251, 249, 244, 0.858);
        -webkit-backdrop-filter: blur(28px) saturate(120%);
        backdrop-filter: blur(28px) saturate(120%);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2), inset 0 0 0 1px rgba(38, 85, 98, 0.28), 0 20px 50px -15px rgba(26, 58, 67, 0.383);
    }
    /* Items: rounded violet pills, violet hover and a filled current item */
    body select:not(.unapi *) option {
        min-height: 0;
        margin: 2px;
        padding: 6px 14px;
        line-height: 1.5;
        text-align: left;
        border-radius: 8px;   /* concentric: picker 16px minus 6px padding and 2px margin */
        color: var(--bongit-text);
        background: transparent;
        outline: none;
    }
    body select:not(.unapi *) option:hover,
    body select:not(.unapi *) option:focus-visible {
        color: #ffffff;
        background: rgba(51, 109, 125, 0.27);
        outline: none;
    }
    body select:not(.unapi *) option:checked {
        background: rgba(51, 109, 125, 0.18);
        font-weight: 600;
    }
    body select:not(.unapi *) option::checkmark {
        color: #295c6a;
    }
}

/* Capacity bars: pill track and pill fill; plain bars get the accent gradient */
body .usage-disk,
body .usage-disk > span:first-child,
body .usage-bar,
body .usage-bar > span {
    border-radius: var(--pill);
}
.usage-bar > span:not([class]) {
    background: var(--bongit-gradient);
}

/* Loading animation (the bouncing Unraid bars): an inline SVG whose nine bars share
   a two-stop orange gradient.  CSS can't add a third stop, so each bar gets its own
   colour instead, stepping cyan -> violet -> pink from left to right. */
/* (No glow filter here: Safari clips a filtered SVG to its resting box, which
   chopped the bouncing bars into pieces.) */
svg.unraid_mark .unraid_mark_1 { fill: #306e7e; }
svg.unraid_mark .unraid_mark_2 { fill: #306e7e; }
svg.unraid_mark .unraid_mark_3 { fill: #306776; }
svg.unraid_mark .unraid_mark_4 { fill: #336d7e; }
svg.unraid_mark .unraid_mark_5 { fill: #336d7d; }
svg.unraid_mark .unraid_mark_6 { fill: #306675; }
svg.unraid_mark .unraid_mark_7 { fill: #2d5f6d; }
svg.unraid_mark .unraid_mark_8 { fill: #eb0001; }
svg.unraid_mark .unraid_mark_9 { fill: #eb0001; }

/* Links: a light violet from the brand palette instead of Unraid's fixed dark blue
   (--blue-800), which was hard to read on violet and read as "off" next to the theme.
   :visited is claimed too, so pages you've already opened no longer fall through to the
   browser's leftover purple.  Same low specificity as Unraid's own rule, so menu items
   and other styled links keep their colours.  Order follows LVHA so hover still wins. */
a {
    color: var(--link-text-color);
}
a:visited {
    color: var(--link-visited-color);
}
a:hover {
    color: #ffffff;
    text-shadow: 0 0 8px rgba(55, 118, 136, 0.42);
}
::selection {
    color: #ffffff;
    background: rgba(51, 109, 125, 0.33);
}

/* Tooltips: a small frosted pill with no arrow, like macOS */
.tooltipster-sidetip .tooltipster-box {
    background: rgba(250, 247, 241, 0.902);
    -webkit-backdrop-filter: blur(20px) saturate(170%);
    backdrop-filter: blur(20px) saturate(170%);
    border: 0 !important;      /* Unraid adds a 3px orange edge per tooltip direction */
    border-radius: var(--r-sm);
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.12),
        inset 0 0 0 1px rgba(38, 85, 98, 0.18),
        0 8px 24px -8px rgba(26, 58, 67, 0.315);
}
.tooltipster-sidetip .tooltipster-content {
    color: var(--bongit-text);
    padding: var(--sp-2) var(--sp-3);
}
.tooltipster-sidetip .tooltipster-arrow {
    display: none;
}

/* Docker / VM folder boxes, tabs, tooltips and shaded panels */
body .folder-preview {
    border-radius: var(--bongit-radius);
}
/* Page tabs (Plugins, Docker, VMs and other sub-pages): the tabs sit in one glass capsule,
   the same segmented control as the main nav, with the current tab a raised violet pill.
   The action buttons Unraid appends to the row (Check For Updates, Update All ...) are
   lifted out of the capsule and pinned to the far right. */
body nav.tabs {
    position: relative;
    border: 0;
    overflow: visible;   /* see .tabs-container: no scroll bars from the press glow */
}
/* Built to match the main menu capsule exactly (#menu .nav-tile:not(.right)): the same
   near-opaque deep-violet fill and crisp rim (the old 5% white fill read as ghosted),
   the same tab type (no button letter-spacing, weight 500, full opacity), and the same
   raised active pill with the soft gradient glow behind it. */
body .tabs-container {
    /* Unraid makes this row scrollable; the glow around a pressed tab reached past the edge
       and summoned scroll bars.  It's a single short row, so nothing needs to scroll. */
    overflow: visible;
    display: inline-flex;
    width: max-content;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: var(--pill);
    background: rgba(250, 247, 241, 0.682);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14), inset 0 0 0 1px rgba(38, 85, 98, 0.2);
    isolation: isolate;     /* keeps the active tab's glow behind the tab but inside the capsule */
}
body .tabs button[role="tab"] {
    position: relative;
    border: 0;
    border-radius: var(--pill);
    padding: 6px var(--sp-4);
    margin: 0;
    background: transparent;
    box-shadow: none;
    color: #323f42;
    font-weight: 500;
    letter-spacing: normal;
    text-transform: none;
    line-height: 2rem;
    opacity: 1;
    transition: background 0.2s, color 0.2s, box-shadow 0.25s, transform 0.12s ease-out;
}
body .tabs button[role="tab"] :is(i, span) {
    color: inherit;
    opacity: 1;
}
body .tabs button[role="tab"]:hover {
    background: rgba(255, 255, 255, 0.07);
    color: #ffffff;
}
/* Selected tab: the same three fixed layers and backlit fade as the main menu (see the
   long note at #menu ... .nav-item.active): the button is its own isolated layer with no
   background, the violet pill is ::before (z -1), the gradient halo ::after (z -2).
   Pressing shows full glow; when the tab becomes selected the halo dims to the backlight.
   Tabs switch in place, so here the browser plays it all in one go. */
body .tabs button[role="tab"]:is([aria-selected="true"], :active) {
    isolation: isolate;
    background: none;
    box-shadow: none;
    color: #ffffff;
    /* "Bold" drawn with a hairline stroke instead of font-weight, so the label never gets
       wider: a wider label resized the capsule and pushed the pill off-centre. */
    font-weight: 500;
    -webkit-text-stroke: 0.35px currentColor;
}
body .tabs button[role="tab"]:is([aria-selected="true"], :active)::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: var(--pill);
    background: linear-gradient(180deg, #b9c5c8, #c7d0d3);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), inset 0 0 0 1px rgba(38, 85, 98, 0.32);
    pointer-events: none;
}
body .tabs button[role="tab"]:is([aria-selected="true"], :active)::after {
    content: "";
    position: absolute;
    inset: -2px;
    z-index: -2;
    border-radius: var(--pill);
    background: var(--bongit-gradient);
    filter: blur(7px);
    opacity: 0.55;
    pointer-events: none;
}
body .tabs button[role="tab"][aria-selected="true"]::after {
    animation: bongit-tab-halo-dim 1.4s cubic-bezier(0.4, 0, 0.2, 1);
}
body .tabs button[role="tab"][aria-selected="true"] {
    animation: bongit-tab-press-out 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
}
/* While pressed: the first frame of the fade (pressed in, full-strength halo) */
body .tabs button[role="tab"]:active {
    transform: scale(0.94);
}
body .tabs button[role="tab"]:active::after {
    inset: -6px;
    filter: blur(10px);
    opacity: 1;
    animation: none;
}
@media (prefers-reduced-motion: reduce) {
    body .tabs button[role="tab"][aria-selected="true"],
    body .tabs button[role="tab"][aria-selected="true"]::after { animation: none; }
}
/* Action buttons: out of the capsule (absolute, so they don't widen it), pinned right */
body .tabs-container #checkall,
body .tabs-container #updateall,
body .tabs-container #removeall {
    position: absolute;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    margin: 0;
}
body .shade,
body a.info span,
body .clipboard-tooltip {
    border-radius: var(--bongit-radius-small);
}

/* ---- Plugins page table ---- */
/* Headers: sentence case + dim, matching the other tables (these are <th> with a
   .tablesorter-header-inner wrapper the generic <td> rule never reached).  tablesorter
   darkens the *sorted* columns (Plugin, Status) with a per-cell background of its own,
   which made those two look different from the rest; !important clears that highlight so
   every header is uniform, like the Main page.  (Its two-class selector outweighs ours.) */
body table.tablesorter thead th,
body table.tablesorter thead th.tablesorter-headerAsc,
body table.tablesorter thead th.tablesorter-headerDesc {
    text-transform: none;
    letter-spacing: 0.01em;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--bongit-text-dim);
    background: transparent !important;
    padding-top: var(--sp-2);
    padding-bottom: var(--sp-2);
    vertical-align: middle;
}
/* Row icons in list tables (plugins, device links, ...): a consistent near-white, so they
   match across every page instead of inheriting the violet link colour inside <a> wrappers.
   Image logos keep their own colours; status dots aren't .list so they stay too. */
body i.list {
    color: var(--bongit-text);
}
/* Plugin names sit in full theme text, not the dimmer body colour */
body table.plugins .desc_readmore h4,
body table.plugins .desc_readmore strong {
    color: var(--bongit-text);
}


/*
 * ---- Status colours ----
 * Replaces Unraid's green / orange / red with softer versions that sit
 * with the bongIT palette: mint, amber and rose, with periwinkle links.
 * Change the values below to retune everything in this section.
 */
html:root {
    --bongit-ok: #1d8b4b;
    --bongit-attention: #b9770e;
    --bongit-problem: #eb0001;

    --bongit-bar-ok: linear-gradient(90deg, #1d8b4b 0, #1d8b4b 70%, #1d8b4b 100%);
    --bongit-bar-attention: linear-gradient(90deg, #b9770e 0, #b9770e 70%, #b9770e 100%);
    --bongit-bar-problem: linear-gradient(90deg, #eb0001 0, #eb0001 70%, #eb0001 100%);
    --bongit-bar-ink: #efe9dc;
}

/* Status text and icons: started / stopped, "up-to-date", "update ready", container names with an update, errors */
/* Unraid's palette status colours (status dots, "Parity is valid", share dots, and more) */
html:root {
    --green-200: #1d8b4b;
    --green-500: #1d8b4b;
    --green-800: #1d8b4b;
    --green-900: #1d8b4b;
    --orange-300: #b9770e;
    --red-500: #eb0001;
    --red-600: #eb0001;
    --red-700: #eb0001;
    --red-800: #eb0001;
}
html:root .unapi,
html:root .unapi.dark {
    --color-unraid-red: #eb0001;    /* bell alert dot and error text in the newer components */
}

/* The dashboard script writes one of three fixed colours straight onto load figures
   (CPU %, donut %): #4f8a10 normal, #e68a00 warning, #f0000c critical.  Match them
   and swap in the theme's mint / amber / rose.  The rings themselves are a single
   script-drawn gradient, which CSS can't recolour. */
body [style*="color: rgb(79, 138, 16)"] { color: var(--bongit-ok) !important; }
body [style*="color: rgb(230, 138, 0)"] { color: var(--bongit-attention) !important; }
body [style*="color: rgb(240, 0, 12)"] { color: var(--bongit-problem) !important; }

body .green-text,
body .passed {
    color: var(--bongit-ok);
}
body .orange-text,
body .warning {
    color: var(--bongit-attention);
}
body .red-text,
body .failed {
    color: var(--bongit-problem);
}

/* Capacity bars on Main, Shares and Dashboard, and the array usage bar in the header */
body .greenbar {
    background: var(--bongit-bar-ok);
}
body .orangebar {
    background: var(--bongit-bar-attention);
}
body .redbar {
    background: var(--bongit-bar-problem);
}
/* A soft glow in each bar's own colour */
body .greenbar { box-shadow: 0 0 8px rgba(29, 139, 75, 0.45); }
body .orangebar { box-shadow: 0 0 8px rgba(185, 119, 14, 0.45); }
body .redbar { box-shadow: 0 0 8px rgba(235, 0, 1, 0.315); }
body .green-text, body .passed, body .green { text-shadow: 0 0 6px rgba(29, 139, 75, 0.3); }
body .orange-text, body .warning { text-shadow: 0 0 6px rgba(185, 119, 14, 0.3); }
body .red-text, body .failed { text-shadow: 0 0 6px rgba(235, 0, 1, 0.21); }
/* The header bar prints its percentage on top of the fill; white is unreadable on mint and amber */
body .usage-bar > span.greenbar,
body .usage-bar > span.orangebar {
    color: var(--bongit-bar-ink);
}
/* Disk bars print the size across the fill and the empty track, so it gets a dark halo instead.
   The label is pinned to the bar's own height: Unraid nudged it up by a fixed amount
   that assumed its original row height, so taller rows left it sitting low. */
body .usage-disk:not(.sys):not(.mm) > span:last-child:not(:first-child) {
    position: absolute;
    top: 0;
    right: 0;
    line-height: 1.8rem;
}
body .usage-disk > span:last-child {
    text-shadow: 0 1px 1px var(--bongit-bar-ink), 0 0 3px var(--bongit-bar-ink);
}


/*
 * ---- Spacing and wrapping ----
 * Rounded glass clips anything that sits in a corner, so outer cells and bars
 * get extra room.  Table cells keep Unraid's single line with "..." on purpose:
 * wrapping them would make rows uneven and break the column layout.
 */

/* First and last column of every table: clear of the rounded corners */
html body table:not(.unapi *) tr > :is(td, th):first-child {
    padding-left: var(--inset);
}
html body table:not(.unapi *) tr > :is(td, th):last-child {
    padding-right: var(--inset);
}
html body table table:not(.unapi *) tr > :is(td, th):first-child,
html body table table:not(.unapi *) tr > :is(td, th):last-child {
    padding-left: var(--sp-2);
    padding-right: var(--sp-2);
}

/* Rows: Unraid packs them at 26px; 32px gives each line room to breathe without
   making the Main page much longer.  Limited to Unraid's standard tables. */
html body table.unraid thead td,
html body table.unraid tbody td {
    height: 3.2rem;
    line-height: 3.2rem;
}

/* Page: wider margins at the window edges and more air between sections than
   between a section's title and its own table, so each section reads as a group */
html body #displaybox {
    padding-top: var(--sp-6);
    padding-right: var(--gutter);
    padding-bottom: var(--sp-12);
}
html:not(.Theme--sidebar) body #displaybox {
    padding-left: var(--gutter);
}
html body div.title {
    margin: var(--sp-8) 0 var(--sp-3);
}
html body div.title:first-of-type,
html body div.title + div.title {
    margin-top: 0;
}

/* Title pills: text clear of the round ends, and long titles or crowded controls wrap instead of overlapping */
body div.title {
    padding: 10px var(--inset);
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-4);
    line-height: 1.4;
}

/* Buttons: pill ends need more side room than square corners did */
body input[type="button"]:not(.unapi *),
body input[type="reset"]:not(.unapi *),
body input[type="submit"]:not(.unapi *),
body button:not(.unapi *),
body a.button:not(.unapi *) {
    padding: var(--sp-2) var(--sp-5);
}

/* Text boxes: text clear of the curved ends */
/* Same priority as Unraid's own input rule (not higher), so plugins that place an
   icon inside a field, like the file manager's "file type" filter, keep their padding */
input:is([type="text"], [type="password"], [type="number"], [type="url"], [type="email"]):where(:not(.unapi *)) {
    padding-left: var(--sp-4);
    padding-right: var(--sp-4);
}
body textarea:not(.unapi *) {
    padding: var(--sp-3) var(--sp-4);
}

/* Footer and menu: keep text off the window edges */
#footer {
    padding: var(--sp-2) var(--gutter);
}

/* Dialogs: centred title with room on both sides; logs and changelogs wrap long lines
   instead of running off the right edge */
.sweet-alert h2 {
    text-align: center;
    padding-left: 2rem;
    padding-right: 2rem;
    overflow-wrap: anywhere;
}
.sweet-alert p {
    overflow-wrap: anywhere;
}
.sweet-alert pre#swaltext,
.sweet-alert pre#swalbody {
    padding: var(--sp-4) var(--sp-5);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
}


/*
 * ---- Reboot / shutdown page (webGui/include/Boot.php) ----
 * That page loads the theme stylesheet but not custom-CSS plugins, so these rules
 * only show up when this file is delivered through the theme stylesheet itself.
 * Its own inline styles load after the theme, hence the "html body" prefix.
 * The aurora moves to <html> and <body> becomes one centred glass card.
 */
html:has(.boot-title) {
    min-height: 100%;
    background-color: var(--bongit-bg);
    background-image:
        radial-gradient(60vw 50vh at 12% 8%, rgba(42, 90, 103, 0.156), transparent 70%),
        radial-gradient(45vw 40vh at 90% 18%, rgba(235, 0, 1, 0.063), transparent 70%),
        radial-gradient(45vw 40vh at 85% 85%, rgba(48, 110, 126, 0.038), transparent 70%),
        radial-gradient(70vw 60vh at 40% 100%, rgba(46, 99, 113, 0.114), transparent 70%);
    background-attachment: fixed;
}
html body:has(> .boot-title) {
    box-sizing: border-box;
    max-width: min(72rem, calc(100% - 3.2rem));
    margin: 14vh auto 0;
    padding: var(--sp-8) var(--sp-6);
    background: var(--glass-tint);
    -webkit-backdrop-filter: var(--glass-filter);
    backdrop-filter: var(--glass-filter);
    border-radius: var(--r-xl);
    box-shadow: var(--glass-shine), var(--glass-drop), 0 0 80px -30px rgba(51, 109, 125, 0.36);
}

/* Squircle corners (smooth, Apple-style) where the browser can draw them: Chrome and Edge
   today, not Safari.  A squircle at the same radius looks noticeably tighter than a normal
   round corner, so the radius is doubled here: that makes the two shapes read almost the same,
   and Safari users and Chrome users see the same tile.  (Same rule as the bongIT UI library's
   --bongit-corner-scale.)  Browsers without squircles skip this whole block. */
@supports (corner-shape: squircle) {
    body table.dashboard > tbody {
        border-radius: calc(var(--glass-radius) * 2);
        corner-shape: squircle;
    }
    body .folder-preview {
        border-radius: calc(var(--bongit-radius) * 2);
        corner-shape: squircle;
    }
    html body:has(> .boot-title) {
        border-radius: calc(var(--r-xl) * 2);
        corner-shape: squircle;
    }
}
/* No pinned background layer here: <html> already paints the aurora, and the card's blur would
   trap that fixed layer inside the card, drawing a bright violet, square-cornered box behind it. */
html body:has(> .boot-title)::before {
    content: none;
}
html body .boot-title {
    margin: 0 0 var(--sp-4);
    font-size: clamp(2.6rem, 5vw, 4rem);
    font-weight: 700;
    text-transform: none;     /* sentence case, matching the rest of the theme */
    letter-spacing: 0.01em;
    overflow-wrap: anywhere;
    background: var(--bongit-gradient);   /* the holographic blobs replace this further down */
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}
html body .boot-subtext {
    margin: var(--sp-2) 0;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    color: var(--bongit-text);
    overflow-wrap: anywhere;
}
html body .boot-subtext .green { color: var(--bongit-ok); }
html body .boot-subtext .orange { color: var(--bongit-attention); }
html body .boot-subtext .red { color: var(--bongit-problem); }
html body .boot-subtext .blue { color: #357283; }


/* Phones: a narrower window gutter so panels keep their width */
@media (max-width: 767px) {
    html:root {
        --gutter: var(--sp-3);
        --inset: var(--sp-4);
    }
}


/*
 * ---- Unraid's newer components (notifications, header menus, toasts) ----
 * These take their colours from one token set on .unapi: an orange "primary"
 * scale and neutral greys.  Swapping the scales restyles all of them at once.
 * Unraid's red (errors) is a separate token and is left alone.
 */
html:root .unapi,
html:root .unapi.dark {
    --ui-color-primary-50: #17343c;
    --ui-color-primary-100: #1a3b44;
    --ui-color-primary-200: #204752;
    --ui-color-primary-300: #295c6a;
    --ui-color-primary-400: #377688;
    --ui-color-primary-500: #336d7d;
    --ui-color-primary-600: #2e6371;
    --ui-color-primary-700: #2a5966;
    --ui-color-primary-800: #254f5b;
    --ui-color-primary-900: #214650;
    --ui-color-primary-950: #e3d7c0;
    --primary: 193 42% 35%;
    --ring: 193 42% 35%;
}
html:root .unapi.dark {
    --ui-color-neutral-700: #c9d2d5;
    --ui-color-neutral-800: #e8dfcc;
    --ui-color-neutral-900: #ede5d6;
    --ui-color-neutral-950: #f1ebdf;
    --background: 40 38% 91%;
    --popover: 40 38% 89%;
    --card: 40 38% 89%;
    --muted: 40 38% 85%;
    --secondary: 40 38% 85%;
    --accent: 40 38% 84%;
    --border: 40 38% 82%;
    --input: 40 38% 82%;
    --color-border: #c9d2d5;
}

/* Toasts ("Action Centre Enabled" and friends): frosted, with a status-coloured edge
   instead of solid yellow / green / red boxes */
html:root [data-sonner-toaster] {
    --normal-bg: rgba(250, 247, 241, 0.968);
    --normal-border: rgba(38, 85, 98, 0.18);
    --normal-text: var(--bongit-text);
    --success-bg: rgba(250, 247, 241, 0.968);
    --success-border: rgba(29, 139, 75, 0.5);
    --success-text: var(--bongit-ok);
    --info-bg: rgba(250, 247, 241, 0.968);
    --info-border: rgba(53, 114, 131, 0.3);
    --info-text: var(--bongit-text);
    --warning-bg: rgba(250, 247, 241, 0.968);
    --warning-border: rgba(185, 119, 14, 0.55);
    --warning-text: var(--bongit-attention);
    --error-bg: rgba(250, 247, 241, 0.968);
    --error-border: rgba(235, 0, 1, 0.385);
    --error-text: var(--bongit-problem);
}
html:root [data-sonner-toast] {
    -webkit-backdrop-filter: blur(20px) saturate(170%);
    backdrop-filter: blur(20px) saturate(170%);
}

/* Right-click menus (Docker / VM icons): frosted dark menu, violet hover, no arrow tips */
body .dropdown-menu {
    padding: var(--sp-1);
    background: rgba(250, 247, 241, 0.99);
    -webkit-backdrop-filter: blur(24px) saturate(170%);
    backdrop-filter: blur(24px) saturate(170%);
    border: 0;
    border-radius: var(--r-md);
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.1),
        inset 0 0 0 1px rgba(38, 85, 98, 0.16),
        0 16px 40px -12px rgba(26, 58, 67, 0.36);
}
body .dropdown-menu a {
    border-radius: calc(var(--r-md) - var(--sp-1));   /* concentric: menu radius minus its padding */
    color: var(--bongit-text);
    padding: 3px 20px 3px 8px;
}
body .dropdown-menu li > a:hover,
body .dropdown-menu li > a:focus,
body .dropdown-submenu:hover > a,
body .dropdown-menu .active > a,
body .dropdown-menu .active > a:hover {
    color: #ffffff;
    background: rgba(51, 109, 125, 0.24);
    background-image: none;
    filter: none;
    text-shadow: none;
}
body .dropdown-menu .divider {
    margin: var(--sp-1) 0;
    background-color: rgba(255, 255, 255, 0.08);
    border-bottom: 0;
}
body .dropdown-menu .disabled > a {
    color: var(--bongit-text-faint);
}
body .nav-header {
    color: var(--bongit-text-dim);
    background: none;
    text-shadow: none;
    text-transform: none;
}
body .dropdown-context:before,
body .dropdown-context:after,
body .dropdown-context-up:before,
body .dropdown-context-up:after {
    display: none;
}

/* Banners at the top of the page ("Action Centre Enabled", update notices): a frosted
   pill with a status-coloured edge instead of a yellow, green or red box */
body .upgrade_notice,
body .ca_element_notice {
    color: var(--bongit-text);
    background: rgba(250, 247, 241, 0.968);
    -webkit-backdrop-filter: blur(24px) saturate(170%);
    backdrop-filter: blur(24px) saturate(170%);
    border: 0;
    border-radius: var(--r-lg);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12), inset 0 0 0 1px rgba(38, 85, 98, 0.22), 0 12px 32px -10px rgba(26, 58, 67, 0.36);
}
body .upgrade_notice.done {
    color: var(--bongit-ok);
    background: rgba(250, 247, 241, 0.968);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), inset 0 0 0 1px rgba(29, 139, 75, 0.55), 0 12px 32px -10px rgba(26, 58, 67, 0.36);
}
body .upgrade_notice.alert {
    color: var(--bongit-problem);
    background: rgba(250, 247, 241, 0.968);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), inset 0 0 0 1px rgba(235, 0, 1, 0.385), 0 12px 32px -10px rgba(26, 58, 67, 0.36);
}
body .bannerDismiss::before,
body .bannerInfo::before {
    color: var(--bongit-text-dim);
}

/* Community Applications (the Apps page) styles itself through these variables */
html:root {
    --template-background: rgba(250, 247, 241, 0.638);
    --template-hover-background: rgba(248, 243, 233, 0.77);
    --template-favourite: rgba(51, 109, 125, 0.108);
    --sidebar-background: transparent;
    --sidebar-text: var(--bongit-text);
    --a-color: var(--link-text-color);
    --unraid-66-color: var(--bongit-violet);
    --ca-legacy-background-color: transparent;
    --tooltipster-content: var(--bongit-text);
    --chart-grid: rgba(255, 255, 255, 0.06);
    --ca-shadow-color: rgba(51, 109, 125, 0.27);
    --ca-orange-color: var(--bongit-pink);
}
body .ca_holder,
body .dockerHubHolder {
    border-radius: var(--r-lg);
    overflow: hidden;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), inset 0 0 0 1px var(--hairline);
}
body .ca_holder:hover,
body .dockerHubHolder:hover {
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), inset 0 0 0 1px rgba(38, 85, 98, 0.2), 0 10px 28px -10px rgba(51, 109, 125, 0.36);
}
/* The "favourite repository" heart on app cards: CA draws it in a dark flat red (#bb0000).
   It gets the theme's rose instead, with a soft rose glow. */
body .favCardBackground {
    color: #eb0001;
    filter: drop-shadow(0 0 4px rgba(235, 0, 1, 0.385));
}
/* The Apps search box: a pill like every other field, sitting level with its row */
body #searchBox {
    top: 0;
    margin-bottom: 0;
    padding: var(--sp-2) var(--sp-4);
    border: 0;
    border-radius: var(--pill);
    background-color: rgba(252, 249, 245, 0.495);
    background-image: var(--pill-sheen);
    box-shadow: var(--pill-edge);
    caret-color: #295c6a;
}
body #searchBox:focus {
    outline: none;
    animation: bongit-siri 4s ease-in-out infinite;
}
body .searchArea {
    align-items: center;
}
body .searchAreaHolder {
    padding-top: var(--sp-3);
    padding-bottom: var(--sp-2);
}
body #searchBox {
    padding-right: 40px;
}
body .searchSubmit {
    left: -44px;
    padding: 0 10px;
    color: var(--bongit-text-dim);
    background: transparent;
    box-shadow: none;
    min-width: 0;
}
/* Cards: 22px taller so the description no longer runs past the rounded bottom edge
   (homepage cards are forced to 24rem with !important, hence the second rule) */
body .ca_holder,
body .dockerHubHolder {
    height: calc(20rem + 22px);
}
body .ca_holder.spotlightHome {
    height: calc(24rem + 22px) !important;
}
/* Room between the cards and each row's horizontal scroll bar */
body .ca_homeTemplates {
    padding-bottom: var(--sp-4);
}
/* Info popup (slides in from the right) and the card buttons: Apps used a white box
   with black text for these; now dark glass with light text */
html:root {
    --support-popup-background: rgba(255, 255, 255, 0.08);
    --support-popup-text: var(--bongit-text);
}
body .sidenav {
    background: rgba(251, 248, 243, 1);
    -webkit-backdrop-filter: blur(28px) saturate(170%);
    backdrop-filter: blur(28px) saturate(170%);
    box-shadow: inset 1px 0 0 rgba(38, 85, 98, 0.15), -24px 0 60px -20px rgba(26, 58, 67, 0.36);
}
/* Card flags (Official, Beta, Installed, Deprecated...): small glass pills in the top-right
   corner instead of sharp coloured triangles.
   CA 2026.x puts each flag NEXT TO its card, in a plain wrapper <div>, not inside .ca_holder.
   Without a positioned wrapper the pill pins itself to the whole page, so every card's flag
   piled up in one blob at the top right ("INSTALL BETA").  Making the wrapper the anchor
   fixes that.  The wrapper is ~30px wider than the card (the gap to the next card), so the
   pill is placed from the LEFT edge at the card's width, then slid back by its own width. */
body .ca_holder,
body div:has(> .ca_holder) {
    position: relative;
}
html:root {
    --bongit-ca-card-w: 360px;  /* measured .ca_holder width on the Apps home page */
}
body :is(.officialCardBackground, .LTOfficialCardBackground, .betaCardBackground, .spotlightCardBackground, .greenCardBackground, .installedCardBackground, .warningCardBackground, .upgradeCardBackground) {
    position: absolute;
    z-index: 2;  /* the card comes after the flag in the page, so it would paint over it */
    top: var(--sp-3);
    right: auto;
    left: calc(var(--bongit-ca-card-w) - var(--sp-3));
    transform: translateX(-100%);
    width: auto;
    height: auto;
    margin: 0;
    /* Flex-centre the label so it sits dead centre both ways, whatever CA wraps it in */
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px 10px;
    clip-path: none;
    border-radius: var(--pill);
    /* Each flag sets --flag (an "R, G, B" triplet); one recipe turns it into a lit pill:
       bright top fading down, a crisp coloured rim, and a soft outer glow so it catches the eye */
    --flag: 124, 92, 255;
    background: linear-gradient(180deg, rgba(var(--flag), 0.75) 0%, rgba(var(--flag), 0.45) 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), inset 0 0 0 1px rgba(var(--flag), 0.9), 0 0 14px -2px rgba(var(--flag), 0.65);
}
/* One colour per meaning, all from the bongIT palette, none close enough to confuse:
   Official = violet (default above), LimeTech = cyan, Installed / Template = sea green,
   Beta / Updated = amber ("caution"), Deprecated / Blacklisted / Incompatible = crimson rose */
body .LTOfficialCardBackground {
    --flag: 0, 190, 220;
}
body :is(.greenCardBackground, .installedCardBackground) {
    --flag: 16, 201, 143;
}
body .betaCardBackground {
    --flag: 245, 158, 11;
}
body .warningCardBackground {
    --flag: 244, 63, 110;
}

/* "Monthly Spotlight" badge: CA draws it as an orange-ring PNG, so CSS can't recolour the
   ring directly.  A hue shift turns the orange into bongIT violet-magenta; the white text
   inside the badge has no hue, so it stays white. */
body img.spotlightIcon {
    filter: hue-rotate(255deg) saturate(1.15) drop-shadow(0 0 10px rgba(51, 109, 125, 0.21));
    /* 85% size and nudged down, so a corner flag pill (Official, Installed...) clears the top
       of the ring while its "Monthly Spotlight" text stays readable (70% was too small to read).
       Transform doesn't move the date below. */
    transform: translateY(12px) scale(0.85);
    transform-origin: center;
}
/* The flag's label.  CA lays each one out rotated 45deg to sit on its corner triangle,
   under a different class per flag (.installedCardText, .betaPopupText, .officialPopupText...).
   The pill needs them all flat: reset EVERY label class, or Beta / Official / Upgrade come
   out as an unreadable rotated sliver (only Installed was being reset before). */
body :is(.officialCardBackground, .LTOfficialCardBackground, .betaCardBackground, .spotlightCardBackground, .greenCardBackground, .installedCardBackground, .warningCardBackground, .upgradeCardBackground) :is(.installedCardText, .installedPopupText, .betaPopupText, .officialPopupText, .ltofficialPopupText, .upgradePopupText) {
    position: static;
    transform: none;
    top: auto;
    right: auto;
    width: auto;
    height: auto;
    overflow: visible;
    font-size: 1rem;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #ffffff;
    text-shadow: 0 1px 2px rgba(26, 58, 67, 0.203);
    display: block;
    margin: 0;
    padding: 0;
    text-align: center;
    /* Why the text sat off-centre: letter-spacing adds a gap after the LAST letter too,
       and CA pads some labels with non-breaking spaces ("Deprecated&nbsp;", "&nbsp;&nbsp;INSTALLED&nbsp;&nbsp;").
       The negative margin cancels the trailing letter gap; the negative word-spacing shrinks
       those padding spaces to almost nothing (a two-word label keeps a hairline gap). */
    margin-right: -0.08em;
    word-spacing: -0.22em;
}
/* A card can carry more than one flag (e.g. Official + Installed).  Each is absolutely
   pinned to the same top-right spot, so they pile into one garbled blob.  Step every
   flag after the first down by a pill-height so they stack as a tidy column. */
body :is(.officialCardBackground, .LTOfficialCardBackground, .betaCardBackground, .spotlightCardBackground, .greenCardBackground, .installedCardBackground, .warningCardBackground, .upgradeCardBackground) ~ :is(.officialCardBackground, .LTOfficialCardBackground, .betaCardBackground, .spotlightCardBackground, .greenCardBackground, .installedCardBackground, .warningCardBackground, .upgradeCardBackground) {
    top: calc(var(--sp-3) + 2.1rem);
}
body :is(.officialCardBackground, .LTOfficialCardBackground, .betaCardBackground, .spotlightCardBackground, .greenCardBackground, .installedCardBackground, .warningCardBackground, .upgradeCardBackground) ~ :is(.officialCardBackground, .LTOfficialCardBackground, .betaCardBackground, .spotlightCardBackground, .greenCardBackground, .installedCardBackground, .warningCardBackground, .upgradeCardBackground) ~ :is(.officialCardBackground, .LTOfficialCardBackground, .betaCardBackground, .spotlightCardBackground, .greenCardBackground, .installedCardBackground, .warningCardBackground, .upgradeCardBackground) {
    top: calc(var(--sp-3) + 4.2rem);
}

/* Card + toolbar controls: CA paints Info / Support / Install / Actions and the
   "Results Per Page" and DockerHub controls with its orange "donate" button (and locks
   the text to white with !important).  Dress them as the same glass pills as every other
   button so the Apps page matches the rest of the theme. */
body .infoButton,
body .infoButton_docker,
body .supportButton,
body .actionsButton,
body .maxPerPage,
body .initDockerSearch,
body a.initDockerSearch {
    color: var(--bongit-text) !important;
    background: rgba(252, 249, 245, 0.495);
    background-image: var(--pill-sheen);
    border: 0;
    border-radius: var(--pill);
    box-shadow: var(--pill-edge);
    padding: var(--sp-1) var(--sp-3);
    font-weight: 600;
    text-decoration: none;
    transition: box-shadow 0.25s, background 0.25s;
}
body .infoButton:hover,
body .infoButton_docker:hover,
body .supportButton:hover,
body .actionsButton:hover,
body .maxPerPage:hover,
body .initDockerSearch:hover,
body a.initDockerSearch:hover {
    background: linear-gradient(180deg, rgba(55, 118, 136, 0.3), rgba(51, 109, 125, 0.18));
    color: #ffffff !important;
    text-decoration: none;
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.3),
        0 0 0 1px rgba(51, 109, 125, 0.36),
        -8px 0 18px -6px rgba(48, 110, 126, 0.35),
        8px 0 18px -6px rgba(235, 0, 1, 0.35);
}
/* Level the floated Results Per Page / DockerHub pills with the search field's row */
body .maxPerPage,
body .dockerSearch {
    margin-top: 0;
    line-height: 1.6;
    vertical-align: middle;
}

/* Shadowbox: the frame around legacy openBox() popups (e.g. nvidia "Downloading Package").
   The log page inside is themed separately (bongit-logging.css, inserted into logging.htm
   by apply.sh); this is the frame on the main page: a light-grey title bar, a white strip
   at the bottom and an orange close.png.  Now a dark glass sheet like the other modals. */
html:root {
    --dynamix-sb-title-bg-color: transparent;
    --dynamix-sb-title-text-color: var(--bongit-text);
    --dynamix-sb-wrapper-bg-color: #eee7d9;
    --dynamix-sb-wrapper-border-color: transparent;
    --dynamix-sb-wrapper-text-color: var(--bongit-text);
    --dynamix-sb-body-bg-color: #eee7d9;
    --dynamix-sb-body-text-color: var(--bongit-text);
    --dynamix-sb-message-bg-color: transparent;
    --dynamix-sb-message-text-color: var(--bongit-text-dim);
    --dynamix-sb-message-link-color: #377688;
}
/* Dim AND soften the page behind, like a macOS sheet */
body #sb-overlay {
    -webkit-backdrop-filter: blur(6px) saturate(140%);
    backdrop-filter: blur(6px) saturate(140%);
}
body #sb-wrapper {
    border: 0;
    border-radius: var(--r-lg);
    background: #eee7d9;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 0 0 1px rgba(38, 85, 98, 0.18), 0 30px 80px -20px rgba(26, 58, 67, 0.405), 0 0 60px -20px rgba(51, 109, 125, 0.27);
}
body #sb-wrapper-inner {
    border-radius: 0 0 var(--r-lg) var(--r-lg);
}
/* Title bar: a faint violet glass strip with a hairline under it; the title text shimmers
   like the System Info / Release Notes modal titles (holo on the inner span only, so the
   bar's own background isn't clipped to the text) */
body #sb-title {
    border-radius: var(--r-lg) var(--r-lg) 0 0;
    background: linear-gradient(180deg, rgba(51, 109, 125, 0.096), rgba(51, 109, 125, 0.024));
    box-shadow: inset 0 -1px 0 var(--hairline);
}
body #sb-title-inner {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-indent: 0;
    background: linear-gradient(90deg, #285866, #285866);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: bongit-sheen 14s linear infinite;
}
@media (prefers-reduced-motion: reduce) {
    body #sb-title-inner { animation: none; }
}
/* Bottom strip (the white bar): blend into the sheet */
body #sb-info,
body #sb-info-inner {
    background: transparent;
}
/* Close: the round glass X button used by the side panel, instead of the orange close.png */
body #sb-nav-close {
    background-image: none;
    display: flex;
    align-items: center;
    justify-content: center;
    top: -12px;
    right: -12px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    color: var(--bongit-text);
    background-color: rgba(250, 247, 241, 0.99);
    box-shadow: var(--pill-edge), 0 6px 16px -6px rgba(26, 58, 67, 0.36);
    transition: box-shadow 0.25s, background 0.25s;
}
body #sb-nav-close::before {
    content: "\2715";  /* ✕ */
    font-size: 13px;
    line-height: 1;
}
body #sb-nav-close:hover {
    background-color: rgba(51, 109, 125, 0.33);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 0 0 1px rgba(51, 109, 125, 0.36), 0 0 18px -4px rgba(51, 109, 125, 0.48);
}

/* Apps "Info" side panel (.sidenav): built from the same parts as the rest of the theme.
   CA's own version uses tiny transparent buttons, a 15px-radius grey box, a borderless
   table and a maintainer icon floated to the far edge.  Here: glass pill buttons (Install
   gets the violet "primary" fill), glass cards on the radius scale, shimmer section
   headers like the Dashboard's, a grouped list for Details, and the maintainer as one row. */

/* Close: a round liquid-glass icon button at the top right, like a macOS sheet,
   instead of a tiny "CLOSE" capsule at the top left.  The text is hidden and an X drawn. */
body .sidenav .popupCloseArea {
    text-align: right;
    padding-right: var(--sp-4);
    box-sizing: border-box;
    z-index: 3;
}
body .sidenav .popUpClose.caButton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    margin: 0;
    font-size: 0;
    border-radius: 50%;
    color: var(--bongit-text) !important;
    background: rgba(252, 249, 245, 0.495);
    background-image: var(--pill-sheen);
    box-shadow: var(--pill-edge);
    transition: box-shadow 0.25s, background 0.25s;
}
body .sidenav .popUpClose.caButton::before {
    content: "\2715";  /* ✕ */
    font-size: 14px;
    line-height: 1;
}
body .sidenav .popUpClose.caButton:hover {
    background: linear-gradient(180deg, rgba(55, 118, 136, 0.3), rgba(51, 109, 125, 0.18));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 0 0 1px rgba(51, 109, 125, 0.36), 0 0 18px -4px rgba(51, 109, 125, 0.48);
}

/* Header: app icon as a rounded "squircle" tile, name and author spaced on the 4px grid */
body .sidenav img.popupIcon {
    border-radius: var(--r-lg);
    padding: 0;
    background: var(--bongit-line);
    box-shadow: inset 0 0 0 1px var(--hairline), 0 10px 26px -12px rgba(51, 109, 125, 0.42);
}
body .sidenav .popupName {
    font-size: 28px;
    letter-spacing: -0.01em;
}
body .sidenav .popupAuthorMain {
    font-size: 15px;
    color: var(--bongit-text-dim);
    margin: var(--sp-1) 0 var(--sp-3);
}

/* Every button in the panel: the same glass pill as the card buttons */
body .sidenav .caButton {
    color: var(--bongit-text) !important;
    background: rgba(252, 249, 245, 0.495);
    background-image: var(--pill-sheen);
    border: 0;
    border-radius: var(--pill);
    box-shadow: var(--pill-edge);
    padding: var(--sp-1) var(--sp-3);
    margin: 0 var(--sp-2) var(--sp-2) 0;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.5;
    cursor: pointer;
    transition: box-shadow 0.25s, background 0.25s;
}
body .sidenav .caButton:hover {
    background: linear-gradient(180deg, rgba(55, 118, 136, 0.3), rgba(51, 109, 125, 0.18));
    color: #ffffff !important;
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.3),
        0 0 0 1px rgba(51, 109, 125, 0.36),
        -8px 0 18px -6px rgba(48, 110, 126, 0.35),
        8px 0 18px -6px rgba(235, 0, 1, 0.35);
}
/* Install (the main action) is the one filled violet pill, so the eye lands on it first */
body .sidenav .actionsPopup {
    background: linear-gradient(180deg, rgba(51, 109, 125, 0.48), rgba(51, 109, 125, 0.3));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), inset 0 0 0 1px rgba(38, 85, 98, 0.5), 0 6px 18px -8px rgba(51, 109, 125, 0.54);
}

/* Description: a glass card matching the app cards, full width instead of an odd 596px box */
body .sidenav .popupDescription {
    display: block;
    box-sizing: border-box;
    width: auto;
    margin: var(--sp-4) var(--sp-3) 0;
    padding: var(--sp-4) var(--sp-5);
    border-radius: var(--r-lg);
    background: var(--template-background);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), inset 0 0 0 1px var(--hairline);
    line-height: 1.55;
}

/* Section headers ("Details", "Maintainer"): shimmer like the Dashboard's (added to the
   holo rule above), sized down from CA's 25px to sit with the theme's other headers */
body .sidenav :is(.rightTitle, .popupAuthorTitle) {
    font-size: 17px;
    font-weight: 600;
    height: auto;
    margin: var(--sp-6) 0 var(--sp-3);
    display: inline-block;
}

/* Details: a grouped list (like iOS Settings) - one glass card, hairlines between rows,
   labels dimmed.  CA sets the table to display:contents, which can't have a background. */
body .sidenav .popupTable {
    display: table !important;
    width: 100%;
    margin: 0;
    border-collapse: separate;
    border-spacing: 0;
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--template-background);
    background-image: none;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), inset 0 0 0 1px var(--hairline);
}
body .sidenav .popupTable :is(.popupTableLeft, .popupTableRight) {
    padding: var(--sp-2) var(--sp-5);
    height: auto;
    vertical-align: middle;
}
body .sidenav .popupTable .popupTableLeft {
    color: var(--bongit-text-dim);
    width: 40%;
}
body .sidenav .popupTable tr + tr > td {
    border-top: 1px solid var(--hairline);
}

/* Maintainer: icon, name and buttons as one tidy row group, icon on the left, instead of
   the name at the left and the icon floated alone to the far right edge */
body .sidenav div:has(> .popupAuthor) {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-bottom: var(--sp-3);
}
body .sidenav div.popupAuthorIcon {
    order: -1;
    float: none;
    width: 44px;
    height: 44px;
}
body .sidenav img.popupAuthorIcon {
    float: none;
    width: 44px;
    height: 44px;
    border-radius: var(--r-sm);
    box-shadow: inset 0 0 0 1px var(--hairline);
}
body .sidenav .popupAuthor {
    font-size: 16px;
    font-weight: 600;
    margin: 0;
}

/* Footnote: quiet, dimmed, with breathing room */
body .sidenav .ca_note {
    display: inline-block;
    margin: var(--sp-4) var(--sp-3);
    font-weight: 400;
    color: var(--bongit-text-dim);
}

/* Folder View plugin: give its small chevron button back its compact size (the theme's
   button padding made it wide enough to drop onto its own line next to long names) */
body .folder-dropdown {
    padding: 6px;
    min-width: 0;
}

/* Accessibility: users who ask the OS to reduce motion get a steady glow */
@media (prefers-reduced-motion: reduce) {
    body :focus {
        animation: none !important;
    }
}

/* Accessibility: users who ask the OS for less transparency get solid panels */
@media (prefers-reduced-transparency: reduce) {
    html:root {
        --glass-tint: var(--bongit-raised);
        --glass-tint-strong: var(--bongit-surface);
        --glass-filter: none;
    }
}

/* Click glow for regular pill buttons (Apply, Done, Check For Updates, the Apps card and
   side-panel buttons...): pressing lights the full bongIT glow (violet ring, cyan/pink
   sides) and presses in; letting go fades it back over ~1.2s.  These have no "active"
   state to rest in, so they fade to normal (or to the hover glow if still hovered).
   Done with box-shadow, not a ::after halo, because <input> buttons can't have
   pseudo-elements.  The press uses the separate `scale` property so it doesn't fight
   buttons already positioned with transform (e.g. Check For Updates).
   How the fade works: a transition runs at the speed of the state it's going TO, so the
   pressed state switches instantly (0s) and the normal/hover states take 1.2s back.
   :is() with .sidenav .caButton lifts the specificity to beat the side-panel rule. */
body :is(input[type="button"], input[type="reset"], input[type="submit"], button, a.button):not(.unapi *):not([role="tab"]):not([disabled]),
body :is(.infoButton, .infoButton_docker, .supportButton, .actionsButton, .maxPerPage, .initDockerSearch, .sidenav .caButton, .caButton) {
    transition: box-shadow 1.2s cubic-bezier(0.2, 0.8, 0.2, 1), background 0.25s, scale 0.2s ease-out;
}
body :is(input[type="button"], input[type="reset"], input[type="submit"], button, a.button):not(.unapi *):not([role="tab"]):not([disabled]):active,
body :is(.infoButton, .infoButton_docker, .supportButton, .actionsButton, .maxPerPage, .initDockerSearch, .sidenav .caButton, .caButton):active {
    scale: 0.96;
    transition: box-shadow 0s, background 0s, scale 0.08s;
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.35),
        0 0 0 1px rgba(38, 85, 98, 0.7),
        0 0 22px 2px rgba(51, 109, 125, 0.51),
        -12px 0 26px -4px rgba(48, 110, 126, 0.525),
        12px 0 26px -4px rgba(235, 0, 1, 0.525);
}
@media (prefers-reduced-motion: reduce) {
    body :is(input[type="button"], input[type="reset"], input[type="submit"], button, a.button):not(.unapi *):not([role="tab"]),
    body :is(.infoButton, .infoButton_docker, .supportButton, .actionsButton, .maxPerPage, .initDockerSearch, .sidenav .caButton, .caButton) {
        transition: none;
    }
}

/* ===== Revealed-gradient meters (usage bars, CPU bars, header usage bar) =====
   The bar is ONE fixed gradient (green -> amber -> rose) laid across the whole
   track; the fill only reveals more of it as the value grows.  50% shows green into early
   amber and never any rose; 100% shows every colour.  (A tip glow was tried and
   removed in favour of the clean gradient.)
   How: the track is a CSS "container", so `100cqw` means "the track's full width".  The
   fill's gradient is sized to 100cqw instead of to the fill itself, so it stays put while
   the fill grows over it.
   Colour bands roughly follow Unraid's warning/critical levels (see --bongit-meter). */
html:root {
    /* Colours spread evenly across the track (v1 was 58% green, then everything crammed
       into the last stretch), slightly muted so they sit in the dark theme. */
    /* Bands roughly follow Unraid's default thresholds (Settings -> Disk Settings: warning
       70%, critical 90%): amber from ~70, rose from ~90, so the tip mostly agrees with the
       text colour.  Green starts warming toward gold from ~45% on purpose; strict 70%
       alignment made every bar mostly green.  The CPU graph below uses the same stops. */
    --bongit-meter: linear-gradient(90deg,
        #1d8b4b 0%, #1d8b4b 25%, #1d8b4b 45%, #b9770e 60%,
        #b9770e 72%, #b9770e 84%, #eb0001 92%, #eb0001 100%);
    /* Glass sheen over the fill: a light top edge and a slightly darker bottom */
    --bongit-meter-sheen: linear-gradient(180deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.04) 45%, rgba(26, 58, 67, 0.081) 100%);
}
body .usage-disk,
body .usage-bar {
    container-type: inline-size;
    isolation: isolate;
}
body .usage-disk > span:first-child:is(.greenbar, .orangebar, .redbar),
body .usage-disk.sys:not(.none) > span:first-child,
body .usage-bar > span:is(.greenbar, .orangebar, .redbar) {
    background: var(--bongit-meter-sheen), var(--bongit-meter);
    background-size: 100% 100%, 100cqw 100%;
    background-repeat: no-repeat;
    box-shadow: none;
}
body .usage-bar > span {
    position: relative;
}
/* (A blurred tip glow was tried here and removed in favour of the clean gradient.) */
/* Percentage text next to Dashboard bars (CPU cores, overall load, array/pool utilization)
   takes the gradient's colour at the bar's tip, in 10% steps.  How: Unraid writes each
   fill's width into its style attribute as text ("width:97%" from the server, "width: 62%"
   once the script animates it), and CSS can match text inside an attribute.  Each rule
   matches one tens digit (and skips single-digit values like "width: 6%").  Colours are
   sampled from --bongit-meter at the middle of each step.  Unraid also sets the text colour
   inline, hence !important.  0-9% (and anything unmatched) falls back to the first rule. */

/* CPU cores / overall load: plain theme text; the bar alone carries the colour.
   Unraid sets these numbers' colour inline on every update, hence !important.  (Colour-
   matching them to the bar was tried: Safari doesn't reliably re-check :has() rules when
   only a bar's width changes, so numbers kept stale colours.)  Disk/pool utilization
   numbers have no inline colour and keep the 10%-step colours above. */
body span.load[style*="color"] {
    color: var(--bongit-text) !important;
}


/* Size labels on Main / Shares bars ("1.2 TB"): the original light halo.  (A dark chip hid
   the tip; a heavy halo made the labels look outlined and smudgy.  Both dropped.) */

/* CPU history graph: the same green -> amber -> rose treatment as the meters, by HEIGHT.
   The chart is a script-drawn <canvas> on a fixed 0-100% scale, so height = load: a line
   near the bottom is green, and the higher it climbs the more amber and rose it shows.
   CSS can't colour canvas pixels by value, so it's a blending trick:
     1. the canvas is made black with its line turned white (grayscale + brightness);
     2. the gradient is laid over it with `multiply`: black stays black, white takes the
        gradient's colour at that height;
     3. the whole cell is blended onto the panel with `screen`, where black vanishes,
        leaving only the coloured line (the faint grid and the % labels pick up the
        gradient too, dimly).
   The earlier rule (a hue-rotate to violet) is emptied further up. */
body td:has(> canvas#cpuchart) {
    position: relative;
    padding: 0;
    mix-blend-mode: screen;
    isolation: isolate;
}
body canvas#cpuchart {
    display: block;
    background: #1a3a43;
    /* High contrast pushes the canvas's own dim grid to pure black (so it vanishes in the
       blend and doesn't pick up the gradient) while the bright line stays white. */
    filter: grayscale(1) contrast(4);
}
/* The chart sits in a rounded well seated inside the tile: an even 8px gap to the tile's
   sides and bottom, and corners of 20px - 8px = 12px so they run parallel to the tile's.
   (A fully see-through chart isn't possible in Safari: inside a frosted tile, the blend that
   removes the canvas's black only sees the tile's flat tint, so the well stays a bit darker,
   like the log box in the update windows.)
   The tile's bottom padding drops to the 8px gap while the chart row is showing. */
body table.dashboard > tbody:has(> tr#cpu_chart) {
    padding-bottom: 8px;
}
body td:has(> canvas#cpuchart) {
    padding: 0 8px;
}
body canvas#cpuchart {
    border-radius: 12px;
}
/* Our own soft grey grid (lines at 0/25/50/75/100% and every 24px), drawn over the chart
   after the colouring so it stays grey, with a hairline edge around the well.  Static, so it
   doesn't scroll with the line the way the canvas's own grid did. */
body td:has(> canvas#cpuchart)::before {
    content: "";
    position: absolute;
    inset: 0 8px;
    z-index: 2;
    border-radius: 12px;
    background-image:
        linear-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.07) 1px, transparent 1px);
    background-size: 100% 25%, 24px 100%;
    box-shadow: inset 0 0 0 1px rgba(38, 85, 98, 0.12);
    pointer-events: none;
}
body td:has(> canvas#cpuchart)::after {
    content: "";
    position: absolute;
    inset: 0 8px;
    border-radius: 12px;
    background: linear-gradient(to top,
        #1d8b4b 0%, #1d8b4b 25%, #1d8b4b 45%, #b9770e 60%,
        #b9770e 72%, #b9770e 84%, #eb0001 92%, #eb0001 100%);
    mix-blend-mode: multiply;
    pointer-events: none;
}


/* Holographic shimmer for headings: six soft colour blobs float inside the letters over a
   base colour, like globs in a holographic lamp, each on its own wandering path.
   How: each blob is a radial gradient centred at two registered (@property) percentages,
   and one animation per heading moves all twelve along six different paths.  The whole
   stack is clipped to the text (background-clip: text, set by the rules above).
   Why this way (measured on the Dashboard in Safari, ~36 headings):
     - twelve separate animations per heading, smooth: ~16 fps;
     - sliding pre-drawn layers (background-position) was faster, but Safari doesn't
       repaint text-clipped backgrounds when only their position changes, so it froze;
     - so: one animation per heading, stepped about 15 times a second.  The blobs drift
       slowly, so steps still read as smooth, and Safari repaints a quarter as often.
     - that still left the Dashboard at ~25 fps: each step repainted a chunk of
       the frosted panel around the heading, not just the heading.  Giving every heading its
       own layer (will-change: transform) plus paint containment (contain: paint) keeps each
       step's repaint inside the heading's own box: ~50 fps, about the same as no holographic at all.
       Neither alone was enough (45 and 39 fps).  Checked: tile dropdowns still open fully.
       Only on tile and section titles: on a frosted dialog's title it looked ghostly.
   Reduced-motion users get the blobs held still. */

@property --bongit-holo-x1 { syntax: "<percentage>"; inherits: false; initial-value: 50%; }
@property --bongit-holo-y1 { syntax: "<percentage>"; inherits: false; initial-value: 50%; }
@property --bongit-holo-x2 { syntax: "<percentage>"; inherits: false; initial-value: 50%; }
@property --bongit-holo-y2 { syntax: "<percentage>"; inherits: false; initial-value: 50%; }
@property --bongit-holo-x3 { syntax: "<percentage>"; inherits: false; initial-value: 50%; }
@property --bongit-holo-y3 { syntax: "<percentage>"; inherits: false; initial-value: 50%; }
@property --bongit-holo-x4 { syntax: "<percentage>"; inherits: false; initial-value: 50%; }
@property --bongit-holo-y4 { syntax: "<percentage>"; inherits: false; initial-value: 50%; }
@property --bongit-holo-x5 { syntax: "<percentage>"; inherits: false; initial-value: 50%; }
@property --bongit-holo-y5 { syntax: "<percentage>"; inherits: false; initial-value: 50%; }
@property --bongit-holo-x6 { syntax: "<percentage>"; inherits: false; initial-value: 50%; }
@property --bongit-holo-y6 { syntax: "<percentage>"; inherits: false; initial-value: 50%; }
@keyframes bongit-holo {
    0% { --bongit-holo-x1: 67%; --bongit-holo-y1: 18%; --bongit-holo-x2: 7%; --bongit-holo-y2: 91%; --bongit-holo-x3: -3%; --bongit-holo-y3: 36%; --bongit-holo-x4: 33%; --bongit-holo-y4: 75%; --bongit-holo-x5: 77%; --bongit-holo-y5: 56%; --bongit-holo-x6: 3%; --bongit-holo-y6: 10%; }
    17% { --bongit-holo-x1: 86%; --bongit-holo-y1: -8%; --bongit-holo-x2: 92%; --bongit-holo-y2: -3%; --bongit-holo-x3: -4%; --bongit-holo-y3: 14%; --bongit-holo-x4: 9%; --bongit-holo-y4: 120%; --bongit-holo-x5: 48%; --bongit-holo-y5: 26%; --bongit-holo-x6: 92%; --bongit-holo-y6: 22%; }
    33% { --bongit-holo-x1: 3%; --bongit-holo-y1: 117%; --bongit-holo-x2: 46%; --bongit-holo-y2: 3%; --bongit-holo-x3: 59%; --bongit-holo-y3: 87%; --bongit-holo-x4: 1%; --bongit-holo-y4: -5%; --bongit-holo-x5: 47%; --bongit-holo-y5: 0%; --bongit-holo-x6: 72%; --bongit-holo-y6: 18%; }
    50% { --bongit-holo-x1: 9%; --bongit-holo-y1: 73%; --bongit-holo-x2: 93%; --bongit-holo-y2: -5%; --bongit-holo-x3: 21%; --bongit-holo-y3: 118%; --bongit-holo-x4: 37%; --bongit-holo-y4: 107%; --bongit-holo-x5: 61%; --bongit-holo-y5: 114%; --bongit-holo-x6: 110%; --bongit-holo-y6: 87%; }
    67% { --bongit-holo-x1: -1%; --bongit-holo-y1: 109%; --bongit-holo-x2: 16%; --bongit-holo-y2: 37%; --bongit-holo-x3: 15%; --bongit-holo-y3: 58%; --bongit-holo-x4: 94%; --bongit-holo-y4: 60%; --bongit-holo-x5: 111%; --bongit-holo-y5: 67%; --bongit-holo-x6: -5%; --bongit-holo-y6: -1%; }
    83% { --bongit-holo-x1: 39%; --bongit-holo-y1: -11%; --bongit-holo-x2: 0%; --bongit-holo-y2: 81%; --bongit-holo-x3: 31%; --bongit-holo-y3: 6%; --bongit-holo-x4: 104%; --bongit-holo-y4: 96%; --bongit-holo-x5: 99%; --bongit-holo-y5: 53%; --bongit-holo-x6: 65%; --bongit-holo-y6: 67%; }
    100% { --bongit-holo-x1: 67%; --bongit-holo-y1: 18%; --bongit-holo-x2: 7%; --bongit-holo-y2: 91%; --bongit-holo-x3: -3%; --bongit-holo-y3: 36%; --bongit-holo-x4: 33%; --bongit-holo-y4: 75%; --bongit-holo-x5: 77%; --bongit-holo-y5: 56%; --bongit-holo-x6: 3%; --bongit-holo-y6: 10%; }
}
html body .tile-header-main,
html body .tile-header-left i[class^="icon-"],
html body .tile-header-left i[class*=" icon-"],
html body div.title .left,
html body div.title .left i,
html body .sidenav :is(.rightTitle, .popupAuthorTitle),
html body .sweet-alert.nchan :is(h1, h2, h3),
html body #sb-title-inner,
html body .boot-title {
    background-color: var(--bongit-holo-base);
    background-image:
        radial-gradient(1.9em 1em at var(--bongit-holo-x1) var(--bongit-holo-y1), var(--bongit-holo-c1), transparent),
        radial-gradient(2.2em 1.1em at var(--bongit-holo-x2) var(--bongit-holo-y2), var(--bongit-holo-c2), transparent),
        radial-gradient(1.7em 0.9em at var(--bongit-holo-x3) var(--bongit-holo-y3), var(--bongit-holo-c3), transparent),
        radial-gradient(1.5em 0.8em at var(--bongit-holo-x4) var(--bongit-holo-y4), var(--bongit-holo-c4), transparent),
        radial-gradient(1.6em 0.9em at var(--bongit-holo-x5) var(--bongit-holo-y5), var(--bongit-holo-c5), transparent),
        radial-gradient(1.6em 0.9em at var(--bongit-holo-x6) var(--bongit-holo-y6), var(--bongit-holo-c6), transparent);
    background-size: auto;
    background-position: 0 0;
    background-repeat: no-repeat;
    animation: bongit-holo 34s infinite;
    animation-timing-function: steps(85);   /* ~15 updates a second, see above */
}
/* Own layer + paint containment (see above), only on the titles that come in dozens.
   Not on dialog, popup or boot-page titles: there is one at a time, and Safari drew a
   separate layer on top of a frosted dialog faint and ghostly. */
html body .tile-header-main,
html body .tile-header-left i[class^="icon-"],
html body .tile-header-left i[class*=" icon-"],
html body div.title .left,
html body div.title .left i {
    will-change: transform;                 /* own layer, so a step repaints only this heading */
    contain: paint;                         /* and nothing outside its box */
}
html body .tile-header-main,
html body .tile-header-left i[class^="icon-"],
html body .tile-header-left i[class*=" icon-"],
html body div.title .left,
html body div.title .left i,
html body .sidenav :is(.rightTitle, .popupAuthorTitle),
html body .sweet-alert.nchan :is(h1, h2, h3),
html body #sb-title-inner {
    --bongit-holo-base: #285866; --bongit-holo-c1: var(--bongit-holo-base); --bongit-holo-c2: var(--bongit-holo-base); --bongit-holo-c3: var(--bongit-holo-base); --bongit-holo-c4: var(--bongit-holo-base); --bongit-holo-c5: var(--bongit-holo-base); --bongit-holo-c6: var(--bongit-holo-base);
}
html body .boot-title {
    --bongit-holo-base: #336d7d; --bongit-holo-c1: var(--bongit-holo-base); --bongit-holo-c2: var(--bongit-holo-base); --bongit-holo-c3: var(--bongit-holo-base); --bongit-holo-c4: var(--bongit-holo-base); --bongit-holo-c5: var(--bongit-holo-base); --bongit-holo-c6: var(--bongit-holo-base);
}
@media (prefers-reduced-motion: reduce) {
    html body .tile-header-main,
    html body .tile-header-left i[class^="icon-"],
    html body .tile-header-left i[class*=" icon-"],
    html body div.title .left,
    html body div.title .left i,
    html body .sidenav :is(.rightTitle, .popupAuthorTitle),
    html body .sweet-alert.nchan :is(h1, h2, h3),
    html body #sb-title-inner,
    html body .boot-title {
        animation: none;
        --bongit-holo-x1: 67%; --bongit-holo-y1: 18%; --bongit-holo-x2: 7%; --bongit-holo-y2: 91%; --bongit-holo-x3: -3%; --bongit-holo-y3: 36%; --bongit-holo-x4: 33%; --bongit-holo-y4: 75%; --bongit-holo-x5: 77%; --bongit-holo-y5: 56%; --bongit-holo-x6: 3%; --bongit-holo-y6: 10%;
    }
}

/* Holographic moves only where you're pointing.  Tile and section titles hold a still frame of
   the holographic, and come alive while the pointer is over their tile (a Dashboard tile is a
   <tbody>) or their title bar.  Pausing keeps the blobs where they were, so nothing jumps
   when the pointer leaves or comes back.  Why: ~37 titles animating at once was the
   theme's one real cost on the Dashboard (stock Unraid ~118 fps; holographic everywhere as low as
   ~60 in Safari at 120 Hz).  Popups, the log window and the boot page show one title at a
   time, so they keep moving. */
html body .tile-header-main,
html body .tile-header-left i[class^="icon-"],
html body .tile-header-left i[class*=" icon-"],
html body div.title .left,
html body div.title .left i {
    animation-play-state: paused;
}
html body tbody:hover :is(.tile-header-main, .tile-header-left i[class^="icon-"], .tile-header-left i[class*=" icon-"]),
html body div.title:hover :is(.left, .left i) {
    animation-play-state: running;
}

/* Spinner in the log-window title: while a plugin job runs, Unraid puts a spinning icon
   after "In Progress".  The icon is a font glyph, so the shimmer's see-through text fill hid
   it like the letters around it (and Chrome drew a stray sliver of it in the window corner).
   Giving the icon its own solid fill brings it back. */
html body .sweet-alert.nchan :is(h1, h2, h3) #pluginProgressTitle i {
    -webkit-text-fill-color: #285866;
    color: #285866;
}

/* Footer: the theme's version, just left of Unraid's copyright.  tools/release.sh writes
   the real version into the marked line below before it hashes this file, so the text
   always matches the installed release. */
body #copyright::before {
    content: "bongIT Theme 2026.11.25.1201"; /* BONGIT-THEME-VERSION */
    margin-right: 0.75em;
    padding-right: 0.75em;
    border-right: 1px solid var(--glass-edge);
    color: var(--bongit-text-dim);
    white-space: nowrap;
}


/* Header usage bar number ("90%"): white with the same light dark halo as the disk labels,
   so it reads on any part of the gradient (it had no halo, and the old dark-ink colour for
   green/amber fills no longer suits the multi-colour gradient). */
body .usage-bar > span:is(.greenbar, .orangebar, .redbar) {
    color: #ffffff;
    text-shadow: 0 1px 1px var(--bongit-bar-ink), 0 0 3px var(--bongit-bar-ink);
}

/* ===== Docker install / update output page =====
   After "Apply" on a container, Unraid pastes the whole of dynamix.docker.manager/log.htm
   into the page body, including its own <style> block with hardcoded orange buttons.
   That block lands after this theme and ties with it, so the buttons came out stock orange.
   The theme normally recolours buttons through Unraid's --button-* variables, which those
   hardcoded rules ignore, so here the same variables are applied directly, only on pages
   that contain the log body (#logBody). */
body:has(#logBody) :is(input[type="button"], input[type="reset"], input[type="submit"], button, a.button):not(.unapi *):not([disabled]) {
    color: var(--button-text-color);
    background: var(--button-background);
    background-size: var(--button-background-size);
}
body:has(#logBody) :is(input[type="button"], input[type="reset"], input[type="submit"], button, a.button):not(.unapi *):not([disabled]):hover {
    color: var(--hover-button-text-color);
    background: var(--hover-button-background);
}
/* The "Command execution" box is a <fieldset> with the browser's grey groove border;
   it gets the same dark well as code blocks */
body fieldset.CMD:not(.unapi *) {
    border: 0;
    border-radius: var(--r-md);
    padding: var(--sp-3) var(--sp-4);
    background: rgba(252, 249, 245, 0.495);
    box-shadow: inset 0 0 0 1px var(--hairline);
}
body fieldset.CMD:not(.unapi *) > legend {
    padding: 0 var(--sp-2);
    color: var(--bongit-text-dim);
    font-family: var(--bongit-font);
    font-weight: 600;
    letter-spacing: 0.02em;
}


/* ===== Main page polish ===== */

/* Scroll-to-top / scroll-to-end buttons: two round buttons side by side in a glass
   capsule, up on the left and down on the right, like stock.  Stock Unraid draws two red
   circle-arrow glyphs 24px off the bottom, where the frosted footer clipped them.
   Unraid shows each one on its own: "down" whenever the page can scroll, "up" only once
   you've scrolled.  The capsule always has both slots, drawn by "down" (its ::before),
   with a dimmed placeholder "up" in the left slot (its ::after).  The real "up" sits
   exactly on the placeholder and covers it while it's shown, so at the top of the page
   the up button simply looks disabled.
   (Tried and dropped: resizing the capsule with :has() on "up"'s style attribute, and
   auto-hiding until hover.  Safari doesn't recheck those rules when the page script
   shows "up", so the capsule or the up button got stuck in the old state.)
   Layering: each link keeps Unraid's z-index, so it's its own stack.  The capsule sits
   at z-index -1 inside "down", behind the circle, which is the <i> (not the link itself:
   a background on the link would paint under the capsule).  "Up" comes later in the page,
   so it paints over everything "down" draws.
   Sizes: circles 2.6rem, 0.4rem of capsule around them and between them.  (jQuery fades
   set display inline, so centring is done with line-height, not flexbox.) */
body a.back_to_top,
body a.move_to_end {
    bottom: 4.8rem;   /* 0.4rem of capsule above a 4.4rem gap over the footer */
    width: 2.6rem;
    height: 2.6rem;
    line-height: 2.6rem;
    text-align: center;
    font-size: 1.5rem;
    color: var(--bongit-text);
    background: none;
    box-shadow: none;
    text-decoration: none;   /* Unraid underlines links on hover; it drew a stray line under the chevron */
}
body a.back_to_top:is(:hover, :focus),
body a.move_to_end:is(:hover, :focus) {
    text-decoration: none;
}
body a.move_to_end { right: 1.6rem; }
body a.back_to_top { right: 4.6rem; }   /* 1.6 + 2.6 circle + 0.4 gap */
/* The round button itself */
body a.back_to_top > i.fa,
body a.move_to_end > i.fa {
    display: block;
    width: 100%;
    height: 100%;
    line-height: inherit;
    border-radius: 50%;
    background: var(--pill-sheen), rgba(248, 243, 233, 0.605);
    box-shadow: var(--pill-edge);
    transition: color 0.2s, background 0.2s, box-shadow 0.2s;
}
body a.back_to_top:hover > i.fa,
body a.move_to_end:hover > i.fa {
    color: #ffffff;
    background: var(--hover-button-background);
    box-shadow: var(--pill-edge), 0 0 12px rgba(51, 109, 125, 0.36);
}
/* The capsule, around both slots.  pointer-events: none so a click on the capsule's
   rim, or on the placeholder, doesn't count as a click on "down". */
body a.move_to_end::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -0.4rem -0.4rem -0.4rem -3.4rem;   /* reaches left past the gap and the up slot */
    border-radius: var(--pill);
    /* Lighter than the page and with a brighter rim: the plain glass tint matched the
       dark background near the footer, so the capsule disappeared. */
    background: var(--pill-sheen), rgba(35, 76, 87, 0.228);
    -webkit-backdrop-filter: var(--glass-filter);
    backdrop-filter: var(--glass-filter);
    box-shadow: inset 0 0 0 1px rgba(38, 85, 98, 0.24), 0 8px 22px -8px rgba(26, 58, 67, 0.338);
    pointer-events: none;
}
/* The dimmed placeholder "up" in the left slot (Font Awesome 4 angle-up, like the real one) */
body a.move_to_end::after {
    content: "\f106";
    position: absolute;
    top: 0;
    right: calc(100% + 0.4rem);
    width: 2.6rem;
    height: 2.6rem;
    line-height: 2.6rem;
    border-radius: 50%;
    font-family: FontAwesome;
    color: var(--bongit-text-faint);
    background: rgba(248, 243, 233, 0.33);
    box-shadow: inset 0 0 0 1px var(--hairline);
    opacity: 0.6;
    pointer-events: none;
}
/* When the background task tray is open, Unraid moves the pair to the bottom-left
   (and sets right: auto); keep the same order, up then down. */
.op-tray:not(:empty) ~ a.back_to_top { left: 1.6rem; }
.op-tray:not(:empty) ~ a.move_to_end { left: 4.6rem; }
/* Plain chevrons (Font Awesome 4: angle-up / angle-down): the button is already round */
body a.back_to_top > i.fa::before { content: "\f106"; }
body a.move_to_end > i.fa::before { content: "\f107"; }

/* Device dropdowns and slot counts on Main: the general select pill (2.4rem plus padding)
   was too tall for a 3.2rem table row and sat off-centre.  Inside the device tables they
   get a fixed, slimmer height, no vertical padding (so the text and arrow centre), and
   middle alignment within the row. */
html body table.disk_status select:not(.unapi *) {
    height: 2.2rem;
    min-height: 2.2rem;
    line-height: 2.2rem;
    padding-top: 0;
    padding-bottom: 0;
    vertical-align: middle;
    font-size: 1.2rem;
}

/* Disk usage bars: make the empty track visible (it was so faint that a nearly empty
   bar, like the boot flash, looked like a lone sliver), and give any non-empty fill a
   minimum width of its own height so a small value is a round dot, not a thin bar. */
body table.disk_status .usage-disk:not(.sys):not(.mm) {
    background-color: rgba(48, 107, 123, 0.12);
    box-shadow: inset 0 0 0 1px var(--hairline);
}
body table.disk_status .usage-disk:not(.sys):not(.mm) > span:first-child:not([style*="width:0%"]):not([style*="width: 0%"]) {
    min-width: 1.8rem;
}

/* Dashboard bars (CPU cores, GPU stats and other 12px "sys" bars): same idea, a small value
   is a round dot instead of a sliver narrower than it is tall.  Only fills that have a width
   written and are at least 1%, so empty bars stay empty. */
body .usage-disk.sys:not(.none) > span:first-child:is([style*="width"]):not([style*="width:0%"], [style*="width: 0%"], [style*="width: 0px"], [style*="width:0."], [style*="width: 0."]) {
    min-width: 12px;
}
/* Under 1% (e.g. "width: 0.4%") the number next to it reads 0%, so the bar shows empty too */
body .usage-disk.sys:not(.none) > span:first-child:is([style*="width:0."], [style*="width: 0."]) {
    visibility: hidden;
}

/* Header array bar when the array is stopped.  Unraid prints "offline" in an unclassed
   fill at full width, which the theme painted with the full brand gradient, so a stopped
   array looked like a healthy one.  It becomes an empty track with rose text instead. */
html body #menu .usage-bar > span:not([class]) {
    background: none;
    box-shadow: none;
    color: #eb0001;
    text-align: center;
    font-weight: 600;
    text-shadow: 0 0 6px rgba(235, 0, 1, 0.245);
}

/* Device tables on Main (array, pools, boot, unassigned): each section is its own
   rounded glass card.  Unraid builds the pool list as one table with an empty divider
   row between pools (and, with the array stopped, an empty row between parity and
   data disks).  On one glass sheet those breaks could only be painted on top, so they
   looked like a hard stripe.  Here the glass moves from the table onto the cells: the
   divider rows stay clear so the page shows through, and the cells next to each break
   get rounded corners, so every group ends and starts like a card.
   Rounded cell corners need separate (not collapsed) borders, so the row lines Unraid
   draws as row borders are redrawn as a hairline inside each cell. */
html body table.unraid.disk_status:not(.unapi *) {
    border-collapse: separate;
    border-spacing: 0;
    background: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    clip-path: none;
}
html body table.unraid.disk_status > :is(thead, tbody) > tr > td {
    background-image: linear-gradient(var(--glass-tint), var(--glass-tint));
    -webkit-backdrop-filter: var(--glass-filter);
    backdrop-filter: var(--glass-filter);
    box-shadow: inset 0 -1px 0 var(--table-border-color);
}
/* Unraid also paints row backgrounds (zebra stripes, the totals/slots rows), and a row
   background is square, so it would fill the rounded corners.  Rows go clear and the
   stripe moves onto the cells. */
html body table.unraid.disk_status > :is(thead, tbody) > tr {
    background: none;
    border: 0;
}
html body table.unraid.disk_status > tbody > tr:nth-child(even) > td {
    background-image:
        linear-gradient(var(--table-background-color), var(--table-background-color)),
        linear-gradient(var(--glass-tint), var(--glass-tint));
}
/* Header row keeps its own tint on top of the glass */
html body table.unraid.disk_status > thead:first-child > tr > td {
    background-image:
        linear-gradient(var(--table-header-background-color), var(--table-header-background-color)),
        linear-gradient(var(--glass-tint), var(--glass-tint));
}
/* Row hover: Unraid sets a background colour, which would sit under the glass layer */
html body table.unraid.disk_status > tbody > tr:not(.tr_last):hover > td {
    background-image:
        linear-gradient(var(--hover-table-row-background-color), var(--hover-table-row-background-color)),
        linear-gradient(var(--glass-tint), var(--glass-tint));
}
/* The breaks: clear, no glass, no line */
html body table.unraid.disk_status > thead > tr > td.divider,
html body table.unraid.disk_status > tbody > tr.tr_last > td[colspan="10"]:only-child:empty {
    height: 1.6rem;
    line-height: 1.6rem;
    padding: 0;
    background: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    box-shadow: none;
}
/* Card tops: the column header row, and the first row after each break */
html body table.unraid.disk_status > thead:first-child > tr:first-child > td:first-child,
html body table.unraid.disk_status > thead:not(:first-child) + tbody > tr:first-child > td:first-child,
html body table.unraid.disk_status > tbody > tr.tr_last:has(> td[colspan="10"]:only-child:empty) + tr > td:first-child {
    border-top-left-radius: var(--glass-radius);
}
html body table.unraid.disk_status > thead:first-child > tr:first-child > td:last-child,
html body table.unraid.disk_status > thead:not(:first-child) + tbody > tr:first-child > td:last-child,
html body table.unraid.disk_status > tbody > tr.tr_last:has(> td[colspan="10"]:only-child:empty) + tr > td:last-child {
    border-top-right-radius: var(--glass-radius);
}
/* Card bottoms: the last row before each break, and the table's last row (no line under it) */
html body table.unraid.disk_status > tbody > tr:last-child > td:first-child,
html body table.unraid.disk_status > tbody > tr:has(+ tr.tr_last > td[colspan="10"]:only-child:empty) > td:first-child {
    border-bottom-left-radius: var(--glass-radius);
}
html body table.unraid.disk_status > tbody > tr:last-child > td:last-child,
html body table.unraid.disk_status > tbody > tr:has(+ tr.tr_last > td[colspan="10"]:only-child:empty) > td:last-child {
    border-bottom-right-radius: var(--glass-radius);
}
html body table.unraid.disk_status > tbody > tr:last-child > td,
html body table.unraid.disk_status > tbody > tr:has(+ tr.tr_last > td[colspan="10"]:only-child:empty) > td {
    box-shadow: none;
}

/* Array Operation: the buttons that change the array's state get the status colours,
   so they read differently from the everyday ones.  Start (array comes online) is sea
   green; Stop (array goes offline) is amber; Reboot and Shutdown (the whole server goes
   down) are rose.  Tinted glass at rest, the full colour on hover.  Disabled buttons
   (Start stays disabled until the configuration is valid) keep the normal disabled look. */
body input#cmdStart:not([disabled]),
body input[name="cmdStart"]:not([disabled]) {
    color: #1d8b4b;
    background: var(--pill-sheen), rgba(29, 139, 75, 0.2);
    box-shadow: inset 0 0 0 1px rgba(29, 139, 75, 0.45);
}
body input#cmdStart:not([disabled]):hover,
body input[name="cmdStart"]:not([disabled]):hover {
    color: #f1ece0;
    background: var(--pill-sheen), linear-gradient(180deg, #1d8b4b 0, #1d8b4b 55%, #1d8b4b 100%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.25), 0 0 14px rgba(29, 139, 75, 0.45);
}
body input#stop-button:not([disabled]),
body input[name="cmdStop"]:not([disabled]) {
    color: #b9770e;
    background: var(--pill-sheen), rgba(185, 119, 14, 0.2);
    box-shadow: inset 0 0 0 1px rgba(185, 119, 14, 0.45);
}
body input#stop-button:not([disabled]):hover,
body input[name="cmdStop"]:not([disabled]):hover {
    color: #f1ebdf;
    background: var(--pill-sheen), linear-gradient(180deg, #b9770e 0, #b9770e 55%, #b9770e 100%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.25), 0 0 14px rgba(185, 119, 14, 0.45);
}
body form[name="shutdownOps"] input:is([name="reboot"], [name="shutdown"]):not([disabled]) {
    color: #eb0001;
    background: var(--pill-sheen), rgba(235, 0, 1, 0.14);
    box-shadow: inset 0 0 0 1px rgba(235, 0, 1, 0.315);
}
body form[name="shutdownOps"] input:is([name="reboot"], [name="shutdown"]):not([disabled]):hover {
    color: #ffffff;
    background: var(--pill-sheen), linear-gradient(180deg, #eb0001 0, #eb0001 55%, #eb0001 100%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.25), 0 0 14px rgba(235, 0, 1, 0.315);
}

/* Confirm pop-ups: why Proceed looked darker than Cancel.  When a dialog opens, sweetalert
   "focuses" the confirm button by writing an inline background-color (Unraid passes
   transparent) and a flat box-shadow onto it.  That wiped the button's violet fill and its
   pill edge, leaving only the dark sheen.  !important is the only way past inline styles. */
body .sweet-alert button.confirm:not(.unapi *) {
    background-color: rgba(248, 243, 233, 0.605) !important;
    box-shadow: var(--pill-edge) !important;
}
body .sweet-alert button.confirm:not(.unapi *):hover {
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.3),
        0 0 0 1px rgba(51, 109, 125, 0.36),
        -8px 0 18px -6px rgba(48, 110, 126, 0.35),
        8px 0 18px -6px rgba(235, 0, 1, 0.35) !important;
}

/* Pop-up severity colours, matching the status colours used everywhere else.
   Sweetalert tags the icon that's showing with a class while the pop-up is open (and removes
   it on close): pulseWarning on the "!" icon, animateErrorIcon on the red X.  It also marks
   whether the pop-up has a Cancel button.  CSS can't read the pop-up's text, so those are
   the signals:
     - "!" with Cancel: about to do something risky (reboot, shutdown, abort)  -> rose
     - "!" with OK only: a heads-up, nothing to confirm                         -> amber
     - X: something already failed                                              -> rose
   Rose pop-ups get a rose rim, glow and icon, and a rose confirm button; Cancel stays the
   normal violet, the safe way out.  Log windows (.nchan) are left out: Unraid reuses the
   confirm box for the log that follows (e.g. Docker "Update" -> update log), and the hidden
   "!" icon keeps its pulseWarning class, which tinted the log window amber. */
body .sweet-alert:not(.nchan)[data-has-cancel-button="true"]:has(.sa-icon.sa-warning.pulseWarning),
body .sweet-alert:not(.nchan):has(.sa-icon.sa-error.animateErrorIcon) {
    box-shadow:
        var(--glass-shine),
        inset 0 0 0 1px rgba(235, 0, 1, 0.28),
        0 30px 80px -20px rgba(26, 58, 67, 0.383),
        0 0 70px -14px rgba(235, 0, 1, 0.385) !important;
}
body .sweet-alert:not(.nchan)[data-has-cancel-button="false"]:has(.sa-icon.sa-warning.pulseWarning) {
    box-shadow:
        var(--glass-shine),
        inset 0 0 0 1px rgba(185, 119, 14, 0.4),
        0 30px 80px -20px rgba(26, 58, 67, 0.383),
        0 0 70px -14px rgba(185, 119, 14, 0.5) !important;
}
/* The "!" icon: rose on a confirm, amber on an OK-only heads-up */
body .sweet-alert[data-has-cancel-button="true"] .sa-icon.sa-warning {
    border-color: #eb0001 !important;
    filter: drop-shadow(0 0 10px rgba(235, 0, 1, 0.385));
}
body .sweet-alert[data-has-cancel-button="true"] .sa-icon.sa-warning :is(.sa-body, .sa-dot) {
    background-color: #eb0001 !important;
}
body .sweet-alert[data-has-cancel-button="false"] .sa-icon.sa-warning {
    border-color: #b9770e !important;
    filter: drop-shadow(0 0 10px rgba(185, 119, 14, 0.5));
}
body .sweet-alert[data-has-cancel-button="false"] .sa-icon.sa-warning :is(.sa-body, .sa-dot) {
    background-color: #b9770e !important;
}
/* The X icon: rose */
body .sweet-alert .sa-icon.sa-error {
    border-color: #eb0001 !important;
    filter: drop-shadow(0 0 10px rgba(235, 0, 1, 0.385));
}
body .sweet-alert .sa-icon.sa-error .sa-line {
    background-color: #eb0001 !important;
}
/* Confirm button on a risky confirm: rose like the Reboot and Shutdown buttons */
body .sweet-alert:not(.nchan)[data-has-cancel-button="true"]:has(.sa-icon.sa-warning.pulseWarning) button.confirm:not(.unapi *) {
    color: #eb0001;
    background: var(--pill-sheen), rgba(235, 0, 1, 0.14);
    background-color: rgba(235, 0, 1, 0.14) !important;
    box-shadow: inset 0 0 0 1px rgba(235, 0, 1, 0.315) !important;
}
body .sweet-alert:not(.nchan)[data-has-cancel-button="true"]:has(.sa-icon.sa-warning.pulseWarning) button.confirm:not(.unapi *):hover {
    color: #ffffff;
    background: var(--pill-sheen), linear-gradient(180deg, #eb0001 0, #eb0001 55%, #eb0001 100%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.25), 0 0 14px rgba(235, 0, 1, 0.315) !important;
}

/* Plugin install/update window: the button lights up violet once the job ends.  While it
   runs, Unraid's title holds <span id="pluginProgressTitle">In Progress <i spinner></i></span>;
   when it ends, that span's text is replaced ("Finished" or "Error"), which removes the
   spinner <i>.  That's the only change CSS can see (the Close -> Done/Error label swap is
   text, which CSS can't read).  Success and failure look the same to CSS, so the colour is
   the neutral theme violet: "it's over, click me", not "it worked". */
body .sweet-alert.nchan:has(#pluginProgressTitle):not(:has(#pluginProgressTitle i)) button.confirm:not([disabled]):not(.unapi *) {
    color: #ffffff !important;
    background: var(--hover-button-background) !important;   /* Unraid's own rule for this button uses !important */
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.3),
        0 0 0 1px rgba(51, 109, 125, 0.36),
        0 0 16px -2px rgba(51, 109, 125, 0.42) !important;
}

/* Plugins page: Update is sea green and Remove (once its checkbox is ticked) is rose, matching
   the Array Operation buttons.  Unraid's plugin buttons carry the .plg filename in a data
   attribute, which keeps these rules to the plugin list.  Disabled buttons keep the normal
   disabled look, so Remove only turns rose when it can actually be clicked. */
body input[type="button"].update[data$=".plg"]:not([disabled]) {
    color: #1d8b4b;
    background: var(--pill-sheen), rgba(29, 139, 75, 0.2);
    box-shadow: inset 0 0 0 1px rgba(29, 139, 75, 0.45);
}
body input[type="button"].update[data$=".plg"]:not([disabled]):hover {
    color: #f1ece0;
    background: var(--pill-sheen), linear-gradient(180deg, #1d8b4b 0, #1d8b4b 55%, #1d8b4b 100%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.25), 0 0 14px rgba(29, 139, 75, 0.45);
}
body input[type="button"]:is(.remove, .delete)[data$=".plg"]:not([disabled]),
body #removeall input[type="button"] {
    color: #eb0001;
    background: var(--pill-sheen), rgba(235, 0, 1, 0.14);
    box-shadow: inset 0 0 0 1px rgba(235, 0, 1, 0.315);
}
body input[type="button"]:is(.remove, .delete)[data$=".plg"]:not([disabled]):hover,
body #removeall input[type="button"]:hover {
    color: #ffffff;
    background: var(--pill-sheen), linear-gradient(180deg, #eb0001 0, #eb0001 55%, #eb0001 100%);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.25), 0 0 14px rgba(235, 0, 1, 0.315);
}

/*
 * ---- Bar types ----
 * Every bar says what it measures, by colour:
 *   capacity  spectrum fill: the tip goes amber, then rose, as it fills.  Red means
 *             running out.  CPU, RAM, disks, the header array bar, Docker and VM CPU.
 *   neutral   grey: a reference value with no good or bad (a "before" number).
 *   gain      cyan to violet: performance, longer is better, never red.
 * Every track is a dim copy of its own fill colour: the fill mixed 20% into #150d2c,
 * the same rule the dashboard rings use for their unfilled part.
 *
 * Capacity is the default.  A plugin opts a bar into the other two by adding a class
 * to Unraid's own bar element (harmless in stock themes, which don't know it):
 *   <div class='usage-disk mm bongit-bar-neutral'>   or   bongit-bar-gain
 */
html:root {
    --bongit-track-base: #ece4d4;
    --bongit-meter-track: linear-gradient(90deg,
        color-mix(in srgb, #1d8b4b 20%, var(--bongit-track-base)) 0%,
        color-mix(in srgb, #1d8b4b 20%, var(--bongit-track-base)) 25%,
        color-mix(in srgb, #1d8b4b 20%, var(--bongit-track-base)) 45%,
        color-mix(in srgb, #b9770e 20%, var(--bongit-track-base)) 60%,
        color-mix(in srgb, #b9770e 20%, var(--bongit-track-base)) 72%,
        color-mix(in srgb, #b9770e 20%, var(--bongit-track-base)) 84%,
        color-mix(in srgb, #eb0001 20%, var(--bongit-track-base)) 92%,
        color-mix(in srgb, #eb0001 20%, var(--bongit-track-base)) 100%);
    --bongit-neutral-fill: #52676c;
    --bongit-neutral-track: color-mix(in srgb, var(--bongit-neutral-fill) 20%, var(--bongit-track-base));
    --bongit-gain-fill: linear-gradient(90deg, var(--bongit-cyan), var(--bongit-violet));
    --bongit-gain-track: linear-gradient(90deg,
        color-mix(in srgb, var(--bongit-cyan) 20%, var(--bongit-track-base)),
        color-mix(in srgb, var(--bongit-violet) 20%, var(--bongit-track-base)));
}

/* Capacity tracks: the dim spectrum.  "none" bars are deliberately invisible, and the
   header bar of a stopped array is styled elsewhere, so both are left alone. */
body .usage-disk:not(.none),
body table.disk_status .usage-disk:not(.sys):not(.mm),
body .usage-bar {
    background: var(--bongit-meter-track);
}

/* Thin bars (Docker and VM CPU per container / VM) were plain violet; they measure
   usage, so they get the spectrum fill like every other capacity bar. */
body .usage-disk.mm > span:first-child {
    background: var(--bongit-meter-sheen), var(--bongit-meter);
    background-size: 100% 100%, 100cqw 100%;
    background-repeat: no-repeat;
}

/* Neutral and gain: opt-in, on any Unraid bar */
body .usage-disk.bongit-bar-neutral {
    background: var(--bongit-neutral-track);
}
body .usage-disk.bongit-bar-neutral > span:first-child {
    background: var(--bongit-meter-sheen), var(--bongit-neutral-fill);
    box-shadow: none;
}
body .usage-disk.bongit-bar-gain {
    background: var(--bongit-gain-track);
}
body .usage-disk.bongit-bar-gain > span:first-child {
    background: var(--bongit-meter-sheen), var(--bongit-gain-fill);
    background-size: 100% 100%, 100cqw 100%;   /* fade spans the full track, so a short bar is mostly cyan */
    background-repeat: no-repeat;
    box-shadow: none;
}

/*
 * ---- Effects settings (Settings -> bongIT Theme -> Effects) ----
 * Three effects, each with levels, so slower computers can trade looks for speed:
 *   Motion         everywhere | titles | hover (default) | still   (the holographic shimmer)
 *   Frosted glass  all (default) | panels | menus | off
 *   Glows          all (default) | static | off
 * The blocks below sit behind media conditions that never match on their own, like
 * "(bongit-motion-everywhere)".  apply.sh turns the chosen ones on by rewriting that
 * condition to "all" in the copy it installs.  Two levels reuse the accessibility
 * fallbacks instead: motion "still" switches on every "(prefers-reduced-motion: reduce)"
 * block, and glass "off" every "(prefers-reduced-transparency: reduce)" block.  Those keep
 * working on their own too: a visitor whose computer asks for less motion or transparency
 * gets it, whatever the server is set to.  Still CSS only: nothing here runs a script.
 */

/* Motion: everywhere.  Every title's holographic moves, not just the one under the pointer. */
@media (bongit-motion-everywhere) {
    html body .tile-header-main,
    html body .tile-header-left i[class^="icon-"],
    html body .tile-header-left i[class*=" icon-"],
    html body div.title .left,
    html body div.title .left i {
        animation-play-state: running;
    }
}

/* Motion: page titles.  The section title bars on each page (a few per page) shimmer all the
   time; Dashboard tile titles still only move while you point at their tile. */
@media (bongit-motion-titles) {
    html body div.title .left,
    html body div.title .left i {
        animation-play-state: running;
    }
}

/* Frosted glass: menus and popups only.  Glass stays where it is rare or short-lived (the menu
   bar, dropdowns, dialogs, tooltips, notifications); the big panels that fill the page (tiles,
   tables, title bars) become solid, which is where nearly all the blur cost was measured. */
@media (bongit-theme-menus) {
    body div.title,
    body table:not(.unapi *):not(.dashboard),
    body table.dashboard > tbody,
    html body:has(> .boot-title) {
        --glass-filter: none;
        --glass-tint: var(--bongit-raised);
        --glass-tint-strong: var(--bongit-surface);
        -webkit-backdrop-filter: none;
        backdrop-filter: none;
    }
    body table.dashboard .control,
    body .tile-ctrl > .fa.hand,
    body a.move_to_end::before,
    html body table.unraid.disk_status > :is(thead, tbody) > tr > td {
        -webkit-backdrop-filter: none;
        backdrop-filter: none;
    }
}

/* Frosted glass: panels only.  Small things (tile buttons, the drag handle) get a plain
   see-through fill instead of their own blur.  At that size the difference is hard to see,
   and each one was a separate blur to redraw.  Tiles, title bars, menus, popups and
   dialogs keep real glass. */
@media (bongit-theme-panels) {
    body table.dashboard .control,
    body .tile-ctrl > .fa.hand,
    body a.move_to_end::before {
        -webkit-backdrop-filter: none;
        backdrop-filter: none;
    }
}

/* Frosted glass: off.  No blur anywhere; panels become solid violet-tinted fills (the
   tint swap is in the reduced-transparency block further up).  Things that relied on blur
   alone to hide what's behind them get a solid colour instead. */
@media (prefers-reduced-transparency: reduce) {
    html body *,
    html body *::before,
    html body *::after {
        -webkit-backdrop-filter: none !important;
        backdrop-filter: none !important;
    }
    html body #menu::before { background: rgba(251, 248, 243, 1); }
    html body #footer { background: rgba(251, 249, 244, 1); }
    html:root [data-sonner-toast] { background: rgba(250, 247, 241, 1); }
}

/* Glows: static only.  No glow on things Unraid redraws every few seconds (usage bars,
   dashboard rings, live status text), since each glow is a small blur that is redrawn with
   them.  Glows on things that sit still stay. */
@media (bongit-glow-static), (bongit-glow-off) {
    body .greenbar,
    body .orangebar,
    body .redbar {
        box-shadow: none;
    }
    body div.pie > span:first-child::before {
        filter: none;
    }
    body :is(table.dashboard, table.disk_status) :is(.green-text, .passed, .green, .orange-text, .warning, .red-text, .failed) {
        text-shadow: none;
    }
}

/* Glows: off.  Also the glows on static status text and icons.  Hover glows on buttons
   stay: they only appear while pointing, and they show what is clickable. */
@media (bongit-glow-off) {
    body :is(.green-text, .passed, .green, .orange-text, .warning, .red-text, .failed) {
        text-shadow: none;
    }
    body .favCardBackground,
    body .sweet-alert[data-has-cancel-button] .sa-icon.sa-warning,   /* as specific as the glow rules they undo */
    body .sweet-alert .sa-icon.sa-error {
        filter: none;
    }
    body img.spotlightIcon {
        filter: hue-rotate(255deg) saturate(1.15);   /* keeps the colour shift, drops the glow */
    }
}

/* ===== bongIT hell: Petrol auf Papier, Akzent Rot =====
 * Steht am Ende und legt die Hausfarben exakt fest; build.py rechnet die übrigen
 * Farben der Vorlage nur näherungsweise um.  Werte aus Marke.cs. */
html:root {
    color-scheme: light;
    --bongit-cyan: #2e7f92;
    --bongit-violet: #224954;        /* Petrol */
    --bongit-pink: #e00001;          /* Rot, eine Spur dunkler für hellen Grund */
    --bongit-gradient: linear-gradient(90deg, var(--bongit-cyan) 0, var(--bongit-violet) 50%, var(--bongit-pink) 100%);

    --bongit-bg: #f2ebdd;            /* Papier */
    --bongit-surface: #faf8f3;
    --bongit-raised: #ffffff;        /* Feld */
    --bongit-line: #e4dccb;          /* Kopf */
    --bongit-line-strong: #9db0b4;   /* Rand */
    --bongit-text: #1a3a43;          /* Petrol dunkel */
    --bongit-text-dim: #5b7178;
    --bongit-text-faint: #8a9a9e;

    --link-text-color: #2e5e6b;
    --link-visited-color: #5b7178;
    --hover-button-text-color: #f2ebdd;
    --hover-button-background: linear-gradient(180deg, #2e5e6b 0, #224954 55%, #1a3a43 100%);
}

body {
    background-color: var(--bongit-bg);
}
body::before {
    background-image:
        linear-gradient(rgba(34, 73, 84, 0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(34, 73, 84, 0.04) 1px, transparent 1px),
        radial-gradient(60vw 50vh at 12% 8%, rgba(46, 94, 107, 0.16), transparent 70%),
        radial-gradient(45vw 40vh at 90% 18%, rgba(255, 0, 1, 0.06), transparent 70%),
        radial-gradient(45vw 40vh at 85% 85%, rgba(255, 255, 255, 0.70), transparent 70%),
        radial-gradient(70vw 60vh at 40% 100%, rgba(34, 73, 84, 0.12), transparent 70%);
}

/* Titel-Schimmer: Papier mit Petrol-Lichtern und einem roten Funken
   (die Vorlage hat drei Pinktöne, umgerechnet wären die Titel halb rot). */
html body .tile-header-main,
html body .tile-header-left i[class^="icon-"],
html body .tile-header-left i[class*=" icon-"],
html body div.title .left,
html body div.title .left i,
html body .sidenav :is(.rightTitle, .popupAuthorTitle),
html body .sweet-alert.nchan :is(h1, h2, h3),
html body #sb-title-inner {
    --bongit-holo-base: #224954; --bongit-holo-c1: var(--bongit-holo-base); --bongit-holo-c2: var(--bongit-holo-base); --bongit-holo-c3: var(--bongit-holo-base); --bongit-holo-c4: var(--bongit-holo-base); --bongit-holo-c5: var(--bongit-holo-base); --bongit-holo-c6: var(--bongit-holo-base);
}

/* Kopfzeile (src/kopf.css): Grund, Schrift, Logo und Platinen-Muster dieser Fassung */
html:root {
    --bongit-kopf-grund: #ebe3d1;
    --bongit-kopf-text: #1a3a43;
    --bongit-kopf-text-leise: #5b7178;
    --bongit-logo-papier: url("data:image/png;base64,");
    --bongit-logo-petrol: url("data:image/png;base64,");
    --bongit-kopf-logo: var(--bongit-logo-petrol);
    --bongit-banner-bild: var(--bongit-banner-hell);
    --bongit-banner-hoehe: var(--bongit-banner-hell-hoehe, 91px);
    --bongit-banner-grund: var(--bongit-banner-hell-rand, var(--bongit-kopf-grund));
    --bongit-protokoll-grund: rgba(255, 255, 255, 0.72);    /* Protokollfeld in Aufgaben-Fenstern */
    --bongit-kopf-muster: url("data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%22640%22 height=%22100%22 viewBox=%220 0 640 100%22%3E%3Cpolyline points=%22350,30 430,30 470,30 480,20 530,20%22 fill=%22none%22 stroke=%22%232e7f92%22 stroke-opacity=%220.24%22 stroke-width=%221.4%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/%3E%3Ccircle cx=%22350%22 cy=%2230%22 r=%222.6%22 fill=%22none%22 stroke=%22%232e7f92%22 stroke-opacity=%220.38%22 stroke-width=%221.2%22/%3E%3Ccircle cx=%22530%22 cy=%2220%22 r=%221.8%22 fill=%22%232e7f92%22 fill-opacity=%220.38%22/%3E%3Cpolyline points=%22270,60 310,60 320,50 420,50 430,60 470,60 480,70%22 fill=%22none%22 stroke=%22%23224954%22 stroke-opacity=%220.12%22 stroke-width=%221.4%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/%3E%3Ccircle cx=%22270%22 cy=%2260%22 r=%222.6%22 fill=%22none%22 stroke=%22%23224954%22 stroke-opacity=%220.19%22 stroke-width=%221.2%22/%3E%3Ccircle cx=%22480%22 cy=%2270%22 r=%221.8%22 fill=%22%23224954%22 fill-opacity=%220.19%22/%3E%3Cpolyline points=%22350,70 410,70 420,80 470,80 490,60%22 fill=%22none%22 stroke=%22%23224954%22 stroke-opacity=%220.12%22 stroke-width=%221.4%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/%3E%3Ccircle cx=%22350%22 cy=%2270%22 r=%221.8%22 fill=%22%23224954%22 fill-opacity=%220.19%22/%3E%3Ccircle cx=%22490%22 cy=%2260%22 r=%222.6%22 fill=%22none%22 stroke=%22%23224954%22 stroke-opacity=%220.19%22 stroke-width=%221.2%22/%3E%3Cpolyline points=%22390,80 460,80 470,90 530,90 630,90%22 fill=%22none%22 stroke=%22%23224954%22 stroke-opacity=%220.12%22 stroke-width=%221.4%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/%3E%3Ccircle cx=%22390%22 cy=%2280%22 r=%222.6%22 fill=%22none%22 stroke=%22%23224954%22 stroke-opacity=%220.19%22 stroke-width=%221.2%22/%3E%3Ccircle cx=%22630%22 cy=%2290%22 r=%221.8%22 fill=%22%23224954%22 fill-opacity=%220.19%22/%3E%3Cpolyline points=%22390,60 430,60 450,80 530,80 570,80 590,60 650,60 670,80%22 fill=%22none%22 stroke=%22%23224954%22 stroke-opacity=%220.12%22 stroke-width=%221.4%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/%3E%3Ccircle cx=%22390%22 cy=%2260%22 r=%222.6%22 fill=%22none%22 stroke=%22%23224954%22 stroke-opacity=%220.19%22 stroke-width=%221.2%22/%3E%3Ccircle cx=%22670%22 cy=%2280%22 r=%221.8%22 fill=%22%23224954%22 fill-opacity=%220.19%22/%3E%3Cpolyline points=%22210,60 310,60 360,60 370,70%22 fill=%22none%22 stroke=%22%23224954%22 stroke-opacity=%220.12%22 stroke-width=%221.4%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/%3E%3Ccircle cx=%22210%22 cy=%2260%22 r=%221.8%22 fill=%22%23224954%22 fill-opacity=%220.19%22/%3E%3Ccircle cx=%22370%22 cy=%2270%22 r=%221.8%22 fill=%22%23224954%22 fill-opacity=%220.19%22/%3E%3Cpolyline points=%22360,90 420,90 460,90 540,90 560,70%22 fill=%22none%22 stroke=%22%23224954%22 stroke-opacity=%220.12%22 stroke-width=%221.4%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/%3E%3Ccircle cx=%22360%22 cy=%2290%22 r=%222.6%22 fill=%22none%22 stroke=%22%23224954%22 stroke-opacity=%220.19%22 stroke-width=%221.2%22/%3E%3Ccircle cx=%22560%22 cy=%2270%22 r=%221.8%22 fill=%22%23224954%22 fill-opacity=%220.19%22/%3E%3Cpolyline points=%22430,10 490,10 510,30 550,30 570,50%22 fill=%22none%22 stroke=%22%232e7f92%22 stroke-opacity=%220.24%22 stroke-width=%221.4%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/%3E%3Ccircle cx=%22430%22 cy=%2210%22 r=%221.8%22 fill=%22%232e7f92%22 fill-opacity=%220.38%22/%3E%3Ccircle cx=%22570%22 cy=%2250%22 r=%221.8%22 fill=%22%232e7f92%22 fill-opacity=%220.38%22/%3E%3Cpolyline points=%22450,50 520,50 540,30 640,30 650,20%22 fill=%22none%22 stroke=%22%23224954%22 stroke-opacity=%220.12%22 stroke-width=%221.4%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/%3E%3Ccircle cx=%22450%22 cy=%2250%22 r=%222.6%22 fill=%22none%22 stroke=%22%23224954%22 stroke-opacity=%220.19%22 stroke-width=%221.2%22/%3E%3Ccircle cx=%22650%22 cy=%2220%22 r=%221.8%2