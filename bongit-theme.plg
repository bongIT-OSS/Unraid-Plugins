<div class="title nocontrol"><span class="left"><i class="title fa fa-info-circle"></i> Status</span></div>
<div class="ag">
  <div class="ag-stats">
    <div class="ag-stat"><span class="ag-k">Theme</span>
      <form method="POST" action="/update.php" target="progressFrame">
