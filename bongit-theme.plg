<FILE Name="&emhttp;/BongitThemeHeader.page">
<INLINE><![CDATA[
Menu="Buttons:298"
Link="nav-user"
---
<?php
/* Ginkgo (by bongIT): Kopfzeile.
 *
 * - Das Logo links führt auf die Startseite der Weboberfläche (Einstellungen → Verwaltung →
 *   Startseite) statt in einem neuen Tab auf unraid.net.
 * - bongIT-Icon im Browser-Tab.
 * - Kopfzeile mit eigenem Banner (Einstellung auf der Seite Ginkgo): Bild, Randfarbe und
 *   Höhe je Fassung als CSS-Variablen; das Stylesheet zeichnet daraus den Kopf.
 * - Docker/VMs: Liste abblenden, solange Unraid sie neu aufbaut.
 *
 * Seiten mit Menu="Buttons" bindet Unraid in jede Seite ein; mit Link gesetzt erscheint kein
 * eigener Knopf.  Nur aktiv, solange das Theme aktiv ist (include/zustand.php).
 */
require_once '/usr/local/emhttp/plugins/bongit-theme/include/zustand.php';
$bongit = bongit_zustand($display);
if ($bongit['aktiv']):
  // Eigene Banner: bongit-banner-hell.png / -dunkel.png; fehlt eins, gilt das andere für beide.
  // Ohne eigene Banner das Banner aus den Anzeige-Einstellungen von Unraid.
  $bongit_banner = [];
  if ($bongit['einst']['kopf'] === 'banner') {
    foreach (['hell', 'dunkel'] as $m) {
      $f = "/boot/config/plugins/dynamix/bongit-banner-$m.png";
      if (is_file($f)) $bongit_banner[$m] = $f;
    }
    if (!$bongit_banner && is_file('/boot/config/plugins/dynamix/banner.png')) {
      $bongit_banner = ['hell' => '/boot/config/plugins/dynamix/banner.png'];
    }
    if (count($bongit_banner) === 1) {
      $f = reset($bongit_banner);
      $bongit_banner = ['hell' => $f, 'dunkel' => $f];
    }
  }
  if ($bongit_banner):
?>
<style>
html.bongit:root {
<?php foreach ($bongit_banner as $m => $f):
    // Randfarbe (füllt links und rechts, wenn das Fenster breiter ist als das Bild) und Höhe
    // (so hoch, wie das Bild bei 1920 px Breite ist, z. B. 3840 × 280 → 140 px)
    $rand = ''; $hoehe = 0;
    if (function_exists('imagecreatefrompng') && ($bild = @imagecreatefrompng($f))) {
      $c = imagecolorsforindex($bild, imagecolorat($bild, 1, intdiv(imagesy($bild), 2)));
      $rand = sprintf('#%02x%02x%02x', $c['red'], $c['green'], $c['blue']);
      $hoehe = (int)round(imagesy($bild) * 1920 / max(1, imagesx($bild)));
      imagedestroy($bild);
    }
?>
  --bongit-banner-<?=$m?>: url("<?=htmlspecialchars($f.'?v='.filemtime($f))?>");
<?php if ($rand): ?>  --bongit-banner-<?=$m?>-rand: <?=$rand?>;
<?php endif; if ($hoehe >= 60 && $hoehe <= 240): ?>  --bongit-banner-<?=$m?>-hoehe: <?=$hoehe?>px;
<?php endif; endforeach; ?>
}
</style>
<script>document.documentElement.classList.add('bongit-banner');</script>
<?php endif; ?>
<script>
(function () {
  var ICON = '<?=bongit_url('/plugins/bongit-theme/images/favicon.png')?>';
  var TOUCH = '<?=bongit_url('/plugins/bongit-theme/images/apple-touch-icon.png')?>';
  // Logo der Kopf-Komponente und ihres Platzhalters beim Laden
  var LOGOS = '#header a.uh-logo, #header .uh-logo-block a, .unraid-header-boot-logo a';

  function zuUnraid(a) {
    try {
      var u = new URL(a.href);
      return /^(www\.)?unraid\.net$/.test(u.hostname) && u.pathname === '/' && !u.search && !u.hash;
    } catch (e) {
      return false;
    }
  }
  function umbiegen() {
    var i, l;
    l = document.querySelectorAll('link[rel~="icon"]');
    for (i = 0; i < l.length; i++) if (l[i].href.indexOf(ICON) < 0) { l[i].type = 'image/png'; l[i].href = ICON; }
    l = document.querySelectorAll('link[rel="apple-touch-icon"]');
    for (i = 0; i < l.length; i++) if (l[i].href.indexOf(TOUCH) < 0) l[i].href = TOUCH;
    l = document.querySelectorAll(LOGOS);
    for (i = 0; i < l.length; i++) {
      var a = l[i];
      if (!zuUnraid(a)) continue;
      a.href = '/';
      a.removeAttribute('target');
      a.removeAttribute('rel');
      a.title = 'Startseite';
      a.setAttribute('aria-label', 'Startseite');
    }
  }
  umbiegen();
  // Unraid tauscht den Platzhalter gegen die Komponente: höchstens einmal pro Bild nachziehen.
  var geplant = false;
  new MutationObserver(function () {
    if (geplant) return;
    geplant = true;
    requestAnimationFrame(function () { geplant = false; umbiegen(); });
  }).observe(document.documentElement, { childList: true, subtree: true, attributes: true, attributeFilter: ['href'] });

  // Übersicht: Unraid färbt Ringe, Prozentzahlen und Diagramme per Skript mit festen Farben
  // nach der Server-Einstellung (DashStats.page: colors, fontColor, cpuchart/netchart).  Hier
  // nach dem Hausstil und der Fassung im Browser – CSS-Variablen bleiben beim Umschalten gültig.
  document.addEventListener('DOMContentLoaded', function () {
    if (!Array.isArray(window.colors) || typeof window.fontColor !== 'function') return;
    // Farben der RAM-Aufteilung (Legende und innerer Ring): System, Frei, dann VM, Docker …
    window.colors[0] = 'var(--bongit-ram-system)';
    window.colors[1] = 'var(--bongit-ram-frei)';
    window.colors[2] = 'var(--bongit-orange)';
    window.colors[4] = 'var(--bongit-rot-text)';
    window.fontColor = function (l, t1, t2) {
      if (t1 > 0 && l >= t1) return 'var(--bongit-rot-text)';
      if (t2 > 0 && l >= t2) return 'var(--bongit-orange)';
      return 'var(--bongit-gruen)';
    };

    // Ringe der Kachel System: Unraid schreibt die Belegung als conic-gradient ins style-
    // Attribut.  Daraus werden CSS-Variablen für den eigenen Ring (50-dashboard.css):
    // --bongit-anteil (Prozent belegt), --bongit-bogen (Statusfarbe wie die Prozentzahl) und
    // beim RAM die Aufteilung als dünne innere Ringe (innenringe).
    function segmente(bg) {
      var a = bg.indexOf('conic-gradient(');
      if (a < 0) return null;
      var s = bg.slice(a + 15), tiefe = 0, teil = '', teile = [];
      for (var i = 0; i < s.length; i++) {
        var z = s[i];
        if (z === '(') tiefe++;
        if (z === ')') { if (tiefe === 0) break; tiefe--; }
        if (z === ',' && tiefe === 0) { teile.push(teil.trim()); teil = ''; } else teil += z;
      }
      teile.push(teil.trim());
      var stopps = [];
      teile.forEach(function (t) {
        var m = t.match(/^(.*?)\s+([\d.]+)%(?:\s+([\d.]+)%)?$/);
        if (!m) return;
        stopps.push([m[1], +m[2]]);
        if (m[3] !== undefined) stopps.push([m[1], +m[3]]);
      });
      var seg = [];
      for (var k = 0; k + 1 < stopps.length; k++) {
        if (stopps[k][0] === stopps[k + 1][0] && stopps[k + 1][1] > stopps[k][1]) {
          seg.push({ farbe: stopps[k][0], von: stopps[k][1], bis: stopps[k + 1][1] });
        }
      }
      return seg;
    }
    // RAM: je Anteil ein dünner Ring im Loch (höchstens drei, von außen nach innen), jeder
    // beginnt oben und zeigt seinen Anteil am verwendbaren Speicher.
    var SVG = 'http://www.w3.org/2000/svg';
    function kreis(svg, r, klasse) {
      var c = document.createElementNS(SVG, 'circle');
      c.setAttribute('cx', 46); c.setAttribute('cy', 46); c.setAttribute('r', r);
      if (klasse) c.setAttribute('class', klasse);
      svg.appendChild(c);
      return c;
    }
    function innenringe(pie, teile) {
      var svg = pie.querySelector('svg.bongit-innen');
      if (!svg) {
        svg = document.createElementNS(SVG, 'svg');
        svg.setAttribute('class', 'bongit-innen');
        svg.setAttribute('viewBox', '0 0 92 92');
        svg.setAttribute('aria-hidden', 'true');
        pie.insertBefore(svg, pie.firstChild);
      }
      while (svg.firstChild) svg.removeChild(svg.firstChild);
      teile.slice(0, 3).forEach(function (g, i) {
        var r = 29.5 - 5 * i, umfang = 2 * Math.PI * r, laenge = (g.bis - g.von) / 100 * umfang;
        kreis(svg, r, 'spur');
        if (laenge < 0.5) return;
        var c = kreis(svg, r);
        c.style.stroke = g.farbe;
        c.setAttribute('stroke-linecap', 'round');
        c.setAttribute('stroke-dasharray', laenge + ' ' + umfang);
        c.setAttribute('transform', 'rotate(-90 46 46)');
      });
    }
    function ring(pie) {
      var bg = pie.getAttribute('style') || '';
      if (pie.dataset.bongitRing === bg) return;
      var seg = segmente(bg);
      if (!seg || !seg.length) return;
      var frei = seg[seg.length - 1];
      var belegt = frei.farbe.indexOf('ram-frei') >= 0 || frei.farbe === window.colors[1] ? frei.von : 100;
      pie.style.setProperty('--bongit-anteil', belegt);
      var zahl = pie.querySelector('span[class^="sys"]');
      var farbe = zahl && zahl.style.color;
      pie.style.setProperty('--bongit-bogen', farbe && farbe.indexOf('var(') === 0 ? farbe : 'var(--bongit-gruen)');
      pie.classList.toggle('bongit-leer', belegt < 0.5);
      if (pie.id === 'sys0') innenringe(pie, belegt < 100 ? seg.slice(0, -1) : seg);
      pie.dataset.bongitRing = pie.getAttribute('style') || '';
    }
    var pies = document.querySelectorAll('.tile-system-memory-charts div.pie');
    for (var p = 0; p < pies.length; p++) {
      ring(pies[p]);
      new MutationObserver(function (liste) { ring(liste[0].target); })
        .observe(pies[p], { attributes: true, attributeFilter: ['style'] });
    }
    // Diagramme zeichnen auf <canvas> und brauchen echte Farbwerte
    function diagramme() {
      var cs = getComputedStyle(document.documentElement);
      var text = cs.getPropertyValue('--bongit-text-leise').trim();
      var gitter = cs.getPropertyValue('--bongit-linie').trim();
      ['cpuchart', 'netchart'].forEach(function (n) {
        var c = window[n];
        if (c && c.options && c.options.grid && c.options.labels) {
          c.options.grid.strokeStyle = gitter;
          c.options.labels.fillStyle = text;
        }
      });
    }
    diagramme();
    new MutationObserver(diagramme).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  });

  // Docker/VMs: Nach einem Update ("Dismiss") baut Unraid die Liste per loadlist() neu auf;
  // bei vielen Containern rechnet der Browser danach spürbar, ohne dass Unraids Ladeanzeige
  // erscheint.  Die Liste wird sofort abgeblendet, bis die neue eingesetzt ist.
  document.addEventListener('DOMContentLoaded', function () {
    var liste = document.querySelector('#docker_list, #kvm_list');
    if (!liste || typeof window.loadlist !== 'function') return;
    var original = window.loadlist;
    window.loadlist = function () {
      liste.classList.add('bongit-laedt');
      return original.apply(this, arguments);
    };
    new MutationObserver(function () { liste.classList.remove('bongit-laedt'); })
      .observe(liste, { childList: true });
  });
})();
</script>
<?php endif; ?>
]]></INLINE>
<SHA256>17346a6ee62d56af87b01715d44be472d805f33e63dfe6645b798f216e2f3439</SHA256>
</FILE>
<FILE Name="&emhttp;/BongitThemeModus.page">
<INLINE><![CDATA[
Menu="Buttons:2"
Title="Darstellung"
Icon="fa-adjust"
---
<?php
/* Ginkgo (by bongIT): bindet das Stylesheet ein und wählt hell, dunkel oder automatisch – pro Browser.
 *
 * Seiten mit Menu="Buttons" wertet Unraid 7.4 im <head> aus, hinter dem Theme-Stylesheet
 * (DefaultPageLayout.php).  Hier entstehen deshalb vor dem ersten Zeichnen:
 *   1. <link> auf styles/bongit-theme.css (blockiert das Zeichnen, bis es geladen ist),
 *   2. ein kleines Skript, das am <html> die Klasse bongit-hell oder bongit-dunkel setzt.
 * Das Stylesheet enthält beide Fassungen, getrennt nach dieser Klasse; Unraids eigenes
 * Theme-Stylesheet (Schwarz/Weiß) bleibt unangetastet.
 *
 * Wahl im Browser: localStorage "bongit-modus" = hell | dunkel | auto.  Ohne eigene Wahl gilt
 * die Server-Einstellung (Schwarz = dunkel, Weiß = hell); "auto" folgt der Systemeinstellung
 * des Geräts, auch wenn sie sich ändert.  Der Knopf in der Symbolleiste schaltet reihum.
 */
require_once '/usr/local/emhttp/plugins/bongit-theme/include/zustand.php';
$bongit = bongit_zustand($display);
if ($bongit['aktiv']):
?>
<link type="text/css" rel="stylesheet" href="<?=bongit_url('/plugins/bongit-theme/styles/bongit-theme.css')?>">
<script>
(function () {
  var SERVER = '<?=$bongit['server']?>';
  var SCHLUESSEL = 'bongit-modus';
  var html = document.documentElement;
  var system = window.matchMedia('(prefers-color-scheme: dark)');
  var NAMEN = { hell: 'Hell', dunkel: 'Dunkel', auto: 'Automatisch' };
  var SYMBOL = { hell: 'fa-sun-o', dunkel: 'fa-moon-o', auto: 'fa-adjust' };

  function wahl() {
    var w = null;
    try { w = localStorage.getItem(SCHLUESSEL); } catch (e) {}
    return w === 'hell' || w === 'dunkel' || w === 'auto' ? w : SERVER;
  }
  function naechste(w) {
    return { hell: 'dunkel', dunkel: 'auto', auto: 'hell' }[w];
  }
  function fassung() {
    var w = wahl();
    return w === 'auto' ? (system.matches ? 'dunkel' : 'hell') : w;
  }
  // Unraids Vue-Komponenten (Kopf, Benachrichtigungen, Menüs, Toasts; Klasse .unapi) tragen
  // "dark" nach der Server-Einstellung; hier nach der Wahl des Browsers.
  function komponenten(dunkel) {
    // body trägt "dark" ebenfalls nach der Server-Einstellung (Black); Tailwind-Regeln
    // (dark:…) darunter würden sonst auch in Hell dunkel zeichnen
    if (document.body && document.body.classList.contains('dark') !== dunkel) document.body.classList.toggle('dark', dunkel);
    var teile = document.querySelectorAll('.unapi');
    for (var i = 0; i < teile.length; i++) {
      if (teile[i].classList.contains('dark') !== dunkel) teile[i].classList.toggle('dark', dunkel);
    }
  }
  function anwenden() {
    var f = fassung();
    html.classList.add('bongit');
    html.classList.toggle('bongit-hell', f === 'hell');
    html.classList.toggle('bongit-dunkel', f === 'dunkel');
    // Unraid hat ein paar Regeln für .Theme--black / .Theme--white
    html.classList.toggle('Theme--white', f === 'hell');
    html.classList.toggle('Theme--black', f === 'dunkel');
    komponenten(f === 'dunkel');
  }
  // Knopf: Symbol der aktuellen Wahl, Hinweis auf die nächste
  function knopf() {
    var a = document.querySelector('.nav-item.BongitThemeModus a');
    if (!a) return;
    var w = wahl(), n = naechste(w);
    a.title = 'Darstellung: ' + NAMEN[w] + ' – klicken für ' + NAMEN[n];
    var span = a.querySelector('span');
    if (span) span.textContent = NAMEN[w];
    var b = a.querySelector('b');
    if (b) {
      b.classList.remove('fa-sun-o', 'fa-moon-o', 'fa-adjust');
      b.classList.add(SYMBOL[w]);
    }
  }

  window.BongitThemeModus = function () {
    var n = naechste(wahl());
    try {
      // Entspricht die Wahl der Server-Einstellung, nichts speichern: dann folgt der Browser
      // wieder dem Server, falls der umgestellt wird.
      if (n === SERVER) localStorage.removeItem(SCHLUESSEL);
      else localStorage.setItem(SCHLUESSEL, n);
    } catch (e) {}
    anwenden();
    knopf();
  };

  anwenden();
  if (system.addEventListener) system.addEventListener('change', function () {
    if (wahl() === 'auto') anwenden();
  });
  // Wahl in einem anderen Tab desselben Browsers
  window.addEventListener('storage', function (e) {
    if (e.key === SCHLUESSEL) { anwenden(); knopf(); }
  });
  // Komponenten, die Unraid später einblendet (Benachrichtigungen erst beim Öffnen):
  // höchstens einmal pro Bild nachziehen.
  var geplant = false;
  new MutationObserver(function () {
    if (geplant) return;
    geplant = true;
    requestAnimationFrame(function () { geplant = false; komponenten(fassung() === 'dunkel'); });
  }).observe(html, { childList: true, subtree: true, attributes: true, attributeFilter: ['class'] });
  // body gibt es erst jetzt; direkt umstellen (requestAnimationFrame ruht in Hintergrund-Tabs)
  document.addEventListener('DOMContentLoaded', function () { komponenten(fassung() === 'dunkel'); knopf(); });
})();
</script>
<?php else: ?>
<style>.nav-item.BongitThemeModus { display: none; }</style>
<?php endif; ?>
]]></INLINE>
<SHA256>88e632200482345f100dae6b7fc8d909b24dc4ec41dc1d53dfd7a2251156d8ec</SHA256>
</FILE>
<FILE Name="&emhttp;/include/banner.php">
<INLINE><![CDATA[
<?php
/* Ginkgo (by bongIT): eigenes Kopfbanner speichern oder löschen (Seite Ginkgo).
 *
 * POST  modus = hell | dunkel,  aktion = speichern | loeschen,  bild = PNG als base64
 * Unraid prüft vorher das csrf_token (local_prepend.php).  Antwort: JSON.
 */
header('Content-Type: application/json; charset=utf-8');

function antwort(int $code, array $daten): void {
  http_response_code($code);
  echo json_encode($daten);
  exit;
}

$modus = $_POST['modus'] ?? '';
$aktion = $_POST['aktion'] ?? '';
if (!in_array($modus, ['hell', 'dunkel'], true)) antwort(400, ['fehler' => 'Unbekannte Fassung.']);
$ziel = "/boot/config/plugins/dynamix/bongit-banner-$modus.png";

if ($aktion === 'loeschen') {
  @unlink($ziel);
  antwort(200, ['ok' => true, 'stand' => '']);
}
if ($aktion !== 'speichern') antwort(400, ['fehler' => 'Unbekannte Aktion.']);

$bild = base64_decode(preg_replace('/^data:image\/png;base64,/', '', $_POST['bild'] ?? ''), true);
if ($bild === false || strlen($bild) < 100) antwort(400, ['fehler' => 'Keine Bilddaten empfangen.']);
if (strlen($bild) > 5 * 1024 * 1024) antwort(400, ['fehler' => 'Das Bild ist größer als 5 MB.']);
if (substr($bild, 0, 8) !== "\x89PNG\r\n\x1a\n") antwort(400, ['fehler' => 'Nur PNG-Dateien sind möglich.']);
$masse = @getimagesizefromstring($bild);
if (!$masse || $masse[0] < 400 || $masse[1] < 40) antwort(400, ['fehler' => 'Das Bild ist zu klein (mindestens 400 × 40 Pixel).']);

if (@file_put_contents("$ziel.neu", $bild) !== strlen($bild) || !@rename("$ziel.neu", $ziel)) {
  @unlink("$ziel.neu");
  antwort(500, ['fehler' => 'Das Bild konnte nicht auf dem Stick gespeichert werden.']);
}
antwort(200, ['ok' => true, 'stand' => date('d.m.Y H:i', filemtime($ziel)), 'masse' => "{$masse[0]} × {$masse[1]}"]);
]]></INLINE>
<SHA256>88d9d6c6b3b7951ee8d791aecd32c3eeca78d5b13cc875e2c09fb02ba3dc84c6</SHA256>
</FILE>
<FILE Name="&emhttp;/include/zustand.php">
<INLINE><![CDATA[
<?php
/* Ginkgo (by bongIT): Ist das Theme auf dieser Seite aktiv?
 *
 * Gemeinsam für die Kopf-Seiten (BongitThemeModus.page, BongitThemeHeader.page) und die
 * Einstellungsseite.  Aktiv ist es, wenn
 *   - kein Notschalter auf dem Stick liegt (/boot/config/plugins/bongit-theme/DISABLED),
 *   - es auf der Einstellungsseite eingeschaltet ist (bongit-theme.cfg: aktiv="ja"),
 *   - Unraid mit Farbschema Schwarz oder Weiß läuft (Menü oben; Azur/Grau haben eine
 *     Seitenleiste und einen anderen Seitenaufbau),
 *   - die Adresse nicht ?bongit=aus enthält (ein Aufruf ohne Theme, z. B. zum Vergleichen).
 */
const BONGIT_CFG = '/boot/config/plugins/bongit-theme';

function bongit_einstellungen(): array {
  static $einst = null;
  if ($einst === null) {
    $einst = @parse_ini_file(BONGIT_CFG.'/bongit-theme.cfg') ?: [];
    $einst += ['aktiv' => 'ja', 'kopf' => 'muster'];
    // ältere Werte der Kopfzeile: banner-hell / banner-dunkel waren dasselbe wie banner
    if (in_array($einst['kopf'], ['banner-hell', 'banner-dunkel'])) $einst['kopf'] = 'banner';
  }
  return $einst;
}

function bongit_zustand(array $display): array {
  $einst = bongit_einstellungen();
  $theme = $display['theme'] ?? '';
  $grund = '';
  if (file_exists(BONGIT_CFG.'/DISABLED')) {
    $grund = 'Notschalter: Die Datei DISABLED liegt in /boot/config/plugins/bongit-theme/.';
  } elseif ($einst['aktiv'] !== 'ja') {
    $grund = 'Auf dieser Seite ausgeschaltet.';
  } elseif (!in_array($theme, ['black', 'white'])) {
    $grund = 'Das Farbschema unter Einstellungen → Anzeige ist nicht Schwarz oder Weiß.';
  } elseif (($_GET['bongit'] ?? '') === 'aus') {
    $grund = 'Für diesen Aufruf ausgeschaltet (?bongit=aus in der Adresse).';
  }
  return [
    'aktiv'  => $grund === '',
    'grund'  => $grund,
    'server' => $theme === 'white' ? 'hell' : 'dunkel',
    'einst'  => $einst,
  ];
}

// Adresse mit Änderungsstand (?v=), damit der Browser nach einem Update nichts Altes nimmt
function bongit_url(string $pfad): string {
  return $pfad.'?v='.@filemtime('/usr/local/emhttp'.$pfad);
}
]]></INLINE>
<SHA256>79456a97dbb482339183cbcb1393bea790f5bcf294178db052716b34acb7688d</SHA256>
</FILE>
<FILE Name="&emhttp;/scripts/einbinden.sh" Mode="0755">
<INLINE><![CDATA[
#!/bin/bash
# Ginkgo (by bongIT): Login-Seite und Protokollfenster einbinden oder lösen.
#
#   einbinden.sh          nach Einstellung (an, wenn eingeschaltet, kein Notschalter und
#                         Farbschema Schwarz/Weiß; sonst aus)
#   einbinden.sh an|aus
#
# Die Seiten der Weboberfläche brauchen das nicht: Dort bindet BongitThemeModus.page das
# Stylesheet ein.  Die Login-Seite lädt aber nur default-cases.css und das Protokollfenster
# (logging.htm) gar kein Stylesheet – dort steht je ein Block zwischen BONGIT-THEME-START und
# BONGIT-THEME-END.  Beim Lösen werden alle solchen Blöcke entfernt, auch die der Fassungen
# bis 2026.11.25.1201 in themes/black.css und themes/white.css.
#
# Die Dateien liegen im RAM; Unraid spielt beim Booten das Plugin neu ein, dabei läuft dieses
# Skript wieder.  Nach einem Unraid-Update passt es sich so von selbst an.

CFG=/boot/config/plugins/bongit-theme
PLG=/usr/local/emhttp/plugins/bongit-theme
STY=/usr/local/emhttp/plugins/dynamix/styles
LOGIN=$STY/default-cases.css
PROTOKOLL=/usr/local/emhttp/logging.htm

melden() { logger -t bongit-theme -- "$1"; echo "$1"; }

loesen() {
  local f
  for f in "$STY/themes/black.css" "$STY/themes/white.css" "$LOGIN" "$PROTOKOLL"; do
    [ -f "$f" ] && grep -q 'BONGIT-THEME-START' "$f" || continue
    sed -i '/BONGIT-THEME-START/,/BONGIT-THEME-END/d' "$f"
  done
}

server_modus() {
  local t
  t=$(sed -n 's/^theme="\(.*\)"/\1/p' /boot/config/plugins/dynamix/dynamix.cfg 2>/dev/null)
  [ "$t" = white ] && echo hell || echo dunkel
}

binden() {
  # Login: Stylesheet anhängen (gilt nur für Elemente der Login-Seite, siehe login.css)
  { echo '/* BONGIT-THEME-START */'
    cat "$PLG/styles/login.css"
    echo '/* BONGIT-THEME-END */'; } >> "$LOGIN"

  # Protokollfenster: Stylesheet und Fassung (wie das Fenster, aus dem es geöffnet wurde)
  local v block
  v=$(stat -c %Y "$PLG/styles/protokoll.css")
  block=$(mktemp)
  cat > "$block" <<EOF
<!-- BONGIT-THEME-START -->
<link type="text/css" rel="stylesheet" href="/plugins/bongit-theme/styles/protokoll.css?v=$v">
<script>
(function () {
  var f = '$(server_modus)', q = null;
  try { q = (window.parent !== window ? parent : window.opener).document.documentElement; } catch (e) {}
  if (q && q.classList.contains('bongit-hell')) f = 'hell';
  else if (q && q.classList.contains('bongit-dunkel')) f = 'dunkel';
  else {
    try {
      var w = localStorage.getItem('bongit-modus');
      if (w === 'auto') w = matchMedia('(prefers-color-scheme: dark)').matches ? 'dunkel' : 'hell';
      if (w === 'hell' || w === 'dunkel') f = w;
    } catch (e) {}
  }
  document.documentElement.className += ' bongit bongit-' + f;
})();
</script>
<!-- BONGIT-THEME-END -->
EOF
  if grep -q '</head>' "$PROTOKOLL"; then
    # Block vor </head> einsetzen; cat > statt mv, damit Rechte und Besitzer bleiben
    awk -v blk="$block" '
      /<\/head>/ && !done { while ((getline z < blk) > 0) print z; done = 1 }
      { print }' "$PROTOKOLL" > "$PROTOKOLL.bongit" && cat "$PROTOKOLL.bongit" > "$PROTOKOLL"
    rm -f "$PROTOKOLL.bongit"
  fi
  rm -f "$block"
}

ziel="$1"
if [ -z "$ziel" ]; then
  ziel=an
  [ -f "$CFG/DISABLED" ] && ziel=aus
  grep -qs '^aktiv="nein"' "$CFG/bongit-theme.cfg" && ziel=aus
  t=$(sed -n 's/^theme="\(.*\)"/\1/p' /boot/config/plugins/dynamix/dynamix.cfg 2>/dev/null)
  case "$t" in black|white|'') ;; *) ziel=aus ;; esac
fi

loesen
if [ "$ziel" = an ]; then
  binden
  melden "Login-Seite und Protokollfenster eingebunden"
else
  melden "Login-Seite und Protokollfenster im Originalzustand"
fi
exit 0
]]></INLINE>
<SHA256>37bb13ef7029f230076b0e30ab4ccaead8049ec60e006d3616f7f863e595ffc4</SHA256>
</FILE>
<FILE Name="&emhttp;/README.md">
<INLINE><![CDATA[
**Ginkgo** · by bongIT

Unraid im bongIT-Hausstil: Petrol und Papier, hell, dunkel oder automatisch – je Browser.

Einstellungen unter „Ginkgo“.  Hell/Dunkel/Automatisch: Knopf oben rechts in der Symbolleiste.  Herausgeber Markus Bong, MIT-Lizenz.
]]></INLINE>
